---
import type { GetStaticPathsOptions, Page } from 'astro';
import { type CollectionEntry, getCollection } from 'astro:content';
import { t } from '../../i18n';
import Pagination from '../../components/widgets/Pagination.astro';
import PostPreview from '../../components/content/PostPreview.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import SectionNav from '../../components/ui/SectionNav.astro';
import siteConfig from '../../data/site-config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(sortItemsByDateDesc);
    return paginate(posts, { pageSize: siteConfig.postsPerPage || 4 });
}

type Props = { page: Page<CollectionEntry<'blog'>> };

const { page } = Astro.props;
const blog = page.data;
---

<BaseLayout title={t.page.blog.title} description={t.page.blog.description} showHeader={false}>
    <SectionNav
        items={[
            { label: t.nav.recent, href: '/blog/', active: true },
            { label: t.nav.categories, href: '/categories/' },
            { label: t.nav.tags, href: '/tags/' },
            { label: t.nav.series, href: '/series/' },
            { label: t.nav.archives, href: '/archives/' }
        ]}
    />
    {blog.map((post) => {
        const hasBanner = !!post.data.banner;
        return (
            <div class={`reveal rounded-[24px] bg-[var(--bg-card)] p-4 mb-4 sm:mb-4 shadow-[0_1px_4px_-2px_rgba(0,0,0,0.2)] card-interactive hover:-translate-y-1 ${hasBanner ? 'hover:shadow-[0_12px_24px_-4px_rgba(0,0,0,0.28),0_6px_12px_-2px_rgba(0,0,0,0.14)]' : 'hover:shadow-[0_6px_12px_-4px_rgba(0,0,0,0.10),0_4px_8px_-2px_rgba(0,0,0,0.06)]'}`}>
                <PostPreview post={post} class="" />
            </div>
        );
    })}
    <Pagination page={page} class="my-16 sm:my-24" />
</BaseLayout>
