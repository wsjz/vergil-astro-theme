---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';
import { ChevronLeft, ChevronRight, Link, Check, ExternalLink } from '@lucide/astro';
import { Icon } from 'astro-icon/components';
import FormattedDate from '../../components/ui/FormattedDate.astro';
import ReadingTime from '../../components/ui/ReadingTime.astro';
import Comments from '../../components/widgets/Comments.astro';
import FloatingToc from '../../components/widgets/FloatingToc.astro';
import SidebarToc from '../../components/widgets/SidebarToc.astro';
import RelatedPosts from '../../components/widgets/RelatedPosts.astro';
import FeaturedPosts from '../../components/widgets/FeaturedPosts.astro';
import SeriesNav from '../../components/widgets/SeriesNav.astro';
import siteConfig from '../../data/site-config';
import { sortItemsByDateDesc } from '../../utils/data-utils';
import { slugify } from '../../utils/common-utils';
import QRCode from 'qrcode-svg';

export async function getStaticPaths() {
    const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(sortItemsByDateDesc);
    const postCount = posts.length;

    // 预计算每个专栏的文章列表（按发布时间正序）
    const seriesMap = new Map<string, CollectionEntry<'blog'>[]>();
    posts.forEach((post) => {
        if (post.data.series) {
            const sid = slugify(post.data.series);
            if (!seriesMap.has(sid)) {
                seriesMap.set(sid, []);
            }
            seriesMap.get(sid)!.push(post);
        }
    });
    seriesMap.forEach((list) => {
        list.sort((a, b) => new Date(a.data.publishDate).getTime() - new Date(b.data.publishDate).getTime());
    });

    return posts.map((post, index) => {
        // 全站 prev/next
        const prevPost = index + 1 !== postCount ? posts[index + 1] : null;
        const nextPost = index !== 0 ? posts[index - 1] : null;

        // 专栏内 prev/next
        let seriesPrev: CollectionEntry<'blog'> | null = null;
        let seriesNext: CollectionEntry<'blog'> | null = null;
        let seriesRecommend: CollectionEntry<'blog'> | null = null;
        if (post.data.series) {
            const sid = slugify(post.data.series);
            const seriesPosts = seriesMap.get(sid) || [];
            const sIndex = seriesPosts.findIndex((p) => p.id === post.id);
            seriesPrev = sIndex > 0 ? seriesPosts[sIndex - 1] : null;
            seriesNext = sIndex < seriesPosts.length - 1 ? seriesPosts[sIndex + 1] : null;

            // 当前专栏没有下一篇时，推荐其他专栏的最新文章
            if (!seriesNext) {
                const otherSeriesPosts = posts
                    .filter((p) => p.data.series && slugify(p.data.series) !== sid && p.id !== post.id)
                    .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
                seriesRecommend = otherSeriesPosts[0] || null;
            }
        }

        return {
            params: { id: post.id },
            props: { post, prevPost, nextPost, seriesPrev, seriesNext, seriesRecommend }
        };
    });
}

type Props = {
    post: CollectionEntry<'blog'>;
    prevPost: CollectionEntry<'blog'> | null;
    nextPost: CollectionEntry<'blog'> | null;
    seriesPrev: CollectionEntry<'blog'> | null;
    seriesNext: CollectionEntry<'blog'> | null;
    seriesRecommend: CollectionEntry<'blog'> | null;
};

const { href } = Astro.url;
const { post, prevPost, nextPost, seriesPrev, seriesNext, seriesRecommend } = Astro.props;
const { title, publishDate, updatedDate, excerpt, tags = [], seo, series, categories, fonts, banner } = post.data;

const navPrev = series ? seriesPrev : prevPost;
const navNext = series ? seriesNext : nextPost;
const recommendNext = series ? seriesRecommend : null;
const hasNav = !!(navPrev || navNext || recommendNext);

function resolveBannerUrl(banner: string | undefined): string | null {
    if (!banner) return null;
    if (banner.startsWith('http')) {
        return banner;
    }
    return `https://images.unsplash.com/photo-1557682250-33bd709cbe85?w=1600&h=400&fit=crop&q=80`;
}

const bannerUrl = resolveBannerUrl(banner);
const { Content, headings } = await render(post);

// 生成微信分享二维码
const pageUrl = new URL(`/blog/${post.id}/`, siteConfig.website).toString();
const qrCode = new QRCode({ content: pageUrl, width: 160, height: 160 });
const qrCodeSvg = qrCode.svg();

const leafCategory = categories && categories.length > 0 ? categories[categories.length - 1] : null;
const postBreadcrumbs = [
    { text: '博客', href: '/blog/' },
    ...(leafCategory ? [{ text: leafCategory, href: `/categories/${slugify(leafCategory)}/` }] : []),
    { text: title }
];
---

<BaseLayout
    title={seo?.title ?? title}
    description={seo?.description ?? excerpt}
    image={seo?.image}
    pageType="article"
    showHeader={false}
    showRightSidebar={true}
    articleTitle={title}
    commentsEnabled={siteConfig.comments?.enabled}
    fonts={fonts}
>
    <FloatingToc headings={headings} />

    {bannerUrl && (
        <div class="article-banner group relative mb-8 overflow-hidden rounded-xl h-[180px] sm:h-[220px]">
            <img
                src={bannerUrl}
                alt={title}
                class="absolute inset-0 w-full h-full object-cover"
                loading="eager"
            />
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-200"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
            <div class="absolute inset-0 flex flex-col justify-between p-6 sm:p-8">
                <div class="flex flex-wrap items-center gap-2 text-sm text-white/80 drop-shadow [&_a]:text-white/80 [&_a:hover]:text-white [&_span]:text-white/60">
                    <Breadcrumb crumbs={postBreadcrumbs} />
                </div>
                <div>
                    <h1 class="font-display text-2xl leading-tight font-medium text-white sm:text-3xl sm:leading-tight drop-shadow-lg">{title}</h1>
                    <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-white/70">
                        <FormattedDate date={publishDate} />
                        <ReadingTime content={post.body || ''} />
                        {updatedDate && (
                            <span>Updated on <FormattedDate date={updatedDate} /></span>
                        )}
                    </div>
                </div>
            </div>
        </div>
    )}

    <article class="mb-5 sm:mb-10">
        <header class="mb-5">
            {bannerUrl ? null : (
                <>
                    <Breadcrumb crumbs={postBreadcrumbs} />
                    <h1 class="mt-4 font-display text-2xl leading-tight font-medium sm:text-3xl sm:leading-tight">{title}</h1>
                    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-secondary">
                        <FormattedDate date={publishDate} />
                        <ReadingTime content={post.body || ''} />
                        {updatedDate && (
                            <span>
                                Updated on <FormattedDate date={updatedDate} />
                            </span>
                        )}
                    </div>
                </>
            )}
        </header>
        {series && <SeriesNav currentPostId={post.id} series={series} />}
        <div class="prose sm:prose-lg max-w-none">
            <Content />
        </div>
        {siteConfig.copyright && (
            <p class="mt-18 text-[12px] text-muted text-center">{siteConfig.copyright}</p>
        )}
        <div class="mt-8 flex flex-wrap items-center justify-between gap-6 text-sm sm:mt-12 sm:text-base">
            {tags.length > 0 && (
                <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
                    {tags.map((tag) => (
                        <a class="text-accent hover:underline" href={`/tags/${slugify(tag)}`}>
                            #{tag}
                        </a>
                    ))}
                </div>
            )}
            {siteConfig.share?.enabled && (
                <div class="flex items-center gap-4 -translate-x-1">
                    <div class="relative">
                        <button
                            class="share-menu-trigger w-4 h-4 text-muted hover:text-accent transition-colors cursor-pointer"
                            aria-label="分享"
                            title="分享"
                        >
                            <ExternalLink class="w-4 h-4" />
                        </button>
                        <div class="share-menu hidden absolute right-1 top-6 bg-card rounded-lg shadow-md p-2 z-10 min-w-[80px]">
                            <button class="share-wechat relative w-full flex items-center gap-2 px-2 py-1 text-sm text-secondary hover:text-[#07C160] hover:bg-muted/50 rounded transition-colors group">
                                <Icon name="simple-icons:wechat" class="w-4 h-4" />
                                <span>微信</span>
                                <div class="wechat-qrcode-tooltip hidden group-hover:flex absolute right-full top-1/2 -translate-y-1/2 mr-2 bg-card rounded-lg shadow-md p-2 z-20 flex-col items-center gap-1 w-[180px]">
                                    <div class="wechat-qrcode-image w-[160px] h-[160px]" set:html={qrCodeSvg} />
                                    <span class="text-[10px] text-muted">扫码分享</span>
                                </div>
                            </button>
                            <button class="share-weibo w-full flex items-center gap-2 px-2 py-1 text-sm text-secondary hover:text-[#E6162D] hover:bg-muted/50 rounded transition-colors">
                                <Icon name="simple-icons:sinaweibo" class="w-4 h-4" />
                                <span>微博</span>
                            </button>
                        </div>
                    </div>
                    <button
                        class="copy-url-button relative w-6 h-6 text-muted hover:text-accent transition-colors cursor-pointer"
                        aria-label="Copy link"
                        data-url={href}
                    >
                        <Link class="copy-url-icon absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-4" />
                        <Check class="copy-url-check absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-4 text-accent hidden" />
                        <span class="copy-url-tooltip absolute -top-7 left-1/2 -translate-x-1/2 text-[11px] text-accent bg-card px-2 py-0.5 rounded shadow-sm opacity-0 transition-opacity duration-200 whitespace-nowrap pointer-events-none"
                            data-show="false">已复制</span>
                    </button>
                </div>
            )}
        </div>
    </article>
    {hasNav && (
        <nav class="mt-10 sm:mt-12 border-t border-light pt-6" data-post-id={post.id}>
            {series && (
                <div class="text-center mb-3">
                    <span class="text-[11px] text-muted tracking-wider uppercase">专栏</span>
                    <a href={`/series/${slugify(series)}/`} class="ml-1.5 text-sm font-medium text-accent hover:underline">
                        {series}
                    </a>
                </div>
            )}
            <div class="flex items-start justify-between gap-6">
                {navPrev ? (
                    <a href={`/blog/${navPrev.id}/`} class="group flex items-center gap-3 min-w-0">
                        <ChevronLeft class="w-5 h-5 text-muted group-hover:text-accent transition-colors shrink-0" />
                        <div class="flex flex-col min-w-0">
                            <span class="text-[11px] text-muted tracking-wider">上一篇</span>
                            <span class="text-sm font-medium text-secondary group-hover:text-accent transition-colors truncate">{navPrev.data.title}</span>
                        </div>
                    </a>
                ) : <div class="w-5 shrink-0" />}
                {navNext ? (
                    <a href={`/blog/${navNext.id}/`} class="group flex items-center gap-3 min-w-0">
                        <div class="flex flex-col items-end min-w-0">
                            <span class="text-[11px] text-muted tracking-wider">下一篇</span>
                            <span class="text-sm font-medium text-secondary group-hover:text-accent transition-colors truncate">{navNext.data.title}</span>
                        </div>
                        <ChevronRight class="w-5 h-5 text-muted group-hover:text-accent transition-colors shrink-0" />
                    </a>
                ) : recommendNext ? (
                    <a href={`/blog/${recommendNext.id}/`} class="group flex items-center gap-3 min-w-0">
                        <div class="flex flex-col items-end min-w-0">
                            <span class="text-[11px] text-muted tracking-wider">推荐</span>
                            <span class="text-sm font-medium text-secondary group-hover:text-accent transition-colors truncate">{recommendNext.data.title}</span>
                            {recommendNext.data.series && (
                                <span class="text-[11px] text-muted mt-0.5">来自专栏「{recommendNext.data.series}」</span>
                            )}
                        </div>
                        <ChevronRight class="w-5 h-5 text-muted group-hover:text-accent transition-colors shrink-0" />
                    </a>
                ) : <div class="w-5 shrink-0" />}
            </div>
        </nav>
    )}
    <div slot="right-sidebar">
        <SidebarToc headings={headings} />
        <RelatedPosts currentPostId={post.id} tags={tags} />
        <FeaturedPosts />
    </div>

    {siteConfig.comments?.enabled && <Comments pageId={`/blog/${post.id}/`} pageTitle={title} />}

    <!-- 微信分享二维码弹窗 -->
    <div class="wechat-qrcode-modal hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm" data-url={pageUrl}>
        <div class="wechat-qrcode-card bg-card rounded-xl shadow-xl p-5 w-[200px] mx-4 text-center relative">
            <button class="wechat-qrcode-close absolute top-2 right-2 text-muted hover:text-main transition-colors" aria-label="关闭">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
            <div class="wechat-qrcode-image w-[160px] h-[160px] mx-auto" set:html={qrCodeSvg} />
        </div>
    </div>
</BaseLayout>

<script>
    document.addEventListener('astro:page-load', () => {
        // 复制链接
        const copyUrlButton = document.querySelector('.copy-url-button') as HTMLButtonElement;
        copyUrlButton?.addEventListener('click', async () => {
            await copyUrl(copyUrlButton);
        });

        async function copyUrl(button: HTMLButtonElement) {
            let url = button.getAttribute('data-url') || '';
            await navigator.clipboard.writeText(url);

            const icon = button.querySelector('.copy-url-icon');
            const check = button.querySelector('.copy-url-check');
            const tooltip = button.querySelector('.copy-url-tooltip');

            icon?.classList.add('hidden');
            check?.classList.remove('hidden');
            if (tooltip) {
                tooltip.setAttribute('data-show', 'true');
                tooltip.classList.remove('opacity-0');
            }

            setTimeout(() => {
                icon?.classList.remove('hidden');
                check?.classList.add('hidden');
                if (tooltip) {
                    tooltip.setAttribute('data-show', 'false');
                    tooltip.classList.add('opacity-0');
                }
            }, 2500);
        }

        // 分享菜单
        const shareTrigger = document.querySelector('.share-menu-trigger') as HTMLButtonElement;
        const shareMenu = document.querySelector('.share-menu') as HTMLDivElement;

        shareTrigger?.addEventListener('click', (e) => {
            e.stopPropagation();
            shareMenu?.classList.toggle('hidden');
        });

        document.addEventListener('click', () => {
            shareMenu?.classList.add('hidden');
        });

        shareMenu?.addEventListener('click', (e) => {
            e.stopPropagation();
        });

        // 微信分享 - 显示二维码弹窗
        const wechatModal = document.querySelector('.wechat-qrcode-modal') as HTMLDivElement;
        const wechatClose = document.querySelector('.wechat-qrcode-close') as HTMLButtonElement;

        document.querySelector('.share-wechat')?.addEventListener('click', () => {
            shareMenu?.classList.add('hidden');
            wechatModal?.classList.remove('hidden');
        });

        wechatModal?.addEventListener('click', (e) => {
            if (e.target === wechatModal) {
                wechatModal.classList.add('hidden');
            }
        });

        wechatClose?.addEventListener('click', () => {
            wechatModal?.classList.add('hidden');
        });

        // 微博分享 - 跳转分享页
        document.querySelector('.share-weibo')?.addEventListener('click', () => {
            const url = encodeURIComponent(window.location.href);
            const title = encodeURIComponent(document.title);
            window.open(`https://service.weibo.com/share/share.php?url=${url}&title=${title}`, '_blank');
        });
    });
</script>
