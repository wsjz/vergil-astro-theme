---
import { t } from '../../../i18n';
import MinimalLayout from '../../../views/minimal/layouts/MinimalLayout.astro';
import MinimalClientView from '../../../views/minimal/components/MinimalClientView.astro';
import siteConfig from '../../../data/site-config';

export async function getStaticPaths() {
    if (siteConfig.views?.minimal?.enabled !== true) return [];
    return [{}];
}
---

<MinimalLayout title={t.page.minimal.title} description={t.page.minimal.description} pageType="website">
    <MinimalClientView />
</MinimalLayout>