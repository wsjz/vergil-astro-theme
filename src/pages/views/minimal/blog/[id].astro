---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import MinimalLayout from '../../../../views/minimal/layouts/MinimalLayout.astro';
import Breadcrumb from '../../../../components/ui/Breadcrumb.astro';
import { sortItemsByDateDesc } from '../../../../utils/data-utils';
import { slugify } from '../../../../utils/common-utils';

export async function getStaticPaths() {
    const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
    return posts.map((post) => ({
        params: { id: post.id },
        props: { post }
    }));
}

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props;
const { title, publishDate, updatedDate, excerpt, tags = [], seo, category } = post.data;
const { Content } = await render(post);

const categorySlug = category ? slugify(category) : null;

const crumbs = [
    { text: '博客', href: '/views/minimal/?type=blog' },
    ...(categorySlug ? [{ text: category!, href: `/views/minimal/?type=blog&cat=${categorySlug}` }] : []),
    { text: title }
];
---

<MinimalLayout
    title={seo?.title ?? title}
    description={seo?.description ?? excerpt}
    pageType="article"
    showBackLink="返回列表"
    backHref="/views/minimal/"
    showBreadcrumb={true}
>
    <Breadcrumb crumbs={crumbs} slot="breadcrumb" />

    <article class="mb-12">
        <header class="mb-8">
            <h1 class="font-display text-2xl leading-tight font-medium sm:text-3xl sm:leading-tight">{title}</h1>
            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-secondary">
                <time datetime={publishDate.toISOString()}>
                    {publishDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                {updatedDate && (
                    <span>
                        更新于 <time datetime={updatedDate.toISOString()}>{updatedDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
                    </span>
                )}
            </div>
        </header>
        <div class="prose sm:prose-lg max-w-none">
            <Content />
        </div>
    </article>
</MinimalLayout>
