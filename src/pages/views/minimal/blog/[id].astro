---
import { locale, t } from '../../../../i18n';
import DirectiveStyles from '../../../../components/base/DirectiveStyles.astro';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import MinimalLayout from '../../../../views/minimal/layouts/MinimalLayout.astro';
import Breadcrumb from '../../../../components/ui/Breadcrumb.astro';
import { sortItemsByDateDesc } from '../../../../utils/data-utils';
import { slugify } from '../../../../utils/common-utils';
import siteConfig from '../../../../data/site-config';

export async function getStaticPaths() {
    if (siteConfig.views?.minimal?.enabled !== true) return [];
    const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(sortItemsByDateDesc);
    return posts.map((post) => ({
        params: { id: post.id },
        props: { post }
    }));
}

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props;
const { title, publishDate, updatedDate, excerpt, tags = [], seo, categories } = post.data;
const { Content } = await render(post);

const leafCategory = categories && categories.length > 0 ? categories[categories.length - 1] : null;
const categorySlug = leafCategory ? slugify(leafCategory) : null;

const crumbs = [
    { text: t.page.minimal.blog, href: '/views/minimal/?type=blog' },
    ...(categorySlug ? [{ text: leafCategory!, href: `/views/minimal/?type=blog&cat=${categorySlug}` }] : []),
    { text: title }
];
---

<MinimalLayout
    title={seo?.title ?? title}
    description={seo?.description ?? excerpt}
    pageType="article"
    showBackLink={t.page.minimal.backToList}
    backHref="/views/minimal/"
    showBreadcrumb={true}
>
    <Breadcrumb crumbs={crumbs} slot="breadcrumb" />

    <article class="mb-12">
        <header class="mb-8">
            <h1 class="font-display text-2xl leading-tight font-medium sm:text-3xl sm:leading-tight">{title}</h1>
            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-secondary">
                <time datetime={publishDate.toISOString()}>
                    {publishDate.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                {updatedDate && (
                    <span>
                        {t.page.minimal.updatedAt} <time datetime={updatedDate.toISOString()}>{updatedDate.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' })}</time>
                    </span>
                )}
            </div>
        </header>
        <div class="prose sm:prose-lg max-w-none">
            <DirectiveStyles content={post.body || ''} />
            <Content />
        </div>
    </article>
</MinimalLayout>
