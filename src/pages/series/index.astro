---
import { getCollection } from 'astro:content';
import { BookOpen } from '@lucide/astro';
import { t } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionNav from '../../components/ui/SectionNav.astro';
import { getPostsBySeries, sortItemsByDateDesc } from '../../utils/data-utils';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(sortItemsByDateDesc);
const allSeries = await getCollection('series');

const seriesWithMeta = allSeries
    .map((s) => {
        const seriesPosts = getPostsBySeries(posts, s.id);
        // getPostsBySeries 现在是正序，取最新要算最大值，不能再取第一个
        const latestDate = seriesPosts.length > 0
            ? Math.max(...seriesPosts.map((p) => new Date(p.data.publishDate).getTime()))
            : 0;
        return {
            ...s,
            postCount: seriesPosts.length,
            latestDate,
        };
    })
    // 专栏详情页只为「有文章的专栏」生成，所以这里也必须过滤掉空专栏，
    // 否则列表上会出现一个点进去 404 的入口。
    .filter((s) => s.postCount > 0)
    .sort((a, b) => b.latestDate - a.latestDate);
---

<BaseLayout title={t.page.series.title} description={t.page.series.description} showHeader={false}>
    <SectionNav
        items={[
            { label: t.nav.recent, href: '/blog/' },
            { label: t.nav.categories, href: '/categories/' },
            { label: t.nav.tags, href: '/tags/' },
            { label: t.nav.series, href: '/series/', active: true },
            { label: t.nav.archives, href: '/archives/' }
        ]}
    />

    {allSeries.length === 0 ? (
        <p class="text-secondary">{t.page.series.emptyLead} <code>src/content/series/</code> {t.page.series.emptyTail}</p>
    ) : (
        <div class="grid grid-cols-1 gap-4">
            {seriesWithMeta.map((s) => (
                <a
                    href={`/series/${s.id}`}
                    class="reveal group flex flex-col sm:flex-row gap-5 p-5 sm:p-6 rounded-2xl shadow-sm hover:shadow-xl card-interactive hover:-translate-y-1 transition-all duration-300"
                    style="background-color: color-mix(in srgb, var(--bg-card) 80%, transparent); backdrop-filter: blur(8px);"
                >
                    <div class="shrink-0 w-16 h-16 sm:w-20 sm:h-20 rounded-xl overflow-hidden flex items-center justify-center relative">
                        {s.data.cover ? (
                            <img
                                src={s.data.cover}
                                alt={s.data.name}
                                class="w-full h-full object-cover transition-all duration-300 group-hover:scale-[1.03]"
                            />
                        ) : (
                            <div class="w-full h-full flex items-center justify-center text-accent">
                                <BookOpen class="w-8 h-8" />
                            </div>
                        )}
                    </div>
                    <div class="min-w-0 flex-1 flex flex-col justify-center">
                        <h2 class="font-display text-lg sm:text-xl font-medium text-main group-hover:text-accent transition-colors">
                            {s.data.name}
                        </h2>
                        {s.data.description && (
                            <p class="text-sm text-secondary mt-1.5 line-clamp-2">
                                {s.data.description}
                            </p>
                        )}
                    </div>
                </a>
            ))}
        </div>
    )}
</BaseLayout>
