---
import DefaultLayout from '../../layouts/DefaultLayout.astro';
---

<DefaultLayout title="在线工具箱" description="JSON 解析、文本 Diff、图片转 WebP 等实用工具" showSidebar={false} showRightSidebar={false}>
    <div class="max-w-3xl mx-auto py-8 px-4">
        <h1 class="text-2xl font-bold text-main mb-1.5">在线工具箱</h1>
        <p class="text-sm text-secondary mb-8">纯前端运行，数据不会上传到服务器。</p>

        <!-- Tabs -->
        <div class="flex gap-1.5 mb-8 border-b border-light pb-3">
            <button class="tab-btn active px-3 py-1.5 rounded-md text-sm font-medium transition-all" data-tab="image">图片转 WebP</button>
            <button class="tab-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all text-secondary hover:text-main hover:bg-hover" data-tab="json">JSON 解析</button>
            <button class="tab-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all text-secondary hover:text-main hover:bg-hover" data-tab="diff">文本 Diff</button>
            <button class="tab-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all text-secondary hover:text-main hover:bg-hover" data-tab="sql">SQL 美化</button>
            <button class="tab-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all text-secondary hover:text-main hover:bg-hover" data-tab="password">密码生成</button>
        </div>

        <!-- Image Tool -->
        <div id="tab-image" class="tab-content">
            <h2 class="text-xl font-bold text-main mb-1.5">图片转 WebP</h2>
            <p class="text-sm text-secondary mb-5">支持批量处理，纯前端转换，图片不会上传到服务器。</p>

            <div
                id="drop-zone"
                class="border-2 border-dashed border-light rounded-xl p-8 text-center cursor-pointer transition-all hover:border-accent hover:bg-accent/5"
            >
                <svg class="w-10 h-10 mx-auto text-muted mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l-3 3m3-3l3 3M6.75 19.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25z"/>
                </svg>
                <p class="text-main font-medium mb-1">点击或拖拽图片到此处</p>
                <p class="text-sm text-muted">支持 PNG、JPG、JPEG、WebP</p>
                <input id="file-input" type="file" accept="image/png,image/jpeg,image/jpg,image/webp" multiple class="hidden" />
            </div>

            <div class="mt-6 flex items-center gap-4">
                <span class="text-sm text-secondary shrink-0">压缩质量</span>
                <input id="quality-slider" type="range" min="1" max="100" value="85" class="flex-1 h-2 bg-muted rounded-lg appearance-none cursor-pointer accent-accent" />
                <span id="quality-value" class="text-sm font-mono text-accent w-12 text-right">85%</span>
            </div>

            <div id="results" class="mt-8 space-y-3 hidden">
                <div class="flex items-center justify-between mb-2">
                    <h2 class="text-lg font-medium text-main">转换结果</h2>
                    <button id="download-all-btn" class="px-4 py-1.5 text-sm bg-accent text-white rounded-lg hover:opacity-90 transition-opacity">全部下载</button>
                </div>
                <div id="results-list" class="space-y-3"></div>
            </div>
        </div>

        <!-- JSON Tool -->
        <div id="tab-json" class="tab-content hidden">
            <h2 class="text-xl font-bold text-main mb-1.5">JSON 解析</h2>
            <p class="text-sm text-secondary mb-5">格式化、压缩、实时解析 JSON 字符串。</p>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-sm text-secondary">输入 JSON</span>
                        <div class="flex gap-2">
                            <button id="json-format" class="text-xs px-3 py-1.5 bg-accent text-white rounded-lg hover:opacity-90 transition-opacity">格式化</button>
                            <button id="json-minify" class="text-xs px-3 py-1.5 bg-muted text-main rounded-lg hover:bg-hover transition-colors">压缩</button>
                        </div>
                    </div>
                    <textarea id="json-input" class="w-full h-80 p-3 bg-card border border-light rounded-xl font-mono text-sm resize-y focus:outline-none focus:border-accent" placeholder='{"key": "value"}'></textarea>
                </div>
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-sm text-secondary">解析结果</span>
                        <span id="json-status" class="text-xs text-muted"></span>
                    </div>
                    <pre id="json-output" class="w-full h-80 p-3 bg-card border border-light rounded-xl font-mono text-sm overflow-auto whitespace-pre-wrap"></pre>
                </div>
            </div>
        </div>

        <!-- Diff Tool -->
        <div id="tab-diff" class="tab-content hidden">
            <h2 class="text-xl font-bold text-main mb-1.5">文本 Diff</h2>
            <p class="text-sm text-secondary mb-5">逐行对比两段文本的差异。</p>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div>
                    <span class="text-sm text-secondary mb-1.5 block">原文本 A</span>
                    <textarea id="diff-left" class="w-full h-52 p-3 bg-card border border-light rounded-xl font-mono text-sm resize-y focus:outline-none focus:border-accent" placeholder="输入原文本..."></textarea>
                </div>
                <div>
                    <span class="text-sm text-secondary mb-1.5 block">对比文本 B</span>
                    <textarea id="diff-right" class="w-full h-52 p-3 bg-card border border-light rounded-xl font-mono text-sm resize-y focus:outline-none focus:border-accent" placeholder="输入对比文本..."></textarea>
                </div>
            </div>

            <button id="diff-btn" class="mt-3 px-5 py-1.5 bg-accent text-white rounded-lg hover:opacity-90 transition-opacity text-sm font-medium">开始对比</button>

            <div id="diff-result" class="mt-5 hidden">
                <div class="flex items-center gap-3 mb-2 text-xs">
                    <span class="flex items-center gap-1 text-secondary"><span class="w-2.5 h-2.5 rounded bg-[#dcfce7] border border-[#bbf7d0]"></span> 新增</span>
                    <span class="flex items-center gap-1 text-secondary"><span class="w-2.5 h-2.5 rounded bg-[#fee2e2] border border-[#fecaca]"></span> 删除</span>
                    <span class="flex items-center gap-1 text-secondary"><span class="w-2.5 h-2.5 rounded bg-card border border-light"></span> 相同</span>
                </div>
                <div id="diff-content" class="w-full p-3 bg-card border border-light rounded-xl font-mono text-sm overflow-auto max-h-80"></div>
            </div>
        </div>

        <!-- SQL Tool -->
        <div id="tab-sql" class="tab-content hidden">
            <h2 class="text-xl font-bold text-main mb-1.5">SQL 美化 / 压缩</h2>
            <p class="text-sm text-secondary mb-5">格式化 SQL 语句（关键字大写、换行缩进）或压缩为一行。</p>

            <div class="mb-4 flex items-center justify-between">
                <span class="text-sm text-secondary">输入 SQL</span>
                <div class="flex gap-2">
                    <button id="sql-format" class="text-xs px-3 py-1.5 bg-accent text-white rounded-lg hover:opacity-90 transition-opacity">美化</button>
                    <button id="sql-minify" class="text-xs px-3 py-1.5 bg-muted text-main rounded-lg hover:bg-hover transition-colors">压缩</button>
                </div>
            </div>
            <textarea id="sql-input" class="w-full h-72 p-3 bg-card border border-light rounded-xl font-mono text-sm resize-y focus:outline-none focus:border-accent" placeholder="SELECT * FROM users WHERE id = 1;"></textarea>

            <div id="sql-result-wrap" class="mt-5 hidden">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-sm text-secondary">结果</span>
                    <span id="sql-status" class="text-xs text-muted"></span>
                </div>
                <pre id="sql-output" class="w-full h-72 p-3 bg-card border border-light rounded-xl font-mono text-sm overflow-auto whitespace-pre-wrap select-text"></pre>
            </div>
        </div>

        <!-- Password Tool -->
        <div id="tab-password" class="tab-content hidden">
            <h2 class="text-xl font-bold text-main mb-1.5">随机密码生成</h2>
            <p class="text-sm text-secondary mb-5">纯本地生成，密码不会上传到服务器。</p>

            <div class="bg-card border border-light rounded-xl p-4 mb-5">
                <div class="flex items-center gap-2 mb-3">
                    <input id="pwd-output" type="text" readonly class="flex-1 h-11 px-4 bg-muted border border-light rounded-lg font-mono text-base tracking-wider text-main focus:outline-none select-text" value="" />
                    <button id="pwd-copy-btn" class="h-11 px-4 bg-accent text-white rounded-lg hover:opacity-90 transition-opacity font-medium flex items-center gap-1.5 shrink-0 text-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5"/>
                        </svg>
                        <span id="pwd-copy-text">复制</span>
                    </button>
                    <button id="pwd-refresh-btn" class="h-11 px-4 bg-muted text-main rounded-lg hover:bg-hover transition-colors font-medium flex items-center gap-1.5 shrink-0 text-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/>
                        </svg>
                        <span>刷新</span>
                    </button>
                </div>

                <!-- Strength bar -->
                <div class="flex items-center gap-2">
                    <span class="text-xs text-muted shrink-0">密码强度</span>
                    <div class="flex-1 h-1.5 bg-muted rounded-full overflow-hidden">
                        <div id="pwd-strength-bar" class="h-full w-0 rounded-full transition-all duration-500"></div>
                    </div>
                    <span id="pwd-strength-text" class="text-xs font-medium shrink-0 w-10 text-right">-</span>
                </div>
            </div>

            <!-- Options -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="bg-card border border-light rounded-xl p-4">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-sm font-medium text-main">密码长度</span>
                        <span id="pwd-length-value" class="text-sm font-mono font-bold text-accent">16</span>
                    </div>
                    <input id="pwd-length" type="range" min="4" max="64" value="16" class="w-full h-2 bg-muted rounded-lg appearance-none cursor-pointer accent-accent" />
                    <div class="flex justify-between mt-1.5 text-xs text-muted">
                        <span>4</span>
                        <span>64</span>
                    </div>
                </div>

                <div class="bg-card border border-light rounded-xl p-4">
                    <span class="text-sm font-medium text-main block mb-3">字符类型</span>
                    <div class="space-y-2">
                        <label class="flex items-center gap-2.5 cursor-pointer group">
                            <input type="checkbox" id="pwd-uppercase" checked class="w-3.5 h-3.5 rounded border-light text-accent focus:ring-accent" />
                            <span class="text-sm text-main group-hover:text-accent transition-colors">大写字母 (A-Z)</span>
                        </label>
                        <label class="flex items-center gap-2.5 cursor-pointer group">
                            <input type="checkbox" id="pwd-lowercase" checked class="w-3.5 h-3.5 rounded border-light text-accent focus:ring-accent" />
                            <span class="text-sm text-main group-hover:text-accent transition-colors">小写字母 (a-z)</span>
                        </label>
                        <label class="flex items-center gap-2.5 cursor-pointer group">
                            <input type="checkbox" id="pwd-numbers" checked class="w-3.5 h-3.5 rounded border-light text-accent focus:ring-accent" />
                            <span class="text-sm text-main group-hover:text-accent transition-colors">数字 (0-9)</span>
                        </label>
                        <label class="flex items-center gap-2.5 cursor-pointer group">
                            <input type="checkbox" id="pwd-symbols" checked class="w-3.5 h-3.5 rounded border-light text-accent focus:ring-accent" />
                            <span class="text-sm text-main group-hover:text-accent transition-colors">特殊符号 (!@#$...)</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</DefaultLayout>

<script>
    // ===== Tab Switching =====
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const tab = btn.dataset.tab;

            tabBtns.forEach(b => {
                b.classList.remove('active', 'bg-accent', 'text-white');
                b.classList.add('text-secondary', 'hover:text-main', 'hover:bg-hover');
            });
            btn.classList.add('active', 'bg-accent', 'text-white');
            btn.classList.remove('text-secondary', 'hover:text-main', 'hover:bg-hover');

            tabContents.forEach(c => c.classList.add('hidden'));
            document.getElementById('tab-' + tab)!.classList.remove('hidden');

            // 切换到 SQL tab 时预加载 sql-formatter（后台静默加载，不阻塞交互）
            if (tab === 'sql' && typeof loadSqlFormatter !== 'undefined' && !sqlFormatterModule) {
                loadSqlFormatter().catch(() => {});
            }
        });
    });

    // ===== Image Tool =====
    const dropZone = document.getElementById('drop-zone')!;
    const fileInput = document.getElementById('file-input')! as HTMLInputElement;
    const qualitySlider = document.getElementById('quality-slider')! as HTMLInputElement;
    const qualityValue = document.getElementById('quality-value')!;
    const results = document.getElementById('results')!;
    const resultsList = document.getElementById('results-list')!;
    const downloadAllBtn = document.getElementById('download-all-btn')!;
    let convertedFiles: { name: string; blob: Blob; url: string }[] = [];

    qualitySlider.addEventListener('input', () => {
        qualityValue.textContent = qualitySlider.value + '%';
    });

    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('border-accent', 'bg-accent/5');
    });
    dropZone.addEventListener('dragleave', () => {
        dropZone.classList.remove('border-accent', 'bg-accent/5');
    });
    dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-accent', 'bg-accent/5');
        if (e.dataTransfer?.files) handleFiles(e.dataTransfer.files);
    });
    fileInput.addEventListener('change', () => {
        if (fileInput.files) handleFiles(fileInput.files);
    });

    function handleFiles(files: FileList) {
        const validFiles = Array.from(files).filter(f =>
            f.type === 'image/png' || f.type === 'image/jpeg' || f.type === 'image/jpg' || f.type === 'image/webp'
        );
        if (validFiles.length === 0) return;
        convertedFiles = [];
        resultsList.innerHTML = '';
        results.classList.remove('hidden');
        validFiles.forEach(file => convertImage(file));
    }

    function convertImage(file: File) {
        const reader = new FileReader();
        reader.onload = (e) => {
            const img = new Image();
            img.onload = () => {
                const canvas = document.createElement('canvas');
                canvas.width = img.width;
                canvas.height = img.height;
                const ctx = canvas.getContext('2d')!;
                ctx.drawImage(img, 0, 0);
                const quality = parseInt(qualitySlider.value) / 100;
                canvas.toBlob((blob) => {
                    if (!blob) return;
                    const url = URL.createObjectURL(blob);
                    const name = file.name.replace(/\.[^.]+$/, '') + '.webp';
                    convertedFiles.push({ name, blob, url });
                    addResultItem(file.name, file.size, blob.size, url, name);
                }, 'image/webp', quality);
            };
            img.src = e.target?.result as string;
        };
        reader.readAsDataURL(file);
    }

    function formatSize(bytes: number): string {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
    }

    function addResultItem(originalName: string, originalSize: number, newSize: number, url: string, downloadName: string) {
        const saved = originalSize - newSize;
        const savedPercent = ((saved / originalSize) * 100).toFixed(1);
        const savedText = saved > 0 ? `节省 ${formatSize(saved)} (${savedPercent}%)` : `增加 ${formatSize(-saved)}`;
        const item = document.createElement('div');
        item.className = 'flex items-center gap-4 p-4 bg-card rounded-xl border border-light';
        item.innerHTML = `
            <div class="w-12 h-12 rounded-lg bg-muted flex items-center justify-center shrink-0 overflow-hidden">
                <img src="${url}" alt="preview" class="w-full h-full object-cover" />
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm text-main truncate">${originalName}</p>
                <p class="text-xs text-muted">${formatSize(originalSize)} → ${formatSize(newSize)} · ${savedText}</p>
            </div>
            <a href="${url}" download="${downloadName}" class="px-3 py-1.5 text-sm bg-accent text-white rounded-lg hover:opacity-90 transition-opacity shrink-0">下载</a>
        `;
        resultsList.appendChild(item);
    }

    downloadAllBtn.addEventListener('click', () => {
        convertedFiles.forEach(({ url, name }) => {
            const a = document.createElement('a');
            a.href = url; a.download = name; a.click();
        });
    });

    // ===== JSON Tool =====
    const jsonInput = document.getElementById('json-input')! as HTMLTextAreaElement;
    const jsonOutput = document.getElementById('json-output')!;
    const jsonStatus = document.getElementById('json-status')!;

    function parseJSON(input: string, pretty: boolean): string {
        try {
            const parsed = JSON.parse(input.trim() || '{}');
            jsonStatus.textContent = '';
            jsonStatus.className = 'text-xs text-green-600';
            return JSON.stringify(parsed, null, pretty ? 2 : undefined);
        } catch (err) {
            jsonStatus.textContent = '解析错误：' + (err as Error).message;
            jsonStatus.className = 'text-xs text-red-500';
            return '';
        }
    }

    // Real-time parse
    jsonInput.addEventListener('input', () => {
        const result = parseJSON(jsonInput.value, true);
        jsonOutput.textContent = result || jsonOutput.textContent;
    });

    document.getElementById('json-format')!.addEventListener('click', () => {
        jsonOutput.textContent = parseJSON(jsonInput.value, true);
    });

    document.getElementById('json-minify')!.addEventListener('click', () => {
        jsonOutput.textContent = parseJSON(jsonInput.value, false);
    });

    // ===== Diff Tool =====
    const diffLeft = document.getElementById('diff-left')! as HTMLTextAreaElement;
    const diffRight = document.getElementById('diff-right')! as HTMLTextAreaElement;
    const diffBtn = document.getElementById('diff-btn')!;
    const diffResult = document.getElementById('diff-result')!;
    const diffContent = document.getElementById('diff-content')!;

    diffBtn.addEventListener('click', () => {
        const left = diffLeft.value;
        const right = diffRight.value;
        if (!left && !right) {
            diffResult.classList.add('hidden');
            return;
        }
        const diffs = diffLines(left, right);
        renderDiff(diffs);
        diffResult.classList.remove('hidden');
    });

    function diffLines(a: string, b: string): { type: 'same' | 'add' | 'del'; line: string }[] {
        const left = a.split('\n');
        const right = b.split('\n');
        const result: { type: 'same' | 'add' | 'del'; line: string }[] = [];
        let i = 0, j = 0;

        while (i < left.length || j < right.length) {
            if (i >= left.length) {
                result.push({ type: 'add', line: right[j] });
                j++;
            } else if (j >= right.length) {
                result.push({ type: 'del', line: left[i] });
                i++;
            } else if (left[i] === right[j]) {
                result.push({ type: 'same', line: left[i] });
                i++; j++;
            } else {
                const nextMatchRight = right.indexOf(left[i], j);
                const nextMatchLeft = left.indexOf(right[j], i);
                if (nextMatchRight === -1 && nextMatchLeft === -1) {
                    result.push({ type: 'del', line: left[i] });
                    result.push({ type: 'add', line: right[j] });
                    i++; j++;
                } else if (nextMatchRight !== -1 && (nextMatchLeft === -1 || nextMatchRight - j <= nextMatchLeft - i)) {
                    for (let k = j; k < nextMatchRight; k++) {
                        result.push({ type: 'add', line: right[k] });
                    }
                    j = nextMatchRight;
                } else {
                    for (let k = i; k < nextMatchLeft; k++) {
                        result.push({ type: 'del', line: left[k] });
                    }
                    i = nextMatchLeft;
                }
            }
        }
        return result;
    }

    function renderDiff(diffs: { type: string; line: string }[]) {
        diffContent.innerHTML = '';
        diffs.forEach((d, idx) => {
            const row = document.createElement('div');
            row.className = 'flex items-start gap-3 py-0.5 px-2 rounded';

            const prefix = document.createElement('span');
            prefix.className = 'w-4 shrink-0 text-center select-none text-xs font-mono';

            const text = document.createElement('span');
            text.className = 'break-all whitespace-pre-wrap';
            text.textContent = d.line || ' ';

            if (d.type === 'add') {
                row.className += ' bg-[#dcfce7] dark:bg-[#14532d]/30';
                prefix.textContent = '+';
                prefix.className += ' text-green-600';
            } else if (d.type === 'del') {
                row.className += ' bg-[#fee2e2] dark:bg-[#7f1d1d]/30';
                prefix.textContent = '-';
                prefix.className += ' text-red-500';
            } else {
                prefix.textContent = ' ';
            }

            row.appendChild(prefix);
            row.appendChild(text);
            diffContent.appendChild(row);
        });
    }

    // ===== SQL Tool =====
    const sqlInput = document.getElementById('sql-input')! as HTMLTextAreaElement;
    const sqlOutput = document.getElementById('sql-output')!;
    const sqlStatus = document.getElementById('sql-status')!;
    const sqlResultWrap = document.getElementById('sql-result-wrap')!;

    // sql-formatter lazy load (CDN, avoid bundling into global JS)
    let sqlFormatterModule: any = null;
    async function loadSqlFormatter() {
        if (sqlFormatterModule) return sqlFormatterModule;
        sqlStatus.textContent = '...';
        sqlFormatterModule = await import('https://cdn.jsdelivr.net/npm/sql-formatter@15.7.3/dist/sql-formatter.min.mjs');
        sqlStatus.textContent = '';
        return sqlFormatterModule;
    }

    async function formatSQL(sql: string): Promise<string> {
        if (!sql.trim()) return '';
        const { format } = await loadSqlFormatter();
        return format(sql, {
            keywordCase: 'upper',
            identifierCase: 'preserve',
            dataTypeCase: 'preserve',
            functionCase: 'preserve',
            indentStyle: 'standard',
            tabWidth: 2,
            useTabs: false,
            language: 'sql',
        });
    }

    document.getElementById('sql-format')!.addEventListener('click', async () => {
        const result = await formatSQL(sqlInput.value);
        sqlOutput.textContent = result;
        sqlResultWrap.classList.remove('hidden');
        sqlStatus.textContent = result ? '美化完成' : '请输入 SQL';
    });

    document.getElementById('sql-minify')!.addEventListener('click', async () => {
        const input = sqlInput.value.trim();
        if (!input) {
            sqlResultWrap.classList.remove('hidden');
            sqlStatus.textContent = '请输入 SQL';
            sqlOutput.textContent = '';
            return;
        }
        const { format } = await loadSqlFormatter();
        const result = format(input, {
            keywordCase: 'upper',
            indentStyle: 'tabularLeft',
            tabWidth: 0,
            expressionWidth: 99999,
            linesBetweenQueries: 0,
            language: 'sql',
        }).replace(/\s+/g, ' ').trim();
        sqlOutput.textContent = result;
        sqlResultWrap.classList.remove('hidden');
        sqlStatus.textContent = '压缩完成';
    });

    function setupSelectAll(el: HTMLElement) {
        el.setAttribute('tabindex', '0');
        el.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key === 'a') {
                e.preventDefault();
                const sel = window.getSelection();
                const range = document.createRange();
                range.selectNodeContents(el);
                sel?.removeAllRanges();
                sel?.addRange(range);
            }
        });
    }
    // ===== Password Tool =====
    const pwdOutput = document.getElementById('pwd-output')! as HTMLInputElement;
    const pwdCopyBtn = document.getElementById('pwd-copy-btn')!;
    const pwdCopyText = document.getElementById('pwd-copy-text')!;
    const pwdRefreshBtn = document.getElementById('pwd-refresh-btn')!;
    const pwdLength = document.getElementById('pwd-length')! as HTMLInputElement;
    const pwdLengthValue = document.getElementById('pwd-length-value')!;
    const pwdUppercase = document.getElementById('pwd-uppercase')! as HTMLInputElement;
    const pwdLowercase = document.getElementById('pwd-lowercase')! as HTMLInputElement;
    const pwdNumbers = document.getElementById('pwd-numbers')! as HTMLInputElement;
    const pwdSymbols = document.getElementById('pwd-symbols')! as HTMLInputElement;
    const pwdStrengthBar = document.getElementById('pwd-strength-bar')!;
    const pwdStrengthText = document.getElementById('pwd-strength-text')!;

    const CHAR_SETS = {
        uppercase: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
        lowercase: 'abcdefghijklmnopqrstuvwxyz',
        numbers: '0123456789',
        symbols: '!@#$%^&*()_+-=[]{}|;:,.<>?',
    };

    function generatePassword(): string {
        const length = parseInt(pwdLength.value);
        let chars = '';
        let required: string[] = [];

        if (pwdUppercase.checked) {
            chars += CHAR_SETS.uppercase;
            required.push(CHAR_SETS.uppercase[Math.floor(Math.random() * CHAR_SETS.uppercase.length)]);
        }
        if (pwdLowercase.checked) {
            chars += CHAR_SETS.lowercase;
            required.push(CHAR_SETS.lowercase[Math.floor(Math.random() * CHAR_SETS.lowercase.length)]);
        }
        if (pwdNumbers.checked) {
            chars += CHAR_SETS.numbers;
            required.push(CHAR_SETS.numbers[Math.floor(Math.random() * CHAR_SETS.numbers.length)]);
        }
        if (pwdSymbols.checked) {
            chars += CHAR_SETS.symbols;
            required.push(CHAR_SETS.symbols[Math.floor(Math.random() * CHAR_SETS.symbols.length)]);
        }

        if (!chars) {
            pwdLowercase.checked = true;
            chars = CHAR_SETS.lowercase;
            required.push(CHAR_SETS.lowercase[Math.floor(Math.random() * CHAR_SETS.lowercase.length)]);
        }

        // Fill remaining with random chars
        let password = required.join('');
        for (let i = password.length; i < length; i++) {
            password += chars[Math.floor(Math.random() * chars.length)];
        }

        // Shuffle
        password = password.split('').sort(() => Math.random() - 0.5).join('');

        return password;
    }

    function calcStrength(password: string): { score: number; label: string; color: string } {
        let score = 0;
        const length = password.length;

        if (length >= 8) score++;
        if (length >= 12) score++;
        if (length >= 16) score++;
        if (/[A-Z]/.test(password)) score++;
        if (/[a-z]/.test(password)) score++;
        if (/[0-9]/.test(password)) score++;
        if (/[^A-Za-z0-9]/.test(password)) score++;

        // Max score is 7, normalize to 0-4
        const normalized = Math.min(4, Math.floor(score / 1.75));

        const levels = [
            { label: '极弱', color: '#ef4444' },
            { label: '较弱', color: '#f97316' },
            { label: '一般', color: '#eab308' },
            { label: '较强', color: '#84cc16' },
            { label: '极强', color: '#22c55e' },
        ];

        return { score: normalized, ...levels[normalized] };
    }

    function updatePassword() {
        const password = generatePassword();
        pwdOutput.value = password;
        const strength = calcStrength(password);
        pwdStrengthBar.style.width = ((strength.score + 1) / 5 * 100) + '%';
        pwdStrengthBar.style.backgroundColor = strength.color;
        pwdStrengthText.textContent = strength.label;
        pwdStrengthText.style.color = strength.color;
    }

    pwdLength.addEventListener('input', () => {
        pwdLengthValue.textContent = pwdLength.value;
        updatePassword();
    });

    [pwdUppercase, pwdLowercase, pwdNumbers, pwdSymbols].forEach(el => {
        el.addEventListener('change', updatePassword);
    });

    pwdRefreshBtn.addEventListener('click', updatePassword);

    pwdCopyBtn.addEventListener('click', async () => {
        if (!pwdOutput.value) return;
        try {
            await navigator.clipboard.writeText(pwdOutput.value);
            pwdCopyText.textContent = '已复制';
            setTimeout(() => {
                pwdCopyText.textContent = '复制';
            }, 1500);
        } catch {
            pwdOutput.select();
            document.execCommand('copy');
            pwdCopyText.textContent = '已复制';
            setTimeout(() => {
                pwdCopyText.textContent = '复制';
            }, 1500);
        }
    });

    // Init
    updatePassword();

    setupSelectAll(jsonOutput);
    setupSelectAll(sqlOutput);
    setupSelectAll(diffContent);
</script>

<style>
    .tab-btn.active {
        background-color: var(--accent-color);
        color: #fff;
    }
</style>
