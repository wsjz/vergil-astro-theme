---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDocSets } from '../../utils/docs-utils';
import { Image } from 'astro:assets';

const docSets = await getDocSets();

const allTags = Array.from(
    new Set(docSets.flatMap((set) => (set.meta.data.tags as string[]) || []))
).sort();

const tagColors: Record<string, string> = {
    '博客搭建': 'bg-pink-100 text-pink-700 dark:bg-pink-900/30 dark:text-pink-300',
    '主题': 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300',
    '前端': 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300',
    '教程': 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300',
    '运维': 'bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-300',
    '后端': 'bg-cyan-100 text-cyan-700 dark:bg-cyan-900/30 dark:text-cyan-300',
};

function getTagClass(tag: string) {
    return (
        tagColors[tag] ||
        'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300'
    );
}
---

<BaseLayout title="文档" description="所有文档集列表">
    <div class="mb-6">
        <h1 class="font-display text-2xl font-medium mb-2">文档</h1>
        <p class="text-sm text-secondary">共 {docSets.length} 个文档集</p>
    </div>

    {
        allTags.length > 0 && (
            <div class="flex flex-wrap items-center gap-2 mb-6" id="doc-filter-bar">
                <button
                    class="doc-filter-btn active px-3 py-1 text-sm rounded-full border border-accent bg-accent text-white transition-all"
                    data-filter="all"
                >
                    全部
                </button>
                {allTags.map((tag) => (
                    <button
                        class="doc-filter-btn px-3 py-1 text-sm rounded-full border border-light text-secondary hover:border-accent hover:text-accent transition-all"
                        data-filter={tag}
                    >
                        {tag}
                    </button>
                ))}
            </div>
        )
    }

    <div class="grid grid-cols-1 gap-4" id="doc-grid">
        {
            docSets.map((set) => {
                const tags = (set.meta.data.tags as string[]) || [];
                const tagStr = tags.join(',');
                const cover = set.meta.data.cover;
                return (
                    <a
                        href={`/docs/${set.id}/`}
                        class="doc-card group flex flex-col sm:flex-row gap-4 p-4 sm:p-5 rounded-2xl shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
                        style="background-color: color-mix(in srgb, var(--bg-card) 80%, transparent); backdrop-filter: blur(8px);"
                        data-tags={tagStr}
                    >
                        <div class="shrink-0 w-20 h-20 sm:w-24 sm:h-24 rounded-xl overflow-hidden bg-muted flex items-center justify-center relative shadow-inner">
                            {cover ? (
                                <>
                                    <Image
                                        src={cover}
                                        alt={set.meta.data.title}
                                        class="w-full h-full object-cover transition-all duration-300 group-hover:scale-105 group-hover:brightness-90"
                                        width={96}
                                        height={96}
                                    />
                                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-all duration-300 pointer-events-none" />
                                </>
                            ) : (
                                <div class="w-full h-full bg-accent/10 flex items-center justify-center text-accent">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="32"
                                        height="32"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                                    </svg>
                                </div>
                            )}
                        </div>
                        <div class="min-w-0 flex-1 flex flex-col justify-center">
                            {tags.length > 0 && (
                                <div class="flex flex-wrap gap-1.5 mb-2">
                                    {tags.map((tag) => (
                                        <span
                                            class={`text-xs px-2 py-0.5 rounded-md font-medium ${getTagClass(tag)}`}
                                        >
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                            )}
                            <h2 class="font-display text-lg font-medium text-main group-hover:text-accent transition-colors line-clamp-1">
                                {set.meta.data.title}
                            </h2>
                            {set.meta.data.description && (
                                <p class="text-sm text-secondary mt-1 line-clamp-2">
                                    {set.meta.data.description}
                                </p>
                            )}
                        </div>
                    </a>
                );
            })
        }
    </div>

    <script is:inline>
        (function () {
            const btns = document.querySelectorAll('.doc-filter-btn');
            const cards = document.querySelectorAll('.doc-card');

            btns.forEach((btn) => {
                btn.addEventListener('click', function () {
                    const filter = this.dataset.filter;

                    btns.forEach((b) => {
                        b.classList.remove('active', 'bg-accent', 'text-white', 'border-accent');
                        b.classList.add('border-light', 'text-secondary');
                    });
                    this.classList.add('active', 'bg-accent', 'text-white', 'border-accent');
                    this.classList.remove('border-light', 'text-secondary');

                    cards.forEach((card) => {
                        const tags = card.dataset.tags || '';
                        if (filter === 'all' || tags.split(',').includes(filter)) {
                            card.style.display = '';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            });
        })();
    </script>
</BaseLayout>
