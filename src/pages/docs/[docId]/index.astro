---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { getDocSets, getDocHomepageSlug, getAdjacentDocs } from '../../../utils/docs-utils';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import DocsNav from '../../../components/docs/DocsNav.astro';
import FloatingToc from '../../../components/widgets/FloatingToc.astro';
import SidebarToc from '../../../components/widgets/SidebarToc.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import HeroSplash from '../../../components/content/HeroSplash.astro';

export const getStaticPaths = (async () => {
    const sets = await getDocSets();
    return sets.map((set) => ({
        params: { docId: set.id }
    }));
}) satisfies GetStaticPaths;

const { docId } = Astro.params;
const sets = await getDocSets();
const currentSet = sets.find((s) => s.id === docId);
const meta = currentSet?.meta;
const splashConfig = meta?.data?.splash as Record<string, any> | undefined;
const splashEnabled = splashConfig?.enabled === true;

// 获取 homepage 文档
const homepageSlug = await getDocHomepageSlug(docId);
let entry = null;
let Content = null;
let headings: any[] = [];

if (homepageSlug) {
    const entries = await getCollection('docs', ({ data }) => !data.draft);
    const expectedId = `${docId}/${homepageSlug}`;
    entry = entries.find((e) => !(e.id.endsWith('/_meta') || e.id === '_meta') && (e.id === expectedId || e.id === `${expectedId}/index`));
    if (entry) {
        const rendered = await render(entry);
        Content = rendered.Content;
        headings = rendered.headings;
    }
}

// 如果没有找到文章也没有开启 splash，跳转回文档列表
if (!entry && !splashEnabled) {
    return Astro.redirect('/docs/');
}

const articleSlug = entry ? entry.id.split('/').slice(1).join('/').replace(/\/index$/, '') : '';
const { prev, next } = articleSlug ? await getAdjacentDocs(docId, articleSlug) : { prev: null, next: null };
const metaTitle = (meta?.data?.title as string) ?? docId;
---

<DocsLayout
    title={(entry?.data?.title as string) || (meta?.data?.title as string) || docId}
    description={(entry?.data?.excerpt as string) || (meta?.data?.description as string) || ''}
    pageType="article"
    docId={docId}
    currentSlug={homepageSlug || ''}
    articleTitle={(entry?.data?.title as string) || (meta?.data?.title as string) || ''}
    splashMode={splashEnabled}
>
    {splashEnabled && (
        <HeroSplash
            slot="splash"
            title={(meta?.data?.title as string) || docId}
            subtitle={(meta?.data?.subtitle as string) || 'Documentation'}
            description={(meta?.data?.description as string) || ''}
            backgroundImage={splashConfig?.backgroundImage}
            overlay={splashConfig?.overlay}
            textShadow={splashConfig?.textShadow !== false}
            buttonText={splashConfig?.buttonText || '开始阅读'}
            fallbackBg={splashConfig?.fallbackBg}
            gradientColor={splashConfig?.gradientColor}
            gradientHeight={splashConfig?.gradientHeight || 'h-56'}
            backdropBlur={splashConfig?.backdropBlur || '12px'}
            snapScroll={true}
        />
    )}

    <FloatingToc headings={headings} />

    <div slot="title" class="flex items-center gap-2 mb-4 pb-3 border-b border-light">
        <span class="font-display text-sm font-medium text-main">{metaTitle}</span>
    </div>

    {entry && (
        <article class="mb-16 sm:mb-24">
            <header class="mb-8">
                <h1 class="font-display text-2xl leading-tight font-medium sm:text-3xl sm:leading-tight">{entry.data.title}</h1>
                {entry.data.excerpt && (
                    <p class="mt-3 text-sm text-secondary">{entry.data.excerpt}</p>
                )}
            </header>

            <div class="prose sm:prose-lg max-w-none" data-current-slug={homepageSlug || ''}>
                <Content />
            </div>
        </article>
    )}

    {!entry && (
        <div class="flex flex-col items-center justify-center min-h-[40vh] text-secondary">
            <p>该知识库暂无文章</p>
            <a href="/docs/" class="mt-4 text-accent hover:underline">返回文档列表</a>
        </div>
    )}

    <SidebarToc headings={headings} slot="right-sidebar" />

    <DocsNav docId={docId} prev={prev} next={next} />

    <script is:inline>
        (function() {
            // 修复文档集首页上子文档内容中的相对链接
            // 首页 URL 为 /docs/docId/，子文档中的相对链接基于子文档自身 URL 编写，
            // 但在首页上浏览器会以首页 URL 为基准解析，导致路径错位。
            // 用 firstSlug 构建基准 URL，通过 URL 构造函数正确解析任意层级相对路径。
            var path = location.pathname;
            var match = path.match(/^\/docs\/([^/]+)\/$/);
            if (!match) return;
            var docId = match[1];

            var prose = document.querySelector('article .prose');
            if (!prose) return;

            var firstSlug = prose.dataset.currentSlug || '';
            if (!firstSlug) return;

            var baseUrl = location.origin + '/docs/' + docId + '/' + firstSlug + '/';

            prose.querySelectorAll('a[href]').forEach(function(a) {
                var href = a.getAttribute('href');
                if (!href) return;
                // 只处理相对链接（非协议链接、非绝对路径）
                if (/^[a-z][a-z0-9+.-]*:/i.test(href)) return;
                if (href.startsWith('/')) return;
                if (href.startsWith('#')) return;

                try {
                    var resolved = new URL(href, baseUrl).pathname;
                    a.setAttribute('href', resolved);
                } catch (e) {
                    // 忽略无效 URL
                }
            });
        })();
    </script>
</DocsLayout>
