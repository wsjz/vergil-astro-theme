---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import DocsNav from '../../../components/docs/DocsNav.astro';
import TocSidebar from '../../../components/widgets/TocSidebar.astro';
import FloatingToc from '../../../components/widgets/FloatingToc.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import { getDocSets, getDocEntry, getAdjacentDocs, getDocGroup, type DocTreeNode } from '../../../utils/docs-utils';

export async function getStaticPaths() {
    const entries = await getCollection('docs');
    const nonMeta = entries.filter((e) => !(e.id.endsWith('/_meta') || e.id === '_meta'));
    return nonMeta
        .map((entry) => {
            const parts = entry.id.split('/');
            const docId = parts[0];
            const slug = parts.slice(1).join('/').replace(/\/index$/, '');
            return { params: { docId, slug } };
        })
        .filter((p) => p.params.slug !== '');
}

const { docId, slug } = Astro.params;
const entry = await getDocEntry(docId, slug);
if (!entry) {
    return new Response('Not Found', { status: 404 });
}

const { Content, headings } = await render(entry);
const { prev, next } = await getAdjacentDocs(docId, slug);
const sets = await getDocSets();
const currentSet = sets.find((s) => s.id === docId);
const metaTitle = (currentSet?.meta.data.title as string) ?? docId;

function resolveBannerUrl(banner: string | undefined): string | null {
    if (!banner) return null;
    if (banner.startsWith('http')) {
        return banner;
    }
    // 关键词模式：使用固定 unsplash 随机图
    return `https://images.unsplash.com/photo-1557682250-33bd709cbe85?w=1600&h=400&fit=crop&q=80`;
}

const bannerUrl = resolveBannerUrl(entry.data.banner as string | undefined);

// 判断是否开启自动渲染子目录
// Astro glob loader 中 index.md 的 entry.id 格式为 docId/slug（不带 /index 后缀）
// 判断方法：slug 是否对应一个已注册的目录
const group = await getDocGroup(docId, slug);
const isIndexPage = !!group;
const autoRender = entry.data.autoRender === true;
let groupChildren: DocTreeNode[] = [];
if (isIndexPage && autoRender && group) {
    groupChildren = group.children;
}
// 开启了 autoRender 但无子目录时，回退到正常渲染用户内容
const showAutoRender = autoRender && groupChildren.length > 0;
---

<DocsLayout
    title={String(entry.data.title)}
    description={String(entry.data.excerpt ?? '')}
    pageType="article"
    docId={docId}
    currentSlug={slug}
    articleTitle={String(entry.data.title)}
>
    <div slot="right-sidebar">
        <TocSidebar headings={headings} />
    </div>

    <FloatingToc headings={headings} />

    <div slot="title" class="flex items-center gap-2 mb-4 pb-3 border-b border-light">
        <span class="font-display text-sm font-medium text-main">{metaTitle}</span>
    </div>

    {bannerUrl && (
        <div class="article-banner relative -mx-4 sm:-mx-8 mb-8 overflow-hidden rounded-xl h-[180px] sm:h-[220px]">
            <img
                src={bannerUrl}
                alt={String(entry.data.title)}
                class="absolute inset-0 w-full h-full object-cover"
                loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
            <div class="absolute inset-0 flex flex-col justify-between p-6 sm:p-8">
                <div class="flex flex-wrap items-center gap-2 text-sm text-white/80 drop-shadow [&_a]:text-white/80 [&_a:hover]:text-white [&_span]:text-white/60">
                    <Breadcrumb
                        crumbs={[
                            { text: 'Docs', href: '/docs/' },
                            { text: metaTitle, href: `/docs/${docId}/` },
                            { text: String(entry.data.title) }
                        ]}
                    />
                </div>
                <div>
                    <h1 class="font-display text-2xl leading-tight font-medium text-white sm:text-3xl sm:leading-tight drop-shadow-lg">{entry.data.title}</h1>
                </div>
            </div>
        </div>
    )}

    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            {!bannerUrl && (
                <>
                    <h1 class="font-display text-2xl leading-tight font-medium sm:text-3xl sm:leading-tight">{entry.data.title}</h1>
                    {entry.data.excerpt && (
                        <p class="mt-3 text-sm text-secondary">{entry.data.excerpt}</p>
                    )}
                </>
            )}
        </header>

        {showAutoRender ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {groupChildren.map((child) => {
                    const isGroup = child.type === 'group';
                    const href = isGroup
                        ? `/docs/${docId}/${child.dirPath}/`
                        : `/docs/${docId}/${child.slug}/`;
                    const childCount = isGroup ? child.children.length : 0;
                    return (
                        <a
                            href={href}
                            class="group flex items-center gap-3 p-4 rounded-xl border border-light hover:border-accent/40 hover:bg-accent/5 transition-all"
                        >
                            <span class="flex-1 min-w-0">
                                <span class="block font-medium text-main group-hover:text-accent transition-colors line-clamp-1">
                                    {child.title}
                                </span>
                                {isGroup && childCount > 0 && (
                                    <span class="block text-xs text-muted mt-0.5">
                                        {childCount} 个子项
                                    </span>
                                )}
                            </span>
                            <svg class="w-4 h-4 text-muted group-hover:text-accent transition-colors shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
                            </svg>
                        </a>
                    );
                })}
            </div>
        ) : (
            <div class="prose sm:prose-lg max-w-none">
                <Content />
            </div>
        )}
    </article>

    <DocsNav docId={docId} prev={prev} next={next} />
</DocsLayout>
