---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import DocsNav from '../../../components/docs/DocsNav.astro';
import TocSidebar from '../../../components/widgets/TocSidebar.astro';
import FloatingToc from '../../../components/widgets/FloatingToc.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import { getDocSets, getDocEntry, getAdjacentDocs } from '../../../utils/docs-utils';

export async function getStaticPaths() {
    const entries = await getCollection('docs');
    const nonMeta = entries.filter((e) => !(e.id.endsWith('/_meta') || e.id === '_meta'));
    return nonMeta.map((entry) => {
        const parts = entry.id.split('/');
        const docId = parts[0];
        const slug = parts.slice(1).join('/').replace(/\/index$/, '');
        return { params: { docId, slug } };
    });
}

const { docId, slug } = Astro.params;
const entry = await getDocEntry(docId, slug);
if (!entry) {
    return new Response('Not Found', { status: 404 });
}

const { Content, headings } = await render(entry);
const { prev, next } = await getAdjacentDocs(docId, slug);
const sets = await getDocSets();
const currentSet = sets.find((s) => s.id === docId);
const metaTitle = (currentSet?.meta.data.title as string) ?? docId;

function resolveBannerUrl(banner: string | undefined): string | null {
    if (!banner) return null;
    if (banner.startsWith('http')) {
        return banner;
    }
    // 关键词模式：使用固定 unsplash 随机图
    return `https://images.unsplash.com/photo-1557682250-33bd709cbe85?w=1600&h=400&fit=crop&q=80`;
}

const bannerUrl = resolveBannerUrl(entry.data.banner as string | undefined);
---

<DocsLayout
    title={entry.data.title as string}
    description={(entry.data.excerpt as string) ?? ''}
    pageType="article"
    docId={docId}
    currentSlug={slug}
    articleTitle={entry.data.title as string}
>
    <div slot="right-sidebar">
        <TocSidebar headings={headings} />
    </div>

    <FloatingToc headings={headings} />

    <div slot="title" class="flex items-center gap-2 mb-4 pb-3 border-b border-light">
        <span class="font-display text-sm font-medium text-main">{metaTitle}</span>
    </div>

    {bannerUrl && (
        <div class="article-banner relative -mx-4 sm:-mx-8 mb-8 overflow-hidden rounded-xl h-[180px] sm:h-[220px]">
            <img
                src={bannerUrl}
                alt={entry.data.title as string}
                class="absolute inset-0 w-full h-full object-cover"
                loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
            <div class="absolute inset-0 flex flex-col justify-between p-6 sm:p-8">
                <div class="flex flex-wrap items-center gap-2 text-sm text-white/80 drop-shadow [&_a]:text-white/80 [&_a:hover]:text-white [&_span]:text-white/60">
                    <Breadcrumb
                        crumbs={[
                            { text: 'Docs', href: '/docs/' },
                            { text: metaTitle, href: `/docs/${docId}/` },
                            { text: entry.data.title as string }
                        ]}
                    />
                </div>
                <div>
                    <h1 class="font-display text-2xl leading-tight font-medium text-white sm:text-3xl sm:leading-tight drop-shadow-lg">{entry.data.title}</h1>
                </div>
            </div>
        </div>
    )}

    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            {!bannerUrl && (
                <>
                    <h1 class="font-display text-2xl leading-tight font-medium sm:text-3xl sm:leading-tight">{entry.data.title}</h1>
                    {entry.data.excerpt && (
                        <p class="mt-3 text-sm text-secondary">{entry.data.excerpt}</p>
                    )}
                </>
            )}
        </header>

        <div class="prose sm:prose-lg max-w-none">
            <Content />
        </div>
    </article>

    <DocsNav docId={docId} prev={prev} next={next} />
</DocsLayout>
