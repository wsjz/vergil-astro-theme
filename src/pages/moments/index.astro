---
import fs from 'node:fs';
import path from 'node:path';
import { ChevronDown } from '@lucide/astro';
import { t } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Moment from '../../components/content/Moment.astro';
import siteConfig from '../../data/site-config';
import avatar from '../../assets/images/avatar.jpg';

const avatarSrc = typeof avatar === 'string' ? avatar : avatar.src;
const signature = t.page.moments.signature;
const bannerUrl = 'https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=1200&h=400&fit=crop&q=80';

interface MomentPost {
    date: string;
    content: string;
    images?: string[];
    linkCard?: Record<string, string>;
    forward?: Record<string, unknown>;
    tags?: string[];
}

const momentsDir = path.join(process.cwd(), 'src', 'content', 'moments');
let allPosts: MomentPost[] = [];

if (fs.existsSync(momentsDir)) {
    const files = fs.readdirSync(momentsDir)
        .filter(f => f.endsWith('.json'))
        .sort((a, b) => b.localeCompare(a)); // 文件名倒序，确保时间倒序

    for (const file of files) {
        const filePath = path.join(momentsDir, file);
        const raw = fs.readFileSync(filePath, 'utf-8');
        try {
            const data = JSON.parse(raw);
            allPosts.push(data);
        } catch (e) {
            console.warn(`Failed to parse ${file}:`, e);
        }
    }
}

allPosts.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const PAGE_SIZE = 5;
const currentYear = new Date().getFullYear();
const initialPosts = allPosts.slice(0, PAGE_SIZE);

function getPostYear(post: typeof allPosts[0]) {
    return parseInt((post.date || '').slice(0, 4), 10);
}

function formatRelativeTime(dateStr: string) {
    const now = new Date();
    const date = new Date(dateStr + 'T00:00:00');
    const diffMs = now.getTime() - date.getTime();
    const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

    if (diffDays <= 0) return t.time.today;
    if (diffDays === 1) return t.time.yesterday;
    if (diffDays === 2) return t.time.dayBeforeYesterday;
    if (diffDays < 7) return t.time.daysAgo(diffDays);
    if (diffDays < 14) return t.time.oneWeekAgo;
    if (diffDays < 21) return t.time.weeksAgo(2);
    if (diffDays < 30) return t.time.weeksAgo(3);
    if (diffDays < 60) return t.time.oneMonthAgo;
    if (diffDays < 365) return t.time.monthsAgo(Math.floor(diffDays / 30));
    return t.time.year(date.getFullYear()) + t.time.month(date.getMonth() + 1);
}

---

<BaseLayout
    title={t.page.moments.title}
    description={t.page.moments.description}
    showHeader={false}
    showRightSidebar={false}
>
    <!-- 朋友圈封面与个人信息 -->
    <div class="relative mb-20">
        <div class="w-full h-48 sm:h-56 md:h-64 rounded-lg overflow-hidden">
            <img
                src={bannerUrl}
                alt="Cover"
                class="w-full h-full object-cover"
                loading="eager"
            />
        </div>
        <div class="absolute bottom-0 right-4 sm:right-6 translate-y-1/2">
            <div class="flex items-end gap-2">
                <div class="text-right mb-4">
                    <div class="text-white text-lg sm:text-xl font-semibold drop-shadow-md">
                        {siteConfig.title || 'Vergil'}
                    </div>
                    <div class="text-[var(--text-secondary)] text-[13px] mt-0.5 whitespace-nowrap">
                        {signature}
                    </div>
                </div>
                <img
                    src={avatarSrc}
                    alt="avatar"
                    class="w-16 h-16 sm:w-20 sm:h-20 rounded-md border-4 border-[var(--bg-main)] object-cover shadow-lg"
                    loading="eager"
                />
            </div>
        </div>
    </div>

    <!-- 动态列表 -->
    <div id="moments-feed" class="mt-12" data-page-size={PAGE_SIZE}>
        {allPosts.length === 0 && (
            <div class="text-center py-12 text-[var(--text-muted)]">
                <p>{t.page.moments.empty}</p>
            </div>
        )}
        {allPosts.map((post, index) => {
            const postYear = getPostYear(post);
            const prevYear = index > 0 ? getPostYear(allPosts[index - 1]) : null;
            const showYearDivider = postYear < currentYear && postYear !== prevYear;
            return (
                <div class:list={['moment-entry', index >= PAGE_SIZE && 'is-hidden']} data-index={index}>
                    {showYearDivider && (
                        <div class="moment-year-divider flex items-center gap-3 my-6">
                            <span class="text-2xl font-bold text-[var(--text-main)]">{postYear}</span>
                            <span class="flex-1 h-px bg-[var(--border-light)]" />
                        </div>
                    )}
                    <div class="reveal">
                        <Moment
                            name={siteConfig.title || 'Vergil'}
                            avatar={avatarSrc}
                            date={formatRelativeTime(post.date)}
                            content={post.content}
                            images={post.images}
                            forward={post.forward}
                            linkCard={post.linkCard}
                            tags={post.tags}
                        />
                    </div>
                </div>
            );
        })}
    </div>

    <!-- 加载更多 -->
    <div id="moments-load-more" class="py-6 text-center">
        <button
            id="moments-load-btn"
            class="text-sm text-[var(--text-secondary)] hover:text-[var(--accent-color)] transition-colors flex items-center gap-1.5 mx-auto"
        >
            <ChevronDown class="w-4 h-4" />
            <span>{t.common.loadMore}</span>
        </button>
        <div id="moments-no-more" class="hidden text-sm text-[var(--text-muted)]">{t.page.moments.noMore}</div>
    </div>

    <!-- 关于动态 -->
    <div class="mt-12 prose max-w-none">
        <h2 class="font-display text-xl mb-4">{t.page.moments.aboutTitle}</h2>
        <p>{t.page.moments.aboutText}</p>
    </div>

    <script is:inline>
        // 所有动态都在服务端渲染好了，这里只负责把多出来的那些显示出来。
        // 之前是用 JS 再实现一遍渲染逻辑，两份实现很快就长歪了：
        // 后面加载出来的条目没有 hover 效果、正文不走 Markdown、标签链接也没跟上改动。
        (function () {
            var feed = document.getElementById('moments-feed');
            var loadBtn = document.getElementById('moments-load-btn');
            var noMore = document.getElementById('moments-no-more');
            if (!feed || !loadBtn) return;

            var pageSize = parseInt(feed.dataset.pageSize || '5', 10);

            function remaining() {
                return feed.querySelectorAll('.moment-entry.is-hidden');
            }

            function sync() {
                var left = remaining().length;
                loadBtn.classList.toggle('hidden', left === 0);
                noMore.classList.toggle('hidden', left !== 0);
            }

            function loadMore() {
                var hidden = remaining();
                for (var i = 0; i < Math.min(pageSize, hidden.length); i++) {
                    hidden[i].classList.remove('is-hidden');
                }
                sync();
            }

            loadBtn.addEventListener('click', loadMore);
            window.addEventListener('scroll', function () {
                if (remaining().length === 0) return;
                if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 200) loadMore();
            }, { passive: true });

            sync();
        })();
    </script>

    <!-- 透传站点数据给 JS -->
    <div data-site-title={siteConfig.title || 'Vergil'} data-avatar-src={avatarSrc} class="hidden" />
</BaseLayout>

<style>
    /* 超出首屏的条目先藏起来，「加载更多」把它们放出来 */
    .moment-entry.is-hidden {
        display: none;
    }
    /* 原来条目之间没有任何分隔，一条接一条看不出边界。
       用一条淡分隔线把它们断开，比整条做成卡片轻一些。 */
    .moment-entry + .moment-entry {
        border-top: 1px solid var(--border-light);
        margin-top: 0.5rem;
        padding-top: 0.5rem;
    }
    /* 年份分隔线自带留白，上面就不用再叠一条线了 */
    .moment-entry:has(.moment-year-divider) {
        border-top: none;
    }
</style>

