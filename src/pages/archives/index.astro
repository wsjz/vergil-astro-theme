---
import { getCollection } from 'astro:content';
import { t } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionNav from '../../components/ui/SectionNav.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(sortItemsByDateDesc);

// Group posts by year
const postsByYear = posts.reduce((acc, post) => {
    const year = new Date(post.data.publishDate).getFullYear();
    if (!acc[year]) {
        acc[year] = [];
    }
    acc[year].push(post);
    return acc;
}, {} as Record<number, typeof posts>);

// Sort years in descending order
const sortedYears = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);

// Format month and day
function formatDate(date: Date): string {
    return t.time.md(date.getMonth() + 1, date.getDate());
}
---

<BaseLayout
    title={t.page.archives.title}
    description={t.page.archives.description}
    showHeader={false}
>
    <SectionNav
        items={[
            { label: t.nav.recent, href: '/blog/' },
            { label: t.nav.categories, href: '/categories/' },
            { label: t.nav.tags, href: '/tags/' },
            { label: t.nav.series, href: '/series/' },
            { label: t.nav.archives, href: '/archives/', active: true }
        ]}
    />

    <div class="space-y-4 sm:space-y-6">
        {sortedYears.map((year) => (
            <section class="reveal">
                <h2 class="mb-2 flex items-baseline gap-1.5 font-display text-base font-medium sm:text-lg">
                    <span>{year}</span>
                    <span class="text-sm font-normal text-secondary">
                        {t.page.archives.postsCount(postsByYear[year].length)}
                    </span>
                </h2>
                <div class="space-y-0.5">
                    {postsByYear[year].map((post) => {
                        const postDate = new Date(post.data.publishDate);
                        return (
                            <a
                                href={`/blog/${post.id}/`}
                                class="group flex items-baseline gap-2 py-0.5 px-1 -mx-1 rounded-md hover:bg-hover transition-colors"
                            >
                                <time class="shrink-0 text-sm text-secondary tabular-nums w-16">
                                    {formatDate(postDate)}
                                </time>
                                <span class="font-display text-base leading-snug text-main group-hover:text-accent transition-colors">
                                    {post.data.title}
                                </span>
                            </a>
                        );
                    })}
                </div>
            </section>
        ))}
    </div>

</BaseLayout>
