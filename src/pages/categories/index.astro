---
import { t } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionNav from '../../components/ui/SectionNav.astro';
import CategoryTreeNode from '../../components/widgets/CategoryTreeNode.astro';
import { buildCategoryTree, sortItemsByDateDesc } from '../../utils/data-utils';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(sortItemsByDateDesc);
const tree = buildCategoryTree(posts);
---

<BaseLayout title={t.page.categories.title} description={t.page.categories.description} showHeader={false}>
    <SectionNav
        items={[
            { label: t.nav.recent, href: '/blog/' },
            { label: t.nav.categories, href: '/categories/', active: true },
            { label: t.nav.tags, href: '/tags/' },
            { label: t.nav.series, href: '/series/' },
            { label: t.nav.archives, href: '/archives/' }
        ]}
    />

    {tree.length === 0 ? (
        <p class="text-secondary">{t.page.categories.empty}</p>
    ) : (
        <div class="reveal bg-card rounded-xl p-5 sm:p-6">
            <div class="space-y-0.5">
                {tree.map((node) => (
                    <CategoryTreeNode node={node} />
                ))}
            </div>
        </div>
    )}
</BaseLayout>
