---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionNav from '../../components/ui/SectionNav.astro';
import CategoryTreeNode from '../../components/widgets/CategoryTreeNode.astro';
import { buildCategoryTree, sortItemsByDateDesc } from '../../utils/data-utils';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(sortItemsByDateDesc);
const tree = buildCategoryTree(posts);
---

<BaseLayout title="分类" description="浏览所有文章分类" showHeader={false}>
    <SectionNav
        items={[
            { label: '近期发布', href: '/blog/' },
            { label: '分类', href: '/categories/', active: true },
            { label: '标签', href: '/tags/' },
            { label: '专栏', href: '/series/' },
            { label: '归档', href: '/archives/' }
        ]}
    />

    {tree.length === 0 ? (
        <p class="text-secondary">暂无分类</p>
    ) : (
        <div class="reveal bg-card rounded-xl p-5 sm:p-6">
            <div class="space-y-0.5">
                {tree.map((node) => (
                    <CategoryTreeNode node={node} />
                ))}
            </div>
        </div>
    )}
</BaseLayout>
