---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import { t } from '../i18n';
import Hero from '../components/content/Hero.astro';
import HeroSplash from '../components/content/HeroSplash.astro';
import Moment from '../components/content/Moment.astro';
import PostPreview from '../components/content/PostPreview.astro';
import siteConfig from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Pagination from '../components/widgets/Pagination.astro';
import { sortItemsByDateDesc } from '../utils/data-utils';
import avatar from '../assets/images/avatar.jpg';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(sortItemsByDateDesc);
const pageSize = 7;
const currentPage = 1;
const totalPosts = posts.length;
const totalPages = Math.ceil(totalPosts / pageSize);
const pagePosts = posts.slice(0, pageSize);

const page = {
    url: {
        prev: undefined,
        next: totalPages > 1 ? '/page/2' : undefined
    },
    currentPage: 1,
    lastPage: totalPages
};

/** 字段要和 src/pages/moments/index.astro 保持一致，否则首页会少渲染内容 */
interface MomentData {
    content: string;
    date: string;
    images?: string[];
    linkCard?: Record<string, string>;
    forward?: Record<string, unknown>;
    tags?: string[];
}

const momentsDir = path.join(process.cwd(), 'src', 'content', 'moments');
const avatarSrc = typeof avatar === 'string' ? avatar : avatar.src;
let latestMoment: MomentData | null = null;
if (fs.existsSync(momentsDir)) {
    const files = fs.readdirSync(momentsDir).filter(f => f.endsWith('.json'));
    const moments: MomentData[] = [];
    for (const file of files) {
        const raw = fs.readFileSync(path.join(momentsDir, file), 'utf-8');
        try { moments.push(JSON.parse(raw)); } catch { /* ignore */ }
    }
    moments.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
    latestMoment = moments[0] || null;
}
---

<BaseLayout description={siteConfig.description} splashMode={true} preloadImages={siteConfig.splash?.backgroundImage ? (Array.isArray(siteConfig.splash.backgroundImage) ? [siteConfig.splash.backgroundImage[0]] : [siteConfig.splash.backgroundImage]) : undefined}>
    <HeroSplash slot="splash" />
    <Hero {...siteConfig.hero} />
    
    <!-- Now Section -->
    <div class="mb-8 sm:mb-12">
        <a href="/moments" class="inline-block">
            <h2 class="font-sans text-xl font-medium mb-6 sm:text-2xl text-accent hover:opacity-80 transition-opacity">{t.nav.moments}</h2>
        </a>
        {latestMoment ? (
            <Moment
                href="/moments"
                name={siteConfig.title || 'Vergil'}
                avatar={avatarSrc}
                content={latestMoment.content}
                images={latestMoment.images}
                forward={latestMoment.forward as any}
                linkCard={latestMoment.linkCard as any}
                tags={latestMoment.tags}
                date={(() => {
                    const now = new Date();
                    const date = new Date(latestMoment.date);
                    const diffMs = now.getTime() - date.getTime();
                    const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
                    if (diffDays <= 0) return t.time.today;
                    if (diffDays === 1) return t.time.yesterday;
                    if (diffDays === 2) return t.time.dayBeforeYesterday;
                    if (diffDays < 7) return t.time.daysAgo(diffDays);
                    if (diffDays < 30) return t.time.oneWeekAgo;
                    if (diffDays < 60) return t.time.oneMonthAgo;
                    if (diffDays < 365) return t.time.monthsAgo(Math.floor(diffDays / 30));
                    return t.time.ym(date.getFullYear(), date.getMonth() + 1);
                })()}
            />
        ) : (
            <div class="text-sm text-[var(--text-muted)]">
                {t.page.moments.emptyLead} <code class="bg-[var(--bg-muted)] px-1.5 py-0.5 rounded text-[var(--text-secondary)]">src/content/moments/</code> {t.page.moments.emptyTail}
            </div>
        )}
    </div>
    
    {
        pagePosts?.length > 0 && (
            <div class="mb-4 sm:mb-12">
                <a href="/blog" class="inline-block">
                    <h2 class="font-sans text-xl font-medium mb-4 sm:text-2xl text-accent hover:opacity-80 transition-opacity">{t.nav.posts}</h2>
                </a>
                {pagePosts.map((post) => {
                    const hasBanner = !!post.data.banner;
                    return (
                        <div class={`reveal rounded-[24px] bg-[var(--bg-card)] p-4 mb-4 sm:mb-4 shadow-[0_1px_4px_-2px_rgba(0,0,0,0.2)] card-interactive hover:-translate-y-1 ${hasBanner ? 'hover:shadow-[0_12px_24px_-4px_rgba(0,0,0,0.28),0_6px_12px_-2px_rgba(0,0,0,0.14)]' : 'hover:shadow-[0_6px_12px_-4px_rgba(0,0,0,0.10),0_4px_8px_-2px_rgba(0,0,0,0.06)]'}`}>
                            <PostPreview post={post} headingLevel="h3" class="" />
                        </div>
                    );
                })}
                
                <Pagination page={page} class="my-16 sm:my-24" />
            </div>
        )
    }
</BaseLayout>
