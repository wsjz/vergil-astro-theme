---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import Hero from '../components/content/Hero.astro';
import HeroSplash from '../components/content/HeroSplash.astro';
import Moment from '../components/content/Moment.astro';
import PostPreview from '../components/content/PostPreview.astro';
import siteConfig from '../data/site-config';
import { ChevronRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../utils/data-utils';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(sortItemsByDateDesc);
const pageSize = 7;
const currentPage = 1;
const totalPosts = posts.length;
const totalPages = Math.ceil(totalPosts / pageSize);
const pagePosts = posts.slice(0, pageSize);

interface MomentData {
    content: string;
    date: string;
    images?: string[];
}

const momentsDir = path.join(process.cwd(), 'src', 'content', 'moments');
let latestMoment: MomentData | null = null;
if (fs.existsSync(momentsDir)) {
    const files = fs.readdirSync(momentsDir).filter(f => f.endsWith('.json'));
    const moments: MomentData[] = [];
    for (const file of files) {
        const raw = fs.readFileSync(path.join(momentsDir, file), 'utf-8');
        try { moments.push(JSON.parse(raw)); } catch { /* ignore */ }
    }
    moments.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
    latestMoment = moments[0] || null;
}
---

<BaseLayout description={siteConfig.description} splashMode={true} preloadImages={siteConfig.splash?.backgroundImage ? (Array.isArray(siteConfig.splash.backgroundImage) ? [siteConfig.splash.backgroundImage[0]] : [siteConfig.splash.backgroundImage]) : undefined}>
    <HeroSplash slot="splash" />
    <Hero {...siteConfig.hero} />
    
    <!-- Now Section -->
    <div class="mb-8 sm:mb-12">
        <a href="/moments" class="inline-block">
            <h2 class="font-sans text-xl font-medium mb-6 sm:text-2xl text-accent hover:opacity-80 transition-opacity">动态</h2>
        </a>
        {latestMoment ? (
            <Moment
                href="/moments"
                content={latestMoment.content}
                date={(() => {
                    const now = new Date();
                    const date = new Date(latestMoment.date);
                    const diffMs = now.getTime() - date.getTime();
                    const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
                    if (diffDays <= 0) return '今天';
                    if (diffDays === 1) return '昨天';
                    if (diffDays === 2) return '前天';
                    if (diffDays < 7) return diffDays + '天前';
                    if (diffDays < 30) return '1周前';
                    if (diffDays < 60) return '1个月前';
                    if (diffDays < 365) return Math.floor(diffDays / 30) + '个月前';
                    return date.getFullYear() + '年' + (date.getMonth() + 1) + '月';
                })()}
            />
        ) : (
            <div class="text-sm text-[var(--text-muted)]">
                暂无动态，在 <code class="bg-[var(--bg-muted)] px-1.5 py-0.5 rounded text-[var(--text-secondary)]">src/content/moments/</code> 目录下新建 .json 文件即可添加
            </div>
        )}
    </div>
    
    {
        pagePosts?.length > 0 && (
            <div class="mb-4 sm:mb-12">
                <a href="/blog" class="inline-block">
                    <h2 class="font-sans text-xl font-medium mb-4 sm:text-2xl text-accent hover:opacity-80 transition-opacity">文章</h2>
                </a>
                {pagePosts.map((post) => (
                    <div class="reveal">
                        <PostPreview post={post} headingLevel="h3" />
                    </div>
                ))}
                
                <!-- Pagination -->
                <nav aria-label="Pagination" class="relative px-12 py-2 text-center my-8">
                    <span class="text-sm">Page {currentPage} of {totalPages}</span>
                    {totalPages > 1 && (
                        <a 
                            href="/page/2" 
                            class="absolute top-1/2 right-0 -translate-y-1/2 inline-flex items-center justify-center w-9 h-9 rounded-full border border-light hover:border-accent/40 hover:bg-accent/5 transition-all" 
                            aria-label="Go to page 2"
                        >
                            <ChevronRight class="h-5 w-5" />
                        </a>
                    )}
                </nav>
            </div>
        )
    }
</BaseLayout>
