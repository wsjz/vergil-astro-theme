        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.05), 0 8px 32px 0 rgba(0, 0, 0, 0.3);
    }

    /* Seasons body */
    [data-album-theme="seasons"] .adetail-body {
        max-width: 48rem;
        padding: 2.5rem 2rem;
    }

    /* Note: grid glass-panel override moved to global style below */

    [data-album-theme="seasons"] .adetail-body :global(p) {
