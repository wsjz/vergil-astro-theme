---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import AlbumLayout from '../../layouts/AlbumLayout.astro';
import FormattedDate from '../../components/ui/FormattedDate.astro';
import { ChevronLeft, ChevronRight, ChevronDown, X } from '@lucide/astro';

export const getStaticPaths = (async () => {
    const albums = await getCollection('albums');
    return albums.map(album => ({
        params: { id: album.id },
        props: { album }
    }));
}) satisfies GetStaticPaths;

const { album } = Astro.props;
const { Content } = await render(album);
const { title, description, date, cover, images, tags, fonts, theme = 'golden', layout = 'grid', photoFit = 'cover', background, accent, seasonFilter = false, seasonDefault } = album.data;

const isGolden = theme === 'golden';
const isSeasons = theme === 'seasons';

// 获取当前月份用于四季自动切换
const currentMonth = new Date().getMonth() + 1;
const currentSeason = currentMonth >= 3 && currentMonth <= 5 ? 'spring' :
                       currentMonth >= 6 && currentMonth <= 8 ? 'summer' :
                       currentMonth >= 9 && currentMonth <= 11 ? 'autumn' : 'winter';
const defaultSeason = seasonDefault || currentSeason;

// 所有图片数据（用于灯箱）
const allImages = images.map((img, i) => ({
    src: typeof img.src === 'string' ? img.src : img.src.src,
    alt: img.alt || title,
    caption: img.caption || img.alt || '',
    season: img.season || null,
    index: i,
    featured: img.featured || false
}));

// 四季分类
const springImages = allImages.filter(img => img.season === 'spring');
const summerImages = allImages.filter(img => img.season === 'summer');
const autumnImages = allImages.filter(img => img.season === 'autumn');
const winterImages = allImages.filter(img => img.season === 'winter');
const hasSeasons = springImages.length > 0 || summerImages.length > 0 || autumnImages.length > 0 || winterImages.length > 0;

const coverSrc = cover ? (typeof cover === 'string' ? cover : cover.src) : null;
const coverImg = coverSrc || allImages[0]?.src || '';
const imageCount = images.length;
const yearMonth = new Date(date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' });
---

<AlbumLayout title={title} description={description} theme={theme} fonts={fonts} pageType="detail" background={background} accent={accent}>
    {/* ── Background Video: Seasons Theme ── */}
    {isSeasons ? (
        <div class="adetail-bg-video" id="adetail-bg-video">
            <video
                autoplay
                muted
                loop
                playsinline
                class="adetail-bg-video-el"
                id="season-video"
                poster={typeof cover === 'string' ? cover : coverSrc}
            >
                <source src="/videos/season-summer.mp4" type="video/mp4" />
            </video>
            <div class="adetail-bg-video-overlay"></div>
            <div class="adetail-bg-video-vignette"></div>
        </div>
    ) : null}

    <article class="adetail" data-album-theme={theme} data-photo-fit={photoFit} data-layout={layout}>
        {/* ── HERO: Golden Full-Screen Video ── */}
        {isGolden ? (
            <section class="adetail-hero reveal">
                <div class="adetail-hero-bg">
                    {/* Exact from building Hero.tsx — full-screen looping video */}
                    <video
                        autoplay
                        muted
                        loop
                        playsinline
                        class="adetail-hero-video"
                        poster={typeof cover === 'string' ? cover : coverSrc}
                    >
                        <source src="/videos/hero-golden.mp4" type="video/mp4" />
                    </video>
                    <div class="adetail-hero-overlay"></div>
                    <div class="adetail-hero-vignette"></div>
                </div>
                <div class="adetail-hero-content">
                    <span class="adetail-section-label reveal">Selected Work · 当期影集</span>
                    <h1 class="adetail-title reveal" style="--delay: 0.1s">{title}</h1>
                    {description ? <p class="adetail-desc reveal" style="--delay: 0.2s">{description}</p> : null}
                    <div class="adetail-hero-scroll reveal" style="--delay: 0.5s">
                        <span>Scroll</span>
                        <ChevronDown class="w-3.5 h-3.5" style="stroke-width: 1.5" />
                    </div>
                </div>
            </section>
        ) : null}

        {/* ── HEADER: Seasons Centered ── */}
        {isSeasons ? (
            <header class="adetail-header">
                <div class="adetail-header-inner">
                    <span class="adetail-section-label reveal">作品集 · Selected</span>
                    <h1 class="adetail-title reveal" style="--delay: 0.1s">{title}</h1>
                    {description ? <p class="adetail-desc reveal" style="--delay: 0.2s">{description}</p> : null}
                    <div class="adetail-meta reveal" style="--delay: 0.3s">
                        <span class="adetail-meta-item">
                            <span class="adetail-meta-key">Date</span>
                            <FormattedDate date={date} />
                        </span>
                        <span class="adetail-meta-divider"></span>
                        <span class="adetail-meta-item">
                            <span class="adetail-meta-key">Photos</span>
                            <span class="adetail-meta-value">{String(imageCount).padStart(2, '0')}</span>
                        </span>
                        {tags && tags.length > 0 ? (
                            <>
                                <span class="adetail-meta-divider"></span>
                                <span class="adetail-meta-item">
                                    <span class="adetail-meta-key">Tags</span>
                                    <span class="adetail-meta-value">{tags.join(' · ')}</span>
                                </span>
                            </>
                        ) : null}
                    </div>
                </div>
            </header>
        ) : null}

        {/* ── SEASONS POLAROID + TEXT ── */}
        {isSeasons && coverImg ? (
            <section class="season-about reveal">
                <div class="season-about-inner">
                    <div class="polaroid-card">
                        <div class="polaroid-img-wrap">
                            <img src={coverSrc} alt={title} loading="eager" />
                        </div>
                        <div class="polaroid-footer">
                            <span class="polaroid-label">{title}</span>
                            <span class="polaroid-date">{yearMonth}</span>
                        </div>
                    </div>
                    <div class="season-about-text">
                        <p class="season-about-desc">{description}</p>
                        <div class="season-about-stats">
                            <div class="s-stat">
                                <span class="s-stat-num">{String(imageCount).padStart(2, '0')}</span>
                                <span class="s-stat-label">Photos</span>
                            </div>
                            <div class="s-stat">
                                <span class="s-stat-num">{tags?.length || 0}</span>
                                <span class="s-stat-label">Tags</span>
                            </div>
                            <div class="s-stat">
                                <span class="s-stat-num">4</span>
                                <span class="s-stat-label">Seasons</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        ) : null}

        {/* ── STATS BAR (golden) ── */}
        {isGolden ? (
            <section class="adetail-stats reveal">
                <div class="adetail-stats-inner">
                    <div class="adetail-stat">
                        <span class="adetail-stat-num">{String(imageCount).padStart(2, '0')}</span>
                        <span class="adetail-stat-label">Photos</span>
                    </div>
                    <div class="adetail-stat-divider"></div>
                    <div class="adetail-stat">
                        <span class="adetail-stat-num">{yearMonth}</span>
                        <span class="adetail-stat-label">Date</span>
                    </div>
                    <div class="adetail-stat-divider"></div>
                    <div class="adetail-stat">
                        <span class="adetail-stat-num">{tags?.[0] || '—'}</span>
                        <span class="adetail-stat-label">Category</span>
                    </div>
                </div>
            </section>
        ) : null}

        {/* ── BODY (Markdown content with directives) ── */}
        <div class="adetail-body reveal">
            <Content />
        </div>

        {/* ── SEASON POETRY (seasons theme) ── */}
        {isSeasons ? (
            <section class="season-poetry reveal" data-season={defaultSeason}>
                <div class="season-poetry-card glass-panel">
                    <div class="season-poetry-label">
                        <div class="season-dot" id="poetry-dot"></div>
                        <span class="season-name-jp" id="poetry-name-jp">春</span>
                        <span class="season-name-en" id="poetry-name-en">Spring</span>
                    </div>
                    <div class="season-poetry-lines" id="poetry-lines">
                        {/* Lines injected by JS */}
                    </div>
                    <div class="season-poetry-deco" id="poetry-deco">春</div>
                </div>
            </section>
        ) : null}

        {/* ── SEASON FILTER NAV (for seasons theme) ── */}
        {isSeasons && hasSeasons && seasonFilter ? (
            <div class="season-nav reveal" data-default-season={defaultSeason}>
                <button class="season-btn" data-season="all" data-active="true">
                    <span class="season-label">全部</span>
                    <span class="season-count">{allImages.length}</span>
                </button>
                {springImages.length > 0 ? (
                    <button class="season-btn" data-season="spring">
                        <span class="season-label">春</span>
                        <span class="season-count">{springImages.length}</span>
                    </button>
                ) : null}
                {summerImages.length > 0 ? (
                    <button class="season-btn" data-season="summer">
                        <span class="season-label">夏</span>
                        <span class="season-count">{summerImages.length}</span>
                    </button>
                ) : null}
                {autumnImages.length > 0 ? (
                    <button class="season-btn" data-season="autumn">
                        <span class="season-label">秋</span>
                        <span class="season-count">{autumnImages.length}</span>
                    </button>
                ) : null}
                {winterImages.length > 0 ? (
                    <button class="season-btn" data-season="winter">
                        <span class="season-label">冬</span>
                        <span class="season-count">{winterImages.length}</span>
                    </button>
                ) : null}
            </div>
        ) : null}

        {/* ── GALLERY ── */}
        <div class="adetail-gallery" data-layout={layout}>
            {images.map((img, i) => {
                const num = String(i + 1).padStart(2, '0');
                const itemClass = 'adetail-g-item reveal';
                const showNumber = isGolden;
                const imgSeason = img.season || '';
                const seasonColor = imgSeason === 'spring' ? '#FFC1CC' : imgSeason === 'summer' ? '#FFD700' : imgSeason === 'autumn' ? '#FF7F50' : imgSeason === 'winter' ? '#F0F8FF' : '';

                const shutter = (
                    <div class="g-shutter-clip">
                        <div class="g-strip-clip g-strip-1" style="--s-delay: 0s"></div>
                        <div class="g-strip-clip g-strip-2" style="--s-delay: 0.08s"></div>
                        <div class="g-strip-clip g-strip-3" style="--s-delay: 0.16s"></div>
                    </div>
                );

                const exifBar = img.exif ? (
                    <div class="g-exif-bar">
                        <div class="g-exif-left">
                            {img.exif.camera ? <span class="g-exif-brand">{img.exif.camera}</span> : null}
                            {img.exif.model ? <span class="g-exif-model">{img.exif.model}</span> : null}
                        </div>
                        <div class="g-exif-right">
                            {img.exif.focal ? <span>{img.exif.focal}</span> : null}
                            {img.exif.aperture ? <span>{img.exif.aperture}</span> : null}
                            {img.exif.shutter ? <span>{img.exif.shutter}</span> : null}
                            {img.exif.iso ? <span>ISO {img.exif.iso}</span> : null}
                        </div>
                    </div>
                ) : null;

                const overlay = (
                    <div class="g-overlay">
                        <div class="g-overlay-inner">
                            {isGolden ? null : (img.alt ? <p class="g-overlay-title">{img.alt}</p> : null)}
                            {isGolden ? null : (img.caption ? <p class="g-overlay-caption">{img.caption}</p> : null)}
                            {isGolden ? null : (img.exif ? (
                                <div class="g-exif">
                                    {img.exif.camera ? <span>{img.exif.camera}</span> : null}
                                    {img.exif.focal ? <span>{img.exif.focal}</span> : null}
                                    {img.exif.aperture ? <span>{img.exif.aperture}</span> : null}
                                </div>
                            ) : null)}
                            <span class="g-arrow">
                                <ChevronRight class="w-3.5 h-3.5" style="stroke-width: 1.5" />
                            </span>
                            {isGolden && img.caption ? <p class="g-overlay-caption g-caption-golden">{img.caption}</p> : null}
                            {isGolden ? exifBar : null}
                        </div>
                    </div>
                );

                if (isGolden) {
                    return (
                        <div class={itemClass} data-lightbox-index={i} data-index={i}>
                            <figure class="g-inner">
                                <div class="g-media">
                                    <Image
                                        src={img.src}
                                        alt={img.alt || title}
                                        width={1200}
                                        class="g-img"
                                        loading={i < 4 ? 'eager' : 'lazy'}
                                    />
                                    {shutter}
                                    {overlay}
                                </div>
                                <span class="g-number">{num}</span>
                            </figure>
                            <div class="g-meta">
                                <div class="g-meta-left">
                                    <h3 class="g-meta-title">{img.alt || title}</h3>
                                    {img.caption ? <p class="g-meta-caption">{img.caption}</p> : null}
                                </div>
                                <div class="g-meta-right">
                                    <span class="g-meta-cat">{tags?.[0] || ''}</span>
                                    <span class="g-meta-arrow">
                                        <ChevronRight class="w-3.5 h-3.5" style="stroke-width: 1.5" />
                                    </span>
                                </div>
                            </div>
                        </div>
                    );
                }

                return (
                    <figure class={itemClass} data-lightbox-index={i} data-season={imgSeason} data-index={i}>
                        <div class="g-media">
                            <Image
                                src={img.src}
                                alt={img.alt || title}
                                width={1200}
                                class="g-img"
                                loading={i < 4 ? 'eager' : 'lazy'}
                            />
                            {shutter}
                        </div>
                        {isSeasons && imgSeason ? (
                            <span class="g-season-badge" style={seasonColor ? `color:${seasonColor};border-color:${seasonColor}40` : ''}>
                                {imgSeason === 'spring' ? '春' : imgSeason === 'summer' ? '夏' : imgSeason === 'autumn' ? '秋' : '冬'}
                            </span>
                        ) : null}
                        {overlay}
                    </figure>
                );
            })}
        </div>
    </article>

    {/* ── Seasonal Particles Canvas ── */}
    {isSeasons ? (
        <canvas class="season-particles" id="season-particles"></canvas>
    ) : null}

    {isSeasons ? (
        <div class="time-console" id="time-console"
            style="background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.5) 40%, transparent 100%)">
            <div class="time-console-inner">
                <div class="time-display">
                    <span class="time-value" id="time-value">12:00</span>
                    <span class="time-label" id="time-label">正午</span>
                </div>
                {/* Seasonal Poem — exact from app TimeConsole.tsx */}
                <div class="time-poem" id="time-poem">
                    <p class="time-poem-line" id="time-poem-ja">春の匂いが、風の中で踊る</p>
                    <p class="time-poem-line" id="time-poem-zh">春天的气息，在风中起舞</p>
                </div>
                <div class="time-slider-wrap">
                    <div class="time-track-labels">
                        <span>04:00</span>
                        <span>12:00</span>
                        <span>24:00</span>
                    </div>
                    <div class="time-slider-bar">
                        <div class="time-track-marks">
                            <span></span><span></span><span></span><span></span><span></span><span></span>
                        </div>
                        <input
                            type="range"
                            id="time-slider"
                            class="time-slider"
                            min="0"
                            max="1200"
                            value="720"
                            data-default-real-time="true"
                        />
                        <div class="time-slider-fill" id="time-fill"></div>
                        <div class="time-slider-thumb" id="time-thumb"></div>
                    </div>
                </div>
                {/* Season Indicator Pill — exact from app TimeConsole.tsx */}
                <div class="time-season-pill" id="time-season-pill">
                    <span class="time-season-name" id="time-season-name">春 Spring</span>
                </div>
            </div>
            <style>{`
                .time-slider::-webkit-slider-thumb {
                    -webkit-appearance: none; appearance: none;
                    width: 16px; height: 16px; border-radius: 50%;
                    background: transparent; cursor: pointer; border: none;
                }
                .time-slider::-moz-range-thumb {
                    width: 16px; height: 16px; border-radius: 50%;
                    background: transparent; cursor: pointer; border: none;
                }
            `}</style>
        </div>
    ) : null}

    {/* ── LIGHTBOX ── */}
    <div class="alb-lightbox" id="alb-lightbox" role="dialog" aria-modal="true" aria-label="图片浏览">
        <div class="alb-lightbox-backdrop"></div>
        <button class="alb-lightbox-close" aria-label="关闭">
            <X class="w-[18px] h-[18px]" style="stroke-width: 1.5" />
        </button>
        <button class="alb-lightbox-prev" aria-label="上一张">
            <ChevronLeft class="w-[18px] h-[18px]" style="stroke-width: 1.5" />
        </button>
        <button class="alb-lightbox-next" aria-label="下一张">
            <ChevronRight class="w-[18px] h-[18px]" style="stroke-width: 1.5" />
        </button>
        <div class="alb-lightbox-stage">
            <img class="alb-lightbox-img" src="" alt="" />
        </div>
        <div class="alb-lightbox-info">
            <span class="alb-lightbox-caption"></span>
            <span class="alb-lightbox-counter"></span>
        </div>
    </div>
</AlbumLayout>

<script is:inline define:vars={{ imageData: allImages, isSeasonsTheme: isSeasons, defaultSeason: defaultSeason }}>
    (function() {
        const lightbox = document.getElementById('alb-lightbox');
        if (!lightbox) return;
        const stageImg = lightbox.querySelector('.alb-lightbox-img');
        const captionEl = lightbox.querySelector('.alb-lightbox-caption');
        const counterEl = lightbox.querySelector('.alb-lightbox-counter');
        let currentIndex = 0;
        let isOpen = false;
        let touchStartX = 0;
        let isAnimating = false;

        function open(idx) {
            if (idx < 0 || idx >= imageData.length || isAnimating) return;
            isAnimating = true;
            currentIndex = idx;
            stageImg.src = imageData[idx].src;
            stageImg.alt = imageData[idx].alt || '';
            captionEl.textContent = imageData[idx].caption || imageData[idx].alt || '';
            counterEl.textContent = String(idx + 1).padStart(2, '0') + ' / ' + String(imageData.length).padStart(2, '0');
            lightbox.classList.add('is-open');
            document.body.style.overflow = 'hidden';
            isOpen = true;
            setTimeout(function() { isAnimating = false; }, 400);
        }
        function close() {
            if (!isOpen || isAnimating) return;
            isAnimating = true;
            lightbox.classList.remove('is-open');
            document.body.style.overflow = '';
            setTimeout(function() {
                isOpen = false;
                isAnimating = false;
            }, 350);
        }
        function slideTo(idx, dir) {
            if (isAnimating) return;
            isAnimating = true;
            stageImg.style.transition = 'transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease';
            stageImg.style.transform = 'translateX(' + (dir > 0 ? -40 : 40) + 'px)';
            stageImg.style.opacity = '0';
            setTimeout(function() {
                currentIndex = idx;
                stageImg.src = imageData[idx].src;
                stageImg.alt = imageData[idx].alt || '';
                captionEl.textContent = imageData[idx].caption || imageData[idx].alt || '';
                counterEl.textContent = String(idx + 1).padStart(2, '0') + ' / ' + String(imageData.length).padStart(2, '0');
                requestAnimationFrame(function() {
                    stageImg.style.transition = 'none';
                    stageImg.style.transform = 'translateX(' + (dir > 0 ? 40 : -40) + 'px)';
                    requestAnimationFrame(function() {
                        stageImg.style.transition = 'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease';
                        stageImg.style.transform = 'translateX(0)';
                        stageImg.style.opacity = '1';
                        setTimeout(function() { isAnimating = false; }, 400);
                    });
                });
            }, 280);
        }
        function prev() {
            if (currentIndex > 0 && !isAnimating) slideTo(currentIndex - 1, -1);
        }
        function next() {
            if (currentIndex < imageData.length - 1 && !isAnimating) slideTo(currentIndex + 1, 1);
        }

        document.addEventListener('click', function(e) {
            const item = e.target.closest('[data-lightbox-index]');
            if (item) { e.preventDefault(); open(parseInt(item.dataset.lightboxIndex, 10)); }
        });
        lightbox.querySelector('.alb-lightbox-close').addEventListener('click', close);
        lightbox.querySelector('.alb-lightbox-backdrop').addEventListener('click', close);
        lightbox.querySelector('.alb-lightbox-prev').addEventListener('click', prev);
        lightbox.querySelector('.alb-lightbox-next').addEventListener('click', next);
        document.addEventListener('keydown', function(e) {
            if (!isOpen) return;
            if (e.key === 'Escape') close();
            if (e.key === 'ArrowLeft') prev();
            if (e.key === 'ArrowRight') next();
        });
        lightbox.addEventListener('touchstart', function(e) { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
        lightbox.addEventListener('touchend', function(e) {
            const diff = touchStartX - e.changedTouches[0].screenX;
            if (Math.abs(diff) > 50) diff > 0 ? next() : prev();
        }, { passive: true });

        // ── Season Switcher: filter + poetry + colors ──
        const seasonNav = document.querySelector('.season-nav');
        const timeConsolePoems = {
            spring: { ja: '春の匂いが、風の中で踊る', zh: '春天的气息，在风中起舞' },
            summer: { ja: '雨上がり、庭の蝉時雨', zh: '雨后初晴，庭院蝉声如雨' },
            autumn: { ja: '落葉が語る、季節の終焉', zh: '落叶诉说着季节的终结' },
            winter: { ja: '雪景色に、心が静まる', zh: '雪景之中，心灵归于宁静' }
        };
        const seasonPoetryData = {
            spring: [
                { ja: '花びらが散るその瞬間', zh: '花瓣飘落的那个瞬间', en: 'The moment petals begin to fall' },
                { ja: '春風が記憶を運んでくる', zh: '春风携来了记忆', en: 'Spring wind carries memories afar' },
                { ja: '桜の下で、永遠を信じた', zh: '在樱花树下，我曾相信永恒', en: 'Beneath the sakura, I believed in forever' }
            ],
            summer: [
                { ja: '雨上がり、庭の蝉時雨', zh: '雨后初晴，庭院蝉声如雨', en: 'After the rain, cicadas sing like falling rain' },
                { ja: '積乱雲の向こうに何があるのだろう', zh: '积雨云的彼端会有什么', en: 'What lies beyond the towering thunderclouds' },
                { ja: '夏の終わりは、いつも急すぎる', zh: '夏天的结束，总是太过仓促', en: 'The end of summer always comes too soon' }
            ],
            autumn: [
                { ja: '落ち葉が空を舞う黄昏', zh: '落叶飞舞的黄昏', en: 'Twilight when fallen leaves dance in the sky' },
                { ja: '夕焼けは一日の告别の言葉', zh: '晚霞是一整天的告别之辞', en: "The sunset is the day's farewell speech" },
                { ja: '秋色に染まる街を歩く', zh: '漫步于染上秋色的街道', en: 'Walking through streets dyed in autumn colors' }
            ],
            winter: [
                { ja: '雪が全ての音を吸い込む', zh: '雪吞噬了所有声音', en: 'Snow swallows every sound' },
                { ja: '冬の空は、最も深い青を持つ', zh: '冬日的天空拥有最深沉的蓝', en: 'The winter sky holds the deepest blue' },
                { ja: '星が降る夜、願いを一つだけ', zh: '繁星坠落的夜晚，只许一个愿望', en: 'On a star-falling night, one wish is all I need' }
            ]
        };
        const seasonColorMap = {
            spring: '#FFC1CC', summer: '#FFD700', autumn: '#FF7F50', winter: '#F0F8FF'
        };
        const seasonNameMap = {
            spring: { jp: '春', en: 'Spring' },
            summer: { jp: '夏', en: 'Summer' },
            autumn: { jp: '秋', en: 'Autumn' },
            winter: { jp: '冬', en: 'Winter' }
        };
        const seasonColors = {
            spring: { main: '#FFC1CC', glow: 'rgba(255, 193, 204, 0.4)', glowSoft: 'rgba(255, 193, 204, 0.15)' },
            summer: { main: '#FFD700', glow: 'rgba(255, 215, 0, 0.4)', glowSoft: 'rgba(255, 215, 0, 0.15)' },
            autumn: { main: '#FF7F50', glow: 'rgba(255, 127, 80, 0.4)', glowSoft: 'rgba(255, 127, 80, 0.15)' },
            winter: { main: '#F0F8FF', glow: 'rgba(240, 248, 255, 0.4)', glowSoft: 'rgba(240, 248, 255, 0.15)' }
        };
        const seasonNames = {
            spring: '春 Spring', summer: '夏 Summer', autumn: '秋 Autumn', winter: '冬 Winter'
        };

        if (seasonNav) {
            const ds = seasonNav.dataset.defaultSeason;
            const gallery = document.querySelector('.adetail-gallery');
            const items = gallery ? gallery.querySelectorAll('.adetail-g-item') : [];

            function filterGallery(season) {
                items.forEach(function(item) {
                    if (season === 'all') {
                        item.style.display = '';
                        item.classList.add('reveal', 'visible');
                    } else {
                        const itemSeason = item.dataset.season;
                        if (itemSeason === season) {
                            item.style.display = '';
                            item.classList.add('reveal', 'visible');
                        } else {
                            item.style.display = 'none';
                            item.classList.remove('visible');
                        }
                    }
                });
            }

            function updateSeasonUI(season) {
                filterGallery(season);

                var poetryCard = document.querySelector('.season-poetry');
                if (poetryCard) {
                    var pData = seasonPoetryData[season] || seasonPoetryData.spring;
                    var pColor = seasonColorMap[season] || seasonColorMap.spring;
                    var pName = seasonNameMap[season] || seasonNameMap.spring;

                    var dot = poetryCard.querySelector('.season-dot');
                    if (dot) dot.style.backgroundColor = pColor;

                    var nameJp = poetryCard.querySelector('.season-name-jp');
                    if (nameJp) { nameJp.textContent = pName.jp; nameJp.style.color = pColor + 'CC'; }

                    var nameEn = poetryCard.querySelector('.season-name-en');
                    if (nameEn) nameEn.textContent = pName.en;

                    var deco = poetryCard.querySelector('.season-poetry-deco');
                    if (deco) { deco.textContent = pName.jp; deco.style.color = pColor + '08'; }

                    var linesEl = poetryCard.querySelector('.season-poetry-lines');
                    if (linesEl) {
                        linesEl.innerHTML = pData.map(function(line) {
                            return '<div class="poetry-line">' +
                                '<p class="poetry-ja">' + line.ja + '</p>' +
                                '<p class="poetry-zh">' + line.zh + '</p>' +
                                '<p class="poetry-en">' + line.en + '</p>' +
                            '</div>';
                        }).join('');
                    }
                }

                var tcEl = document.getElementById('time-console');
                if (tcEl) {
                    var sc = seasonColors[season] || seasonColors.spring;
                    tcEl.style.setProperty('--tc-track', sc.main);
                    tcEl.style.setProperty('--tc-thumb', sc.main);
                    tcEl.style.setProperty('--tc-glow', sc.glow);
                    tcEl.style.setProperty('--tc-glow-soft', sc.glowSoft);

                    var seasonName = document.getElementById('time-season-name');
                    var seasonPill = document.getElementById('time-season-pill');
                    var sn = seasonNames[season] || seasonNames.spring;
                    if (seasonName) seasonName.textContent = sn;
                    if (seasonPill && seasonPill.firstElementChild) {
                        seasonPill.firstElementChild.style.borderColor = sc.main + '30';
                        seasonPill.firstElementChild.style.color = sc.main + 'AA';
                    }

                    var tpJa = document.getElementById('time-poem-ja');
                    var tpZh = document.getElementById('time-poem-zh');
                    var tpoem = timeConsolePoems[season] || timeConsolePoems.spring;
                    if (tpJa) tpJa.textContent = tpoem.ja;
                    if (tpZh) tpZh.textContent = tpoem.zh;
                }

                // Background video crossfade
                var bgVideo = document.getElementById('season-video');
                if (bgVideo) {
                    var videoMap = { spring: '/videos/season-summer.mp4', summer: '/videos/season-summer.mp4', autumn: '/videos/season-autumn.mp4', winter: '/videos/season-autumn.mp4' };
                    var newSrc = videoMap[season];
                    if (newSrc && bgVideo.querySelector('source').src !== newSrc) {
                        bgVideo.style.transition = 'opacity 0.6s ease';
                        bgVideo.style.opacity = '0.3';
                        setTimeout(function() {
                            bgVideo.querySelector('source').src = newSrc;
                            bgVideo.load();
                            bgVideo.play().catch(function(){});
                            bgVideo.style.opacity = '1';
                        }, 600);
                    }
                }

                // Particles config update
                var canvas = document.getElementById('season-particles');
                if (canvas && window.__seasonParticles) {
                    window.__seasonParticles.setSeason(season);
                }
            }

            seasonNav.querySelectorAll('.season-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    seasonNav.querySelectorAll('.season-btn').forEach(function(b) { b.dataset.active = 'false'; });
                    btn.dataset.active = 'true';
                    updateSeasonUI(btn.dataset.season);
                });
            });

            if (ds) {
                var defaultBtn = seasonNav.querySelector('[data-season="' + ds + '"]');
                if (defaultBtn) {
                    defaultBtn.dataset.active = 'true';
                    updateSeasonUI(ds);
                }
            }
        }

        // ── Fallback initial state (when no season nav) ──
        if (!seasonNav && isSeasonsTheme) {
            var tcEl0 = document.getElementById('time-console');
            if (tcEl0) {
                var sc0 = seasonColors[defaultSeason] || seasonColors.spring;
                tcEl0.style.setProperty('--tc-track', sc0.main);
                tcEl0.style.setProperty('--tc-thumb', sc0.main);
                tcEl0.style.setProperty('--tc-glow', sc0.glow);
                tcEl0.style.setProperty('--tc-glow-soft', sc0.glowSoft);
                var sn0 = document.getElementById('time-season-name');
                var sp0 = document.getElementById('time-season-pill');
                if (sn0) sn0.textContent = seasonNames[defaultSeason] || seasonNames.spring;
                if (sp0 && sp0.firstElementChild) {
                    sp0.firstElementChild.style.borderColor = sc0.main + '30';
                    sp0.firstElementChild.style.color = sc0.main + 'AA';
                }
                var tpJa0 = document.getElementById('time-poem-ja');
                var tpZh0 = document.getElementById('time-poem-zh');
                var tcp0 = timeConsolePoems[defaultSeason] || timeConsolePoems.spring;
                if (tpJa0) tpJa0.textContent = tcp0.ja;
                if (tpZh0) tpZh0.textContent = tcp0.zh;
            }
        }

        // ── TimeConsole ──
        const timeSlider = document.getElementById('time-slider');
        const timeValue = document.getElementById('time-value');
        const timeFill = document.getElementById('time-fill');
        const timeThumb = document.getElementById('time-thumb');

        if (timeSlider) {
            var bgVideo = document.getElementById('season-video');

            function formatTime(v) {
                var totalMinutes = 240 + parseInt(v, 10);
                var hours = Math.floor(totalMinutes / 60);
                var mins = totalMinutes % 60;
                return (hours < 10 ? '0' : '') + hours + ':' + (mins < 10 ? '0' : '') + mins;
            }

            function getTimeLabel(v) {
                var totalMinutes = 240 + parseInt(v, 10);
                var hours = Math.floor(totalMinutes / 60);
                if (hours >= 4 && hours < 6) return '拂晓';
                if (hours >= 6 && hours < 9) return '清晨';
                if (hours >= 9 && hours < 12) return '上午';
                if (hours >= 12 && hours < 14) return '正午';
                if (hours >= 14 && hours < 17) return '午后';
                if (hours >= 17 && hours < 19) return '黄昏';
                if (hours >= 19 && hours < 21) return '傍晚';
                return '深夜';
            }

            /* Exact from app App.tsx — CSS filter based on time */
            function getTimeFilter(value) {
                var t = value / 1200;
                var brightness = 0.25 + 0.9 * Math.sin(t * Math.PI * 0.8);
                var saturate = 0.4 + 1.2 * Math.sin(t * Math.PI * 0.7);
                var hueRotate = 10 - 20 * t;
                var contrast = 0.85 + 0.3 * Math.sin(t * Math.PI);
                return 'brightness(' + brightness + ') saturate(' + saturate + ') hue-rotate(' + hueRotate + 'deg) contrast(' + contrast + ')';
            }

            function updateTime(value) {
                var pct = value / 1200;
                if (timeValue) timeValue.textContent = formatTime(value);
                var timeLabel = document.getElementById('time-label');
                if (timeLabel) timeLabel.textContent = getTimeLabel(value);
                if (timeFill) timeFill.style.width = (pct * 100) + '%';
                if (timeThumb) timeThumb.style.left = (pct * 100) + '%';
                var filterStr = getTimeFilter(value);
                /* Apply filter to background video — exact from app */
                if (bgVideo) {
                    bgVideo.style.filter = filterStr;
                    bgVideo.style.willChange = 'filter';
                }
            }

            /* Default to current real time */
            var now = new Date();
            var currentTotalMinutes = now.getHours() * 60 + now.getMinutes();
            var defaultTimeValue = Math.max(0, Math.min(1200, currentTotalMinutes - 240));
            timeSlider.value = defaultTimeValue;
            updateTime(defaultTimeValue);

            timeSlider.addEventListener('input', function(e) { updateTime(e.target.value); });
        }

        // ── Seasonal Particles ──
        if (isSeasonsTheme) {
            const canvas = document.getElementById('season-particles');
            if (canvas) {
                const ctx = canvas.getContext('2d');
                let particles = [];
                let animId = null;
                let w = 0, h = 0;

                const seasonConfig = {
                    spring: { count: 50, color: '#FFC1CC', type: 'petal' },
                    summer: { count: 30, color: '#FFD700', type: 'firefly' },
                    autumn: { count: 45, color: '#FF7F50', type: 'leaf' },
                    winter: { count: 70, color: '#F0F8FF', type: 'snow' }
                };
                const cfg = seasonConfig[defaultSeason] || seasonConfig.spring;

                function resize() {
                    w = canvas.width = window.innerWidth;
                    h = canvas.height = window.innerHeight;
                }

                function createParticles() {
                    particles = [];
                    for (var i = 0; i < cfg.count; i++) {
                        particles.push({
                            x: Math.random() * w,
                            y: Math.random() * h,
                            size: cfg.type === 'firefly' ? 1.5 + Math.random() * 2 : 2 + Math.random() * 4,
                            speedX: (Math.random() - 0.5) * (cfg.type === 'firefly' ? 1 : 0.5),
                            speedY: cfg.type === 'firefly' ? -0.3 - Math.random() * 0.7 : 0.3 + Math.random() * 0.8,
                            opacity: Math.random() * 0.6 + 0.2,
                            rotation: Math.random() * Math.PI * 2,
                            rotSpeed: (Math.random() - 0.5) * 0.02,
                            swayPhase: Math.random() * Math.PI * 2,
                            swayAmp: cfg.type === 'petal' ? 1.5 : cfg.type === 'leaf' ? 1 : 0.3
                        });
                    }
                }

                function drawParticle(p) {
                    ctx.save();
                    ctx.globalAlpha = p.opacity;
                    ctx.translate(p.x, p.y);
                    ctx.rotate(p.rotation);

                    if (cfg.type === 'petal') {
                        ctx.fillStyle = cfg.color;
                        ctx.beginPath();
                        ctx.ellipse(0, 0, p.size, p.size * 0.6, 0, 0, Math.PI * 2);
                        ctx.fill();
                    } else if (cfg.type === 'firefly') {
                        var g = ctx.createRadialGradient(0, 0, 0, 0, 0, p.size * 3);
                        g.addColorStop(0, cfg.color);
                        g.addColorStop(0.4, cfg.color + '60');
                        g.addColorStop(1, 'transparent');
                        ctx.fillStyle = g;
                        ctx.beginPath();
                        ctx.arc(0, 0, p.size * 3, 0, Math.PI * 2);
                        ctx.fill();
                    } else if (cfg.type === 'leaf') {
                        ctx.fillStyle = cfg.color;
                        ctx.beginPath();
                        ctx.moveTo(0, -p.size);
                        ctx.quadraticCurveTo(p.size * 0.6, -p.size * 0.3, p.size * 0.4, p.size * 0.4);
                        ctx.quadraticCurveTo(0, p.size, -p.size * 0.4, p.size * 0.4);
                        ctx.quadraticCurveTo(-p.size * 0.6, -p.size * 0.3, 0, -p.size);
                        ctx.fill();
                    } else {
                        ctx.fillStyle = cfg.color;
                        ctx.beginPath();
                        ctx.arc(0, 0, p.size, 0, Math.PI * 2);
                        ctx.fill();
                    }
                    ctx.restore();
                }

                function update() {
                    ctx.clearRect(0, 0, w, h);
                    particles.forEach(function(p) {
                        p.swayPhase += 0.015;
                        p.x += p.speedX + Math.sin(p.swayPhase) * p.swayAmp;
                        p.y += p.speedY;
                        p.rotation += p.rotSpeed;

                        if (cfg.type === 'firefly') {
                            p.opacity = 0.3 + Math.sin(p.swayPhase * 2) * 0.3;
                        }

                        if (p.y > h + 20) { p.y = -20; p.x = Math.random() * w; }
                        if (p.y < -20 && cfg.type === 'firefly') { p.y = h + 20; p.x = Math.random() * w; }
                        if (p.x > w + 20) p.x = -20;
                        if (p.x < -20) p.x = w + 20;

                        drawParticle(p);
                    });
                    animId = requestAnimationFrame(update);
                }

                resize();
                createParticles();
                update();

                window.addEventListener('resize', function() { resize(); createParticles(); });
            }
        }
    })();
</script>

