    .adetail-g-item {
        margin: 0;
        position: relative;
        overflow: hidden;
        cursor: zoom-in;
        background: var(--album-bg-card);
        border-radius: 2px;
    }

    .g-media {
        position: relative;
        overflow: hidden;
        height: 100%;
    }

    .g-img {
        display: block;
        width: 100%;
        height: 100%;
        margin: 0;
        transition: transform 1s cubic-bezier(0.25, 0.1, 0.25, 1), filter 0.5s ease;
    }

    /* Shutter Reveal — exact from app PortfolioGrid.tsx */
    .g-shutter-clip {
        position: absolute;
        inset: 0;
        z-index: 4;
        pointer-events: none;
    }

    .g-strip-clip {
        position: absolute;
        inset: 0;
        background: var(--album-bg);
        transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) var(--s-delay, 0s);
    }

    .g-strip-1 {
        clip-path: inset(0 0 66.6% 0);
        transform: translateY(0);
    }
    .g-strip-2 {
        clip-path: inset(33.3% 0 33.3% 0);
        transform: translateY(0);
    }
    .g-strip-3 {
        clip-path: inset(66.6% 0 0 0);
        transform: translateY(0);
    }

    .adetail-g-item.visible .g-strip-1 {
        transform: translateY(-101%);
    }
    .adetail-g-item.visible .g-strip-2 {
        transform: translateY(101%);
    }
    .adetail-g-item.visible .g-strip-3 {
        transform: translateY(-101%);
    }

    /* photo-fit modes */
    [data-photo-fit="cover"] .g-img {
        object-fit: cover;
    }
    [data-photo-fit="contain"] .g-img {
        object-fit: contain;
        background: var(--album-bg-card);
        height: auto;
        max-height: 85vh;
