    }

    /* ── Gallery ── */
    .adetail-gallery {
        padding: 0 1.5rem;
    }

    @media (min-width: 768px) {
        .adetail-gallery {
            padding: 0 4rem;
        }
    }

    @media (min-width: 1024px) {
        .adetail-gallery {
            padding: 0 6rem;
