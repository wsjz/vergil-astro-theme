    [data-photo-fit="contain"] .adetail-g-item {
        aspect-ratio: auto;
        height: auto;
    }
    [data-photo-fit="auto"] .g-img {
        object-fit: none;
        width: auto;
        max-width: 100%;
        margin: 0 auto;
    }

    .adetail-g-item:hover .g-img {
        transform: scale(1.05);
    }

    .g-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.2) 40%, transparent 70%);
