---
import { getCollection } from 'astro:content';
import DefaultLayout from '../../layouts/DefaultLayout.astro';
import CustomImage from '../../components/ui/CustomImage.astro';
import siteConfig from '../../data/site-config';

const albums = await getCollection('albums');
const sortedAlbums = albums.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const title = `Albums · ${siteConfig.title}`;
const description = 'A curated collection of visual stories. 视觉故事的策展。';
const totalCount = sortedAlbums.length;
---

<DefaultLayout title={title} description={description}>
    <!-- ── HERO ── -->
    <section class="albums-hero">
        <div class="albums-hero-inner">
            <span class="albums-hero-label reveal">Selected Works · 精选影集</span>
            <h1 class="albums-hero-title reveal" style="--delay: 0.1s">Albums</h1>
            <div class="albums-hero-line reveal" style="--delay: 0.2s"></div>
            <p class="albums-hero-desc reveal" style="--delay: 0.3s">
                视觉故事的策展。每一个影集都是一段独立的旅程，承载着不同的氛围、节奏与时间。
            </p>
        </div>
    </section>

    <!-- ── GRID ── -->
    <section class="albums-section">
        <div class="albums-section-header reveal">
            <span class="albums-section-label">Index · 目录</span>
            <div class="albums-section-line"></div>
        </div>

        <div class="albums-grid">
            {sortedAlbums.map((album, i) => {
                const { title: albumTitle, description: albumDesc, date, cover, images, tags, theme } = album.data;
                const coverSrc = cover ? (typeof cover === 'string' ? cover : cover.src) : null;
                const firstImg = images?.[0]?.src;
                const displayCover = coverSrc || (typeof firstImg === 'string' ? firstImg : firstImg?.src);
                const count = images?.length || 0;
                const num = String(i + 1).padStart(2, '0');
                const yearMonth = new Date(date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' });
                const themeLabel = theme === 'seasons' ? 'Seasons' : 'Golden';
                const itemDelay = 0.05 + i * 0.08;
                return (
                    <a href={`/albums/${album.id}/`} class="albums-item reveal" style={`--delay: ${itemDelay}s`}>
                        <div class="albums-item-media">
                            {displayCover ? (
                                <CustomImage
                                    src={cover ? (typeof cover === 'string' ? cover : cover) : images[0].src}
                                    alt={albumTitle}
                                    class="albums-item-img"
                                    width={1000}
                                    height={650}
                                />
                            ) : (
                                <div class="albums-item-placeholder">
                                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <rect width="18" height="18" x="3" y="3" rx="2"/>
                                        <circle cx="9" cy="9" r="2"/>
                                        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                                    </svg>
                                </div>
                            )}
                            <div class="albums-item-shade"></div>
                            <span class="albums-item-num">{num}</span>
                            <span class="albums-item-arrow" aria-hidden="true">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M7 7h10v10"/>
                                    <path d="M7 17 17 7"/>
                                </svg>
                            </span>
                            <div class="albums-item-overlay">
                                {albumDesc ? <p class="albums-item-overlay-desc">{albumDesc}</p> : null}
                            </div>
                        </div>
                        <div class="albums-item-info">
                            <div class="albums-item-info-top">
                                <span class="albums-item-theme">{themeLabel}</span>
                                <time class="albums-item-date">{yearMonth}</time>
                            </div>
                            <h2 class="albums-item-title">{albumTitle}</h2>
                            <div class="albums-item-meta">
                                <span class="albums-item-count">{count} 张</span>
                                {tags && tags.length > 0 ? (
                                    <span class="albums-item-tags">{tags.slice(0, 2).join(' · ')}</span>
                                ) : null}
                            </div>
                        </div>
                    </a>
                );
            })}
        </div>

        {totalCount === 0 ? (
            <div class="albums-empty">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="3" rx="2"/>
                    <circle cx="9" cy="9" r="2"/>
                    <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                </svg>
                <p>暂无影集</p>
            </div>
        ) : null}
    </section>
</DefaultLayout>

<style>
    .albums-hero {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 1rem 1.5rem 1rem;
    }

    @media (min-width: 768px) {
        .albums-hero {
            padding: 1rem 4rem 1rem;
        }
    }

    @media (min-width: 1024px) {
        .albums-hero {
            padding: 1rem 6rem 1rem;
        }
    }

    .albums-hero-inner {
        max-width: 60rem;
        margin: 0 auto;
        width: 100%;
    }

    .albums-hero-label {
        display: block;
        font-size: 0.6875rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--accent-color);
        font-weight: 500;
        margin-bottom: 1.5rem;
    }

    .albums-hero-title {
        font-size: clamp(2.5rem, 2vw, 4.5rem);
        font-weight: 200;
        line-height: 1;
        letter-spacing: -0.03em;
        color: var(--text-main);
        margin: 0;
    }

    .albums-hero-line {
        width: 100%;
        max-width: 16rem;
        height: 1px;
        margin: 2rem 0 1.5rem;
        background: linear-gradient(to right, var(--accent-color) 0%, transparent 100%);
    }

    .albums-hero-desc {
        font-size: 0.9375rem;
        line-height: 1.8;
        color: var(--text-secondary);
        max-width: 32rem;
        margin: 0 0 1rem;
    }

    .albums-hero-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .albums-hero-count {
        font-family: var(--font-mono, monospace);
        font-size: 1.5rem;
        font-weight: 200;
        color: var(--accent-color);
        font-variant-numeric: tabular-nums;
        letter-spacing: 0;
    }

    .albums-hero-divider {
        width: 2rem;
        height: 1px;
        background: var(--text-muted);
    }

    .albums-hero-text {
        font-size: 0.6875rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--text-muted);
        font-weight: 500;
    }

    .albums-hero-scroll {
        position: absolute;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.625rem;
        font-size: 0.625rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--text-muted);
        animation: albums-bounce 2.5s ease-in-out infinite;
    }

    .albums-hero-scroll svg {
        opacity: 0.6;
    }

    @keyframes albums-bounce {
        0%, 100% { transform: translate(-50%, 0); }
        50% { transform: translate(-50%, 6px); }
    }

    .albums-section {
        padding: 1rem 1.5rem 2rem;
    }

    @media (min-width: 768px) {
        .albums-section {
            padding: 1.5rem 4rem 4rem;
        }
    }

    @media (min-width: 1024px) {
        .albums-section {
            padding: 2rem 6rem 6rem;
        }
    }

    .albums-section-header {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-bottom: 3rem;
        max-width: 84rem;
        margin-left: auto;
        margin-right: auto;
    }

    .albums-section-label {
        font-size: 0.6875rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--accent-color);
        font-weight: 500;
        flex-shrink: 0;
    }

    .albums-section-line {
        flex: 1;
        height: 1px;
        background: linear-gradient(to right, var(--border-light) 0%, transparent 100%);
    }

    .albums-grid {
        max-width: 84rem;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr;
        gap: 4rem 2rem;
    }

    @media (min-width: 768px) {
        .albums-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 5rem 2.5rem;
        }
    }

    .albums-item {
        position: relative;
        display: block;
        text-decoration: none;
        color: inherit;
        cursor: pointer;
    }

    .albums-item-media {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        background: var(--bg-card);
        border-radius: var(--radius-md);
    }

    .albums-item-img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        margin: 0;
        transition: transform 0.9s cubic-bezier(0.25, 0.1, 0.25, 1), filter 0.5s ease;
    }

    .albums-item:hover .albums-item-img {
        transform: scale(1.04);
    }

    .albums-item-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        color: var(--text-muted);
    }

    .albums-item-shade {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);
        opacity: 0;
        transition: opacity 0.5s ease;
        pointer-events: none;
    }

    .albums-item:hover .albums-item-shade {
        opacity: 1;
    }

    .albums-item-num {
        position: absolute;
        top: 1.25rem;
        left: 1.25rem;
        z-index: 2;
        font-family: var(--font-mono, monospace);
        font-size: 0.6875rem;
        letter-spacing: 0.15em;
        color: var(--accent-color);
        font-weight: 500;
    }

    .albums-item-arrow {
        position: absolute;
        top: 1.25rem;
        right: 1.25rem;
        z-index: 2;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 50%;
        color: rgba(255,255,255,0.6);
        opacity: 0;
        transform: translate(8px, -8px);
        transition: opacity 0.4s ease, transform 0.4s ease, border-color 0.3s ease, color 0.3s ease;
        background: rgba(0,0,0,0.3);
        backdrop-filter: blur(4px);
    }

    .albums-item:hover .albums-item-arrow {
        opacity: 1;
        transform: translate(0, 0);
        border-color: var(--accent-color);
        color: var(--accent-color);
    }

    .albums-item-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 1.5rem;
        z-index: 2;
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.5s ease, transform 0.5s ease;
        pointer-events: none;
    }

    .albums-item:hover .albums-item-overlay {
        opacity: 1;
        transform: translateY(0);
    }

    .albums-item-overlay-desc {
        font-size: 0.8125rem;
        line-height: 1.6;
        color: rgba(255,255,255,0.85);
        max-width: 36rem;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .albums-item-info {
        padding-top: 1.25rem;
    }

    .albums-item-info-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.625rem;
    }

    .albums-item-theme {
        font-size: 0.625rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--accent-color);
        font-weight: 500;
        padding: 0.25rem 0.5rem;
        border: 1px solid var(--border-light);
    }

    .albums-item-date {
        font-size: 0.6875rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-muted);
        font-weight: 400;
    }

    .albums-item-title {
        font-family: var(--font-display, serif);
        font-size: 1.5rem;
        font-weight: 300;
        line-height: 1.2;
        letter-spacing: -0.01em;
        color: var(--text-main);
        margin: 0 0 0.625rem;
        transition: color 0.3s ease;
    }

    @media (min-width: 768px) {
        .albums-item-title {
            font-size: 1.75rem;
        }
    }

    .albums-item:hover .albums-item-title {
        color: var(--accent-color);
    }

    .albums-item-meta {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: var(--text-muted);
    }

    .albums-item-count {
        font-variant-numeric: tabular-nums;
    }

    .albums-item-tags::before {
        content: '·';
        margin-right: 0.875rem;
        opacity: 0.5;
    }

    .albums-empty {
        max-width: 84rem;
        margin: 4rem auto;
        text-align: center;
        padding: 6rem 1rem;
        color: var(--text-muted);
    }

    .albums-empty p {
        margin-top: 1rem;
        font-size: 0.875rem;
        letter-spacing: 0.05em;
    }
</style>
