---
import { Sun, Moon, Palette } from '@lucide/astro';

const schemes = [
  { id: 'A', name: '暖羊皮纸', color: '#4a7c59' },
  { id: 'B', name: '石板蓝灰', color: '#4a6fa5' },
  { id: 'C', name: '暖墨橙红', color: '#c0622a' },
  { id: 'D', name: '乳油玫瑰', color: '#c06070' },
  { id: 'E', name: '黄油琥珀', color: '#c07818' },
  { id: 'F', name: '薄荷鼠尾', color: '#2a8c62' },
  { id: 'G', name: '鸢尾紫藤', color: '#7848cc' },
  { id: 'H', name: '午夜海军', color: '#1848cc' },
  { id: 'I', name: '炭黑极简', color: '#141414' },
  { id: 'J', name: '苔藓森林', color: '#507838' },
  { id: 'K', name: '沙岩暖棕', color: '#b86030' },
];
---

<!--
  11-color scheme picker (popover) + dark mode toggle
  JS in public/theme-toggle.js handles all logic.
-->
<div class="flex items-center gap-1">
  <!-- Scheme popover trigger -->
  <div class="relative" id="scheme-popover">
    <button
      id="scheme-trigger"
      class="flex h-7 w-7 items-center justify-center rounded-full transition-all duration-200 hover:bg-card hover:shadow-sm"
      aria-label="选择配色方案"
      title="选择配色方案"
    >
      <span id="scheme-indicator-icon" class="text-accent transition-colors duration-200">
        <Palette class="h-4 w-4" />
      </span>
    </button>

    <!-- Dropdown panel -->
    <div
      id="scheme-dropdown"
      class="absolute right-0 top-full mt-2 hidden z-50"
    >
      <div class="bg-card border border-light rounded-xl shadow-lg p-3 min-w-[200px]">
        <p class="text-[11px] text-muted mb-2 px-1">配色方案</p>
        <div id="theme-scheme-picker" class="grid grid-cols-4 gap-2">
          {schemes.map((s) => (
            <button
              id={`scheme-dot-${s.id}`}
              data-scheme={s.id}
              class="flex flex-col items-center gap-1 p-1.5 rounded-lg transition-all duration-150 hover:bg-hover"
              aria-label={s.name}
              aria-pressed="false"
              title={s.name}
            >
              <span
                class="w-5 h-5 rounded-full ring-2 ring-offset-1 ring-transparent transition-all duration-200"
                style={`background-color: ${s.color};`}
              ></span>
              <span class="text-[9px] text-muted leading-none">{s.id}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Divider -->
  <div class="w-px h-3.5 bg-border-light/30"></div>

  <!-- Dark mode toggle -->
  <button
    id="dark-mode-toggle"
    class="flex h-7 w-7 cursor-pointer items-center justify-center rounded-full transition-all duration-200 hover:bg-card hover:shadow-sm text-secondary hover:text-accent"
    aria-label="切换暗色模式"
    title="切换暗色模式"
  >
    <span id="dark-mode-icon-light"><Sun class="h-4 w-4" /></span>
    <span id="dark-mode-icon-dark" class="hidden"><Moon class="h-4 w-4" /></span>
  </button>
</div>
