---
import { Sun, Moon, Palette } from '@lucide/astro';
import siteConfig from '../../data/site-config';
import { t } from '../../i18n';

const schemes = [
  { id: 'A', name: t.theme.schemes.A, color: '#4a7c59' },
  { id: 'B', name: t.theme.schemes.B, color: '#4a6fa5' },
  { id: 'C', name: t.theme.schemes.C, color: '#c0622a' },
  { id: 'D', name: t.theme.schemes.D, color: '#c06070' },
  { id: 'E', name: t.theme.schemes.E, color: '#c07818' },
  { id: 'F', name: t.theme.schemes.F, color: '#2a8c62' },
  { id: 'G', name: t.theme.schemes.G, color: '#7848cc' },
  { id: 'H', name: t.theme.schemes.H, color: '#1848cc' },
  { id: 'I', name: t.theme.schemes.I, color: '#141414' },
  { id: 'J', name: t.theme.schemes.J, color: '#507838' },
  { id: 'K', name: t.theme.schemes.K, color: '#b86030' },
];

const floatingAudioEnabled = siteConfig.floatingAudio?.enabled === true;
---

<!--
  11-color scheme picker (popover) + dark mode toggle
  JS in public/theme-toggle.js handles all logic.
-->
<div class="flex items-center gap-1">
  <!-- Scheme popover trigger -->
  <div class="relative" id="scheme-popover">
    <button
      id="scheme-trigger"
      class="flex h-7 w-7 items-center justify-center rounded-full transition-all duration-200 hover:bg-card hover:shadow-sm"
      aria-label={t.theme.pickScheme}
      title={t.theme.pickScheme}
    >
      <span id="scheme-indicator-icon" class="text-accent transition-colors duration-200">
        <Palette class="h-4 w-4" />
      </span>
    </button>

    <!-- Dropdown panel -->
    <div
      id="scheme-dropdown"
      class="absolute right-0 top-full mt-2 hidden z-50"
    >
      <div class="bg-card border border-light rounded-xl shadow-lg p-3 min-w-[200px]">
        <p class="text-[11px] text-muted mb-2 px-1">{t.theme.scheme}</p>
        <div id="theme-scheme-picker" class="grid grid-cols-4 gap-2">
          {schemes.map((s) => (
            <button
              id={`scheme-dot-${s.id}`}
              data-scheme={s.id}
              class="flex flex-col items-center gap-1 p-1.5 rounded-lg transition-all duration-150 hover:bg-hover"
              aria-label={s.name}
              aria-pressed="false"
              title={s.name}
            >
              <span
                class="w-5 h-5 rounded-full ring-2 ring-offset-1 ring-transparent transition-all duration-200"
                style={`background-color: ${s.color};`}
              ></span>
              <span class="text-[9px] text-muted leading-none">{s.id}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Divider -->
  <div class="w-px h-3.5 bg-border-light/30"></div>

  <!-- Dark mode toggle -->
  <button
    id="dark-mode-toggle"
    class="flex h-7 w-7 cursor-pointer items-center justify-center rounded-full transition-all duration-200 hover:bg-card hover:shadow-sm text-secondary hover:text-accent"
    aria-label={t.theme.toggleDark}
    title={t.theme.toggleDark}
  >
    <span id="dark-mode-icon-light"><Sun class="h-4 w-4" /></span>
    <span id="dark-mode-icon-dark" class="hidden"><Moon class="h-4 w-4" /></span>
  </button>

  {floatingAudioEnabled && (
    <>
      <div class="w-px h-3.5 bg-border-light/30"></div>
      <button
        id="fa-toggle-btn"
        class="flex h-7 w-7 cursor-pointer items-center justify-center rounded-full transition-all duration-200 hover:bg-card hover:shadow-sm text-muted opacity-50"
        aria-label={t.theme.floatingPlayer}
        title={t.theme.floatingPlayer}
      >
        <span id="fa-toggle-icon-wrap" class="relative inline-flex h-4 w-4 items-center justify-center">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
          </svg>
          <span id="fa-toggle-slash" class="absolute inset-0 flex items-center justify-center pointer-events-none">
            <span class="block w-[110%] h-[1.5px] bg-current rounded-full transform rotate-[-45deg]"></span>
          </span>
        </span>
      </button>
    </>
  )}
</div>

{floatingAudioEnabled && (
  <script is:inline>
    (function () {
      function setupFloatingAudioToggle() {
        var btn = document.getElementById('fa-toggle-btn');
        var slash = document.getElementById('fa-toggle-slash');
        if (!btn || !slash) return;

        // 避免重复绑定点击事件
        if (btn.dataset.faToggleBound) return;
        btn.dataset.faToggleBound = '1';

        btn.addEventListener('click', function () {
          document.dispatchEvent(new CustomEvent('fa-toggle'));
        });

        // Sync initial state
        var player = document.getElementById('mdFloatingAudio');
        if (player && player.getAttribute('data-state') !== 'hidden') {
          btn.classList.remove('text-muted', 'opacity-50');
          btn.classList.add('text-accent');
          slash.style.display = 'none';
        } else {
          btn.classList.remove('text-accent');
          btn.classList.add('text-muted', 'opacity-50');
          slash.style.display = 'flex';
        }
      }

      // 全局事件监听：每次触发时动态查询当前 DOM 元素，兼容 ViewTransitions
      if (!window._faToggleGlobalListeners) {
        document.addEventListener('fa-expanded', function () {
          var btn = document.getElementById('fa-toggle-btn');
          var slash = document.getElementById('fa-toggle-slash');
          if (btn) {
            btn.classList.remove('text-muted', 'opacity-50');
            btn.classList.add('text-accent');
          }
          if (slash) slash.style.display = 'none';
        });
        document.addEventListener('fa-collapsed', function () {
          var btn = document.getElementById('fa-toggle-btn');
          var slash = document.getElementById('fa-toggle-slash');
          if (btn) {
            btn.classList.remove('text-accent');
            btn.classList.add('text-muted', 'opacity-50');
          }
          if (slash) slash.style.display = 'flex';
        });
        window._faToggleGlobalListeners = true;
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupFloatingAudioToggle);
      } else {
        setupFloatingAudioToggle();
      }
      document.addEventListener('astro:page-load', setupFloatingAudioToggle);
    })();
  </script>
)}
