---
import { Home, Folder, BookOpen, Tags, Image, Clock, Sparkles, MapPin, Archive, Users, Rss, Github, Search as SearchIcon, Flag, MessageCircle, Eye, Info, Award, LayoutGrid } from '@lucide/astro';
import { getCollection } from 'astro:content';
import siteConfig from '../../data/site-config';
import CustomImage from '../ui/CustomImage.astro';
import SidebarRecentPosts from '../widgets/SidebarRecentPosts.astro';

const currentPath = Astro.url.pathname;

const posts = await getCollection('blog', ({ data }) => !data.draft);
const totalPosts = posts.length;
const totalWords = posts.reduce((sum, post) => {
  const content = post.body || '';
  return sum + content.replace(/[\s\n\r\t]/g, '').length;
}, 0);

function formatNumber(num: number): string {
  if (num >= 10000) {
    return (num / 10000).toFixed(1) + 'w';
  }
  if (num >= 1000) {
    return (num / 1000).toFixed(1) + 'k';
  }
  return num.toString();
}

function getRunningTime(): string {
  if (posts.length === 0) return '0 天';
  const sortedPosts = [...posts].sort((a, b) =>
    new Date(a.data.publishDate).getTime() - new Date(b.data.publishDate).getTime()
  );
  const firstPost = sortedPosts[0];
  const startDate = new Date(firstPost.data.publishDate);
  const now = new Date();
  const diffTime = now.getTime() - startDate.getTime();
  const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
  const years = (diffDays / 365).toFixed(2);
  return years + ' 年';
}

function getLastActive(): string {
  if (posts.length === 0) return '从未';
  const sortedPosts = [...posts].sort((a, b) =>
    new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
  );
  const lastPost = sortedPosts[0];
  const lastDate = new Date(lastPost.data.publishDate);
  const now = new Date();
  const diffTime = now.getTime() - lastDate.getTime();
  const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
  if (diffDays === 0) return '今天';
  if (diffDays === 1) return '昨天';
  return diffDays + ' 天前';
}

const iconMap: Record<string, unknown> = {
  'Home': Home,
  'Blog': BookOpen,
  'Projects': Folder,
  'Archives': Archive,
  'Tags': Tags,
  'Albums': Image,
  'Now': Clock,
};

const nameMap: Record<string, string> = {
  'Home': '首页',
  'Blog': '博客',
  'Projects': '项目',
  'Archives': '归档',
  'Tags': '标签',
  'Albums': '相册',
  'Now': '现在',
};

const navItems = [
  { key: 'Home', href: '/' },
  { key: 'Blog', href: '/blog' },
  { key: 'Archives', href: '/archives' },
  { key: 'categories', href: '/categories', icon: LayoutGrid, name: '分类' },
  { key: 'contact', href: '/contact', icon: MessageCircle, name: '留言' },
  { key: 'rss', href: '/rss.xml', icon: Rss, name: '订阅' },
];

const leftConfig = siteConfig.sidebar?.left ?? ['recentPosts', 'siteInfo'];

// Component registry for left sidebar
const leftComponents: Record<string, unknown> = {
    recentPosts: SidebarRecentPosts,
    siteInfo: null, // handled inline
};

function isActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(href);
}
---

<aside id="main-sidebar" class="sidebar flex flex-col fixed lg:sticky lg:self-start left-0 lg:left-auto top-14 h-[calc(100vh-3.5rem)] w-72 lg:w-60 xl:w-64 2xl:w-72 bg-main overflow-y-auto z-40 transition-transform duration-300">
  <div class="flex-1 p-5">
    <!-- Profile Card -->
    <div class="bg-card rounded-xl p-4 mb-3 text-center">
      <a href="/" class="inline-block mb-3 group" transition:name="brand">
        <div class="w-16 h-16 mx-auto rounded-full overflow-hidden border border-light shadow-sm transition-all duration-300 group-hover:shadow-md group-hover:scale-105">
          {siteConfig.avatar ? (
            <CustomImage
              src={siteConfig.avatar.src}
              alt={siteConfig.avatar.alt}
              class="w-full h-full object-cover"
              width={64}
              height={64}
            />
          ) : (
            <div class="w-full h-full bg-accent/10 flex items-center justify-center">
              <Sparkles class="w-7 h-7 text-accent" />
            </div>
          )}
        </div>
      </a>

      <h1 class="font-display text-base font-medium text-main mb-1">{siteConfig.title}</h1>

      {siteConfig.subtitle && (
        <p class="text-xs text-muted mb-3">{siteConfig.subtitle}</p>
      )}

      <div class="flex items-center justify-center gap-3">
        <a href="https://github.com" class="text-accent hover:opacity-70 transition-opacity" aria-label="Github">
          <Github class="w-4 h-4" />
        </a>
        <a href="/rss.xml" class="text-accent hover:opacity-70 transition-opacity" aria-label="RSS">
          <Rss class="w-4 h-4" />
        </a>
        <a href="/moments" class="text-accent hover:opacity-70 transition-opacity" aria-label="Moments">
          <Clock class="w-4 h-4" />
        </a>
        <a href="#" class="text-accent hover:opacity-70 transition-opacity" aria-label="Eye">
          <Eye class="w-4 h-4" />
        </a>
      </div>
    </div>

    <div class="bg-card rounded-xl p-3">
      <div class="flex items-center gap-1.5 mb-3">
        <Flag class="w-3.5 h-3.5 text-red-500" />
        <h3 class="text-sm font-medium text-main">站内导航</h3>
      </div>

      <nav class="grid grid-cols-3 gap-1.5">
        {navItems.map((item) => {
          const Icon = item.icon || iconMap[item.key] || Home;
          const name = item.name || nameMap[item.key] || item.key;
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class={`flex flex-col items-center justify-center py-2 px-1 rounded-lg transition-all duration-200 ${
                active
                  ? 'bg-accent/10 text-accent'
                  : 'text-secondary hover:bg-hover hover:text-accent'
              }`}
              aria-current={active ? 'page' : undefined}
            >
              <Icon class="w-4 h-4 mb-0.5" />
              <span class="text-[11px]">{name}</span>
            </a>
          );
        })}
      </nav>
    </div>

    {leftConfig.map((componentId) => {
        const Component = leftComponents[componentId];
        if (componentId === 'siteInfo') return null;
        if (!Component) return null;
        return (
            <div class="bg-card rounded-xl p-3 mt-3">
                <Component />
            </div>
        );
    })}

    {leftConfig.includes('siteInfo') && (
    <div class="bg-card rounded-xl p-3 mt-3">
      <div class="flex items-center gap-1.5 mb-2.5">
        <Info class="w-3.5 h-3.5 text-accent" />
        <h3 class="text-sm font-medium text-main">站点信息</h3>
      </div>

      <div class="space-y-1.5 text-xs">
        <div class="flex justify-between">
          <span class="text-muted">文章数目：</span>
          <span class="text-main">{totalPosts} 篇</span>
        </div>
        <div class="flex justify-between">
          <span class="text-muted">已运行时间：</span>
          <span class="text-main">{getRunningTime()}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-muted">本站总字数：</span>
          <span class="text-main">{formatNumber(totalWords)}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-muted">最后活动时间：</span>
          <span class="text-main">{getLastActive()}</span>
        </div>
          <div class="bg-card rounded-xl mt-5">
              <div class="flex items-center gap-1.5 mb-2.5">
                  <Award class="w-3.5 h-3.5 text-accent" />
                  <h3 class="text-sm font-medium text-main">备案信息</h3>
              </div>
              <div class="space-y-1 text-xs text-muted">
                  <p>皖ICP备2021008088号-2</p>
                  <p>辽公网安备21021702000331号</p>
              </div>
          </div>
      </div>
    </div>
    )}
  </div>
</aside>

<!-- Overlay -->
<div id="sidebar-overlay" class="fixed inset-0 z-[35] hidden opacity-0 transition-opacity duration-300 bg-black/20 backdrop-blur-sm"></div>

<script is:inline>
  (function() {
    var wasMobile = window.innerWidth < 1024;
    var isCollapsed = wasMobile;

    function getSidebar() {
      return document.getElementById('main-sidebar');
    }

    function applyTransform(collapsed, skipTransition) {
      var sb = getSidebar();
      if (!sb) return;
      if (skipTransition) {
        sb.style.transition = 'none';
      }
      sb.style.transform = collapsed ? 'translateX(-100vw)' : '';
      if (skipTransition) {
        void sb.offsetWidth;
        sb.style.transition = '';
      }
    }

    function setCollapsed(collapsed) {
      isCollapsed = collapsed;
      var sb = getSidebar();
      var overlay = document.getElementById('sidebar-overlay');
      var desktopToggle = document.getElementById('sidebar-desktop-toggle');
      var floatingTocBtn = document.getElementById('floating-toc-btn');
      var isMobile = window.innerWidth < 1024;

      if (collapsed) {
        sb && (sb.style.transform = 'translateX(-100vw)');
        desktopToggle?.setAttribute('aria-label', '展开侧边栏');
        overlay?.classList.add('hidden', 'opacity-0');
        floatingTocBtn?.classList.remove('hidden');
        // Unlock scroll
        document.documentElement.classList.remove('sidebar-locked');
      } else {
        sb && (sb.style.transform = '');
        desktopToggle?.setAttribute('aria-label', '收起侧边栏');
        if (isMobile) {
          overlay?.classList.remove('hidden');
          setTimeout(function() { overlay?.classList.remove('opacity-0'); }, 10);
          floatingTocBtn?.classList.add('hidden');
          // Lock scroll via CSS class on html element
          document.documentElement.classList.add('sidebar-locked');
        }
      }
    }

    function toggleSidebar() {
      setCollapsed(!isCollapsed);
    }

    function onOverlayClick() {
      setCollapsed(true);
    }

    function initSidebar() {
      var overlay = document.getElementById('sidebar-overlay');
      overlay?.removeEventListener('click', onOverlayClick);
      overlay?.addEventListener('click', onOverlayClick);
      document.removeEventListener('toggle-left-sidebar', toggleSidebar);
      document.addEventListener('toggle-left-sidebar', toggleSidebar);
    }

    applyTransform(isCollapsed, true);

    if (!window.__sidebarGlobalListeners) {
      window.__sidebarGlobalListeners = true;

      window.addEventListener('resize', function() {
        var isMobile = window.innerWidth < 1024;
        if (isMobile && !wasMobile) {
          applyTransform(true, true);
          isCollapsed = true;
        } else if (!isMobile && wasMobile) {
          applyTransform(false, true);
          isCollapsed = false;
        }
        wasMobile = isMobile;
      });

      document.addEventListener('astro:before-preparation', function() {
        if (window.innerWidth < 1024 && !isCollapsed) {
          setCollapsed(true);
        }
      });
    }

    initSidebar();
    document.addEventListener('astro:page-load', function() {
      applyTransform(isCollapsed, true);
      initSidebar();
    });
  })();
</script>

<style>
  :global(html.sidebar-locked) {
    overflow: hidden !important;
  }
  :global(html.sidebar-locked body) {
    overflow: hidden !important;
  }

  .sidebar {
    scrollbar-width: thin;
    scrollbar-color: var(--border-light) transparent;
    overscroll-behavior-y: contain;
    -webkit-overflow-scrolling: touch;
  }

  .sidebar::-webkit-scrollbar {
    width: 4px;
  }

  .sidebar::-webkit-scrollbar-track {
    background: transparent;
  }

  .sidebar::-webkit-scrollbar-thumb {
    background-color: var(--border-light);
    border-radius: 2px;
  }
</style>
