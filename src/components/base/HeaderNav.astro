---
import { Home, Database, Heart, MoreHorizontal, FolderOpen, BookOpen, FileText, Image, Lightbulb, MessageSquare, Clock, ChevronDown, Search, Menu, X } from '@lucide/astro';
import siteConfig from '../../data/site-config';

interface Props {
    articleTitle?: string;
    commentsEnabled?: boolean;
    sticky?: boolean;
}

const { articleTitle = '', commentsEnabled = false, sticky = false } = Astro.props;
const isArticlePage = articleTitle.length > 0;

const iconMap: Record<string, unknown> = {
    Home, Database, Heart, MoreHorizontal, FolderOpen, BookOpen,
    FileText, Image, Lightbulb, MessageSquare, Clock
};

const minimalEnabled = siteConfig.views?.minimal?.enabled === true;

const navItems = (siteConfig.headerNavLinks ?? []).map((item) => ({
    ...item,
    icon: iconMap[item.icon] ?? Home,
    children: item.children
        ?.filter((child) => minimalEnabled || !child.href.includes('/views/minimal/'))
        ?.map((child) => ({
            ...child,
            icon: iconMap[child.icon ?? ''] ?? FileText
        }))
}));

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
    if (href === '/') {
        return currentPath === '/';
    }
    return currentPath.startsWith(href);
}

function hasActiveChild(children?: { href: string }[]): boolean {
    if (!children) return false;
    return children.some(child => isActive(child.href));
}
---

<header class={`${sticky ? 'sticky top-0' : 'fixed top-0 left-0 right-0'} z-50`} id="top-nav-header" data-is-article={isArticlePage ? 'true' : 'false'} data-article-title={articleTitle} data-comments-enabled={commentsEnabled ? 'true' : 'false'} data-splash-mode={sticky ? 'true' : 'false'}>
    <div class="h-14 bg-white/80 dark:bg-gray-900/80 backdrop-blur-lg border-b border-white/20 dark:border-gray-700/30 relative">
        <nav class="nav-normal flex items-center justify-between h-full max-w-7xl mx-auto px-4 lg:px-6 absolute inset-0 transition-all duration-300 ease-out">
            <a href="/" class="flex items-center gap-2 text-main hover:text-accent transition-colors">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                </svg>
                <span class="font-display font-medium text-sm">我的博客</span>
            </a>

            <ul class="hidden md:flex items-center gap-1">
                {navItems.map((item) => {
                    const Icon = item.icon;
                    const isItemActive = item.href ? isActive(item.href) : hasActiveChild(item.children);
                    const hasChildren = item.children && item.children.length > 0;

                    return (
                        <li class="relative group">
                            {hasChildren ? (
                                <div class="relative">
                                    <button
                                        class={`flex items-center gap-1 px-3 py-1.5 rounded-full text-sm font-medium transition-all duration-200 ${
                                            isItemActive
                                                ? 'text-accent bg-accent/10'
                                                : 'text-secondary hover:text-accent hover:bg-accent/5'
                                        }`}
                                        aria-expanded="false"
                                        aria-haspopup="true"
                                    >
                                        <Icon class="w-4 h-4" />
                                        <span>{item.label}</span>
                                        <ChevronDown class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" />
                                    </button>

                                    <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                                        <div class="bg-white/90 dark:bg-gray-900/90 backdrop-blur-lg rounded-xl border border-white/20 dark:border-gray-700/30 shadow-xl shadow-black/10 py-2 min-w-[140px]">
                                            {item.children?.map((child) => {
                                                const ChildIcon = child.icon;
                                                const isChildActive = isActive(child.href);
                                                return (
                                                    <a
                                                        href={child.href}
                                                        class={`flex items-center gap-2 px-4 py-2 text-sm transition-colors ${
                                                            isChildActive
                                                                ? 'text-accent bg-accent/10'
                                                                : 'text-secondary hover:text-accent hover:bg-accent/5'
                                                        }`}
                                                    >
                                                        <ChildIcon class="w-3.5 h-3.5" />
                                                        <span>{child.label}</span>
                                                    </a>
                                                );
                                            })}
                                        </div>
                                    </div>
                                </div>
                            ) : (
                                <a
                                    href={item.href}
                                    class={`flex items-center gap-1 px-3 py-1.5 rounded-full text-sm font-medium transition-all duration-200 ${
                                        isItemActive
                                            ? 'text-accent bg-accent/10'
                                            : 'text-secondary hover:text-accent hover:bg-accent/5'
                                    }`}
                                >
                                    <Icon class="w-4 h-4" />
                                    <span>{item.label}</span>
                                </a>
                            )}
                        </li>
                    );
                })}
            </ul>

            <div class="flex items-center gap-2">
                <button
                    id="top-search-btn"
                    class="flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm text-secondary hover:text-accent hover:bg-accent/5 transition-all duration-200"
                    aria-label="Search"
                >
                    <Search class="w-4 h-4" />
                <span class="hidden sm:inline">搜索</span>
                    <kbd class="hidden lg:inline-flex items-center gap-1 px-1.5 py-0.5 text-[10px] bg-gray-100 dark:bg-gray-800 rounded text-muted">
                        ⌘ K
                    </kbd>
                </button>

                <button
                    id="mobile-menu-btn"
                    class="md:hidden flex items-center justify-center w-9 h-9 rounded-full text-secondary hover:text-accent hover:bg-accent/5 transition-all duration-200"
                    aria-label="Open menu"
                    aria-expanded="false"
                >
                    <Menu class="w-5 h-5 menu-icon" />
                    <X class="w-5 h-5 close-icon hidden" />
                </button>
            </div>
        </nav>

        <nav class="nav-article flex items-center h-full max-w-7xl mx-auto px-4 lg:px-6 absolute inset-0 opacity-0 translate-y-[-100%] transition-all duration-300 ease-out pointer-events-none">
            <div class="flex-1 min-w-0 px-20 text-center">
                <h1 class="nav-article-title text-sm font-medium text-main truncate">
                    {articleTitle}
                </h1>
            </div>

            <div class="absolute right-12 lg:right-16 flex items-center">
                {commentsEnabled && (
                    <button
                        id="article-comments-btn"
                        class="flex items-center justify-center w-9 h-9 rounded-full text-secondary hover:text-accent hover:bg-accent/5 transition-all duration-200"
                        aria-label="View comments"
                    >
                        <MessageSquare class="w-4 h-4" />
                    </button>
                )}
                <button
                    id="top-search-btn-article"
                    class="hidden sm:flex items-center justify-center w-9 h-9 rounded-full text-secondary hover:text-accent hover:bg-accent/5 transition-all duration-200"
                    aria-label="Search"
                >
                    <Search class="w-4 h-4" />
                </button>
                <button
                    id="mobile-menu-btn-article"
                    class="md:hidden flex items-center justify-center w-9 h-9 rounded-full text-secondary hover:text-accent hover:bg-accent/5 transition-all duration-200"
                    aria-label="Open menu"
                    aria-expanded="false"
                >
                    <Menu class="w-5 h-5 menu-icon-article" />
                    <X class="w-5 h-5 close-icon-article hidden" />
                </button>
            </div>
        </nav>
    </div>

    <div
        id="mobile-menu-panel"
        class="md:hidden fixed top-14 left-0 right-0 bg-white/95 dark:bg-gray-900/95 backdrop-blur-lg border-b border-white/20 dark:border-gray-700/30 shadow-xl shadow-black/10 p-4 opacity-0 invisible -translate-y-4 transition-all duration-300 z-50"
    >
        <ul class="space-y-1 max-w-7xl mx-auto">
            {navItems.map((item) => {
                const Icon = item.icon;
                const isItemActive = item.href ? isActive(item.href) : hasActiveChild(item.children);
                const hasChildren = item.children && item.children.length > 0;

                return (
                    <li>
                        {hasChildren ? (
                            <div class="space-y-1">
                                <div class={`flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium ${isItemActive ? 'text-accent' : 'text-main'}`}>
                                    <Icon class="w-4 h-4" />
                                    <span>{item.label}</span>
                                </div>
                                <div class="pl-4 space-y-1">
                                    {item.children?.map((child) => {
                                        const ChildIcon = child.icon;
                                        const isChildActive = isActive(child.href);
                                        return (
                                            <a
                                                href={child.href}
                                                class={`flex items-center gap-2 px-3 py-2 rounded-lg text-sm transition-colors ${
                                                    isChildActive
                                                        ? 'text-accent bg-accent/10'
                                                        : 'text-secondary hover:text-accent hover:bg-accent/5'
                                                }`}
                                            >
                                                <ChildIcon class="w-3.5 h-3.5" />
                                                <span>{child.label}</span>
                                            </a>
                                        );
                                    })}
                                </div>
                            </div>
                        ) : (
                            <a
                                href={item.href}
                                class={`flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
                                    isItemActive
                                        ? 'text-accent bg-accent/10'
                                        : 'text-secondary hover:text-accent hover:bg-accent/5'
                                }`}
                            >
                                <Icon class="w-4 h-4" />
                                <span>{item.label}</span>
                            </a>
                        )}
                    </li>
                );
            })}
        </ul>
    </div>
</header>

<script is:inline data-astro-rerun>
    (function() {
        function initNavToggle() {
            var header = document.getElementById('top-nav-header');
            if (!header) return;

            var navNormal = header.querySelector('.nav-normal');
            var navArticle = header.querySelector('.nav-article');
            if (!navNormal || !navArticle) return;

            navNormal.classList.remove('opacity-0', 'translate-y-[-100%]', 'pointer-events-none');
            navNormal.classList.add('opacity-100', 'translate-y-0');
            navArticle.classList.add('opacity-0', 'translate-y-[-100%]', 'pointer-events-none');
            navArticle.classList.remove('opacity-100', 'translate-y-0');

            if (header.dataset.isArticle !== 'true') {
                if (window._navScrollHandler) {
                    window.removeEventListener('scroll', window._navScrollHandler);
                    window._navScrollHandler = null;
                }
                return;
            }

            var isSplashMode = header.dataset.splashMode === 'true';
            var isArticleMode = false;

            function updateNav() {
                var threshold = isSplashMode ? window.innerHeight + 200 : 200;
                var shouldBe = window.scrollY > threshold;
                if (shouldBe === isArticleMode) return;
                isArticleMode = shouldBe;

                if (isArticleMode) {
                    navNormal.classList.add('opacity-0', 'translate-y-[-100%]', 'pointer-events-none');
                    navNormal.classList.remove('opacity-100', 'translate-y-0');
                    navArticle.classList.remove('opacity-0', 'translate-y-[-100%]', 'pointer-events-none');
                    navArticle.classList.add('opacity-100', 'translate-y-0');
                } else {
                    navNormal.classList.remove('opacity-0', 'translate-y-[-100%]', 'pointer-events-none');
                    navNormal.classList.add('opacity-100', 'translate-y-0');
                    navArticle.classList.add('opacity-0', 'translate-y-[-100%]', 'pointer-events-none');
                    navArticle.classList.remove('opacity-100', 'translate-y-0');
                }
            }

            if (window._navScrollHandler) {
                window.removeEventListener('scroll', window._navScrollHandler);
            }

            var ticking = false;
            var scrollHandler = function() {
                if (!ticking) {
                    window.requestAnimationFrame(function() {
                        updateNav();
                        ticking = false;
                    });
                    ticking = true;
                }
            };
            window._navScrollHandler = scrollHandler;
            window.addEventListener('scroll', scrollHandler, { passive: true });
            // 延迟判断：ViewTransitions 页面切换时 scroll position 可能还没 reset
            requestAnimationFrame(function() {
                requestAnimationFrame(updateNav);
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initNavToggle);
        } else {
            initNavToggle();
        }
        document.addEventListener('astro:page-load', initNavToggle);
    })();
</script>

<script is:inline>
    (function() {
        function initTopNavInteractions() {
            var mobileMenuBtn = document.getElementById('mobile-menu-btn');
            var mobileMenuBtnArticle = document.getElementById('mobile-menu-btn-article');
            var mobileMenuPanel = document.getElementById('mobile-menu-panel');
            var menuIcon = mobileMenuBtn?.querySelector('.menu-icon');
            var closeIcon = mobileMenuBtn?.querySelector('.close-icon');
            var menuIconArticle = mobileMenuBtnArticle?.querySelector('.menu-icon-article');
            var closeIconArticle = mobileMenuBtnArticle?.querySelector('.close-icon-article');

            if (window._topNavDocClickHandler) document.removeEventListener('click', window._topNavDocClickHandler);
            if (window._topNavKeydownHandler) document.removeEventListener('keydown', window._topNavKeydownHandler);
            if (window._topNavSearchHandler) {
                document.getElementById('top-search-btn')?.removeEventListener('click', window._topNavSearchHandler);
                document.getElementById('top-search-btn-article')?.removeEventListener('click', window._topNavSearchHandler);
            }
            if (window._topNavCommentsHandler) {
                document.getElementById('article-comments-btn')?.removeEventListener('click', window._topNavCommentsHandler);
            }
            if (window._topNavMobileMenuHandler) {
                mobileMenuBtn?.removeEventListener('click', window._topNavMobileMenuHandler);
                mobileMenuBtnArticle?.removeEventListener('click', window._topNavMobileMenuHandler);
            }

            var isMenuOpen = false;

            function toggleMobileMenu() {
                isMenuOpen = !isMenuOpen;
                if (isMenuOpen) {
                    mobileMenuPanel?.classList.remove('opacity-0', 'invisible', '-translate-y-4');
                    mobileMenuPanel?.classList.add('opacity-100', 'visible', 'translate-y-0');
                    menuIcon?.classList.add('hidden');
                    closeIcon?.classList.remove('hidden');
                    menuIconArticle?.classList.add('hidden');
                    closeIconArticle?.classList.remove('hidden');
                    mobileMenuBtn?.setAttribute('aria-expanded', 'true');
                    mobileMenuBtnArticle?.setAttribute('aria-expanded', 'true');
                } else {
                    mobileMenuPanel?.classList.add('opacity-0', 'invisible', '-translate-y-4');
                    mobileMenuPanel?.classList.remove('opacity-100', 'visible', 'translate-y-0');
                    menuIcon?.classList.remove('hidden');
                    closeIcon?.classList.add('hidden');
                    menuIconArticle?.classList.remove('hidden');
                    closeIconArticle?.classList.add('hidden');
                    mobileMenuBtn?.setAttribute('aria-expanded', 'false');
                    mobileMenuBtnArticle?.setAttribute('aria-expanded', 'false');
                }
            }

            mobileMenuBtn?.addEventListener('click', toggleMobileMenu);
            mobileMenuBtnArticle?.addEventListener('click', toggleMobileMenu);
            window._topNavMobileMenuHandler = toggleMobileMenu;

            var docClickHandler = function(e) {
                if (isMenuOpen && !mobileMenuBtn?.contains(e.target) && !mobileMenuBtnArticle?.contains(e.target) && !mobileMenuPanel?.contains(e.target)) {
                    toggleMobileMenu();
                }
            };
            document.addEventListener('click', docClickHandler);
            window._topNavDocClickHandler = docClickHandler;

            var searchHandler = function() {
                document.dispatchEvent(new CustomEvent('open-search'));
            };
            document.getElementById('top-search-btn')?.addEventListener('click', searchHandler);
            document.getElementById('top-search-btn-article')?.addEventListener('click', searchHandler);
            window._topNavSearchHandler = searchHandler;

            var keydownHandler = function(e) {
                if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                    e.preventDefault();
                    document.dispatchEvent(new CustomEvent('open-search'));
                }
            };
            document.addEventListener('keydown', keydownHandler);
            window._topNavKeydownHandler = keydownHandler;

            var commentsHandler = function() {
                var el = document.getElementById('comments');
                if (el) {
                    window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' });
                }
            };
            document.getElementById('article-comments-btn')?.addEventListener('click', commentsHandler);
            window._topNavCommentsHandler = commentsHandler;
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initTopNavInteractions);
        } else {
            initTopNavInteractions();
        }
        document.addEventListener('astro:page-load', initTopNavInteractions);
    })();
</script>

<style>
    .group:hover .group-hover\:rotate-180 {
        transform: rotate(180deg);
    }
</style>
