---
import siteConfig from '../../data/site-config';

const currentYear = new Date().getFullYear();
const footerLinks = siteConfig.footerNavLinks || [];
---

<footer class="mx-auto w-full max-w-3xl pt-12 pb-8 sm:pt-16 sm:pb-10">
    {
        footerLinks.length > 0 && (
            <nav class="flex justify-center items-center flex-wrap gap-x-6 gap-y-3 mb-6" aria-label="Footer navigation">
                {footerLinks.map((link) => {
                    const isExternal = link.href?.startsWith('http://') || link.href?.startsWith('https://');
                    return (
                        <a
                            class="group flex items-center gap-1.5 text-sm text-secondary hover:text-accent transition-colors"
                            href={link.href}
                            {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                        >
                            <span>{link.text}</span>
                        </a>
                    );
                })}
            </nav>
        )
    }

    <p class="text-center text-xs text-muted">
        &copy; {currentYear}
        <a class="hover:text-accent transition-colors" href="/">{siteConfig.title}</a>
    </p>
</footer>
