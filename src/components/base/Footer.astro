---
import siteConfig from '../../data/site-config';

const socialLinks = siteConfig.socialLinks ?? [];
const navLinks = siteConfig.footerNavLinks ?? [];
const currentYear = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-3xl pt-16 pb-10 sm:pt-24 sm:pb-14">
    {
        navLinks.length > 0 && (
            <nav class="mb-6 flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer navigation">
                {navLinks.map((link) => (
                    <a class="text-sm text-secondary hover:text-accent transition-colors" href={link.href}>
                        {link.text}
                    </a>
                ))}
            </nav>
        )
    }
    <div
        class:list={[
            'flex flex-col gap-4 border-t border-light pt-6',
            { 'sm:flex-row-reverse sm:items-center sm:justify-between': socialLinks.length > 0 }
        ]}
    >
        {
            socialLinks.length > 0 && (
                <div class="flex flex-wrap gap-x-4 gap-y-2">
                    {socialLinks.map((link) => (
                        <a
                            class="text-sm text-secondary hover:text-accent transition-colors"
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferer"
                        >
                            {link.text}
                        </a>
                    ))}
                </div>
            )
        }
        <p class="text-sm text-muted">
            &copy; {currentYear}
            <a class="hover:text-accent transition-colors" href="/">{siteConfig.title}</a>. All rights reserved.
        </p>
    </div>
</footer>
