---
import type { CollectionEntry } from 'astro:content';
import CustomImage from '../ui/CustomImage.astro';

interface Props {
    album: CollectionEntry<'albums'>;
}

const { album } = Astro.props;
const { title, description, date, cover, images, tags } = album.data;
const imageCount = images?.length || 0;
---

<a href={`/albums/${album.id}/`} class="group block overflow-hidden rounded-lg border border-dashed border-main transition-colors hover:border-current">
    <div class="aspect-[4/3] overflow-hidden bg-secondary">
        {cover ? (
            <CustomImage
                src={cover}
                alt={title}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                width={600}
                height={450}
            />
        ) : images?.[0] ? (
            <CustomImage
                src={images[0].src}
                alt={images[0].alt || title}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                width={600}
                height={450}
            />
        ) : (
            <div class="flex h-full items-center justify-center text-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                    <circle cx="9" cy="9" r="2"/>
                    <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                </svg>
            </div>
        )}
    </div>
    
    <div class="p-4">
        <h3 class="font-display text-lg font-medium">{title}</h3>
        {description && <p class="mt-1 line-clamp-2 text-sm text-secondary">{description}</p>}
        
        <div class="mt-3 flex items-center gap-3 text-xs text-secondary">
            <time>{new Date(date).toLocaleDateString()}</time>
            <span>{imageCount} photos</span>
            {tags && tags.length > 0 && (
                <span class="rounded-full bg-secondary px-2 py-0.5">{tags[0]}</span>
            )}
        </div>
    </div>
</a>