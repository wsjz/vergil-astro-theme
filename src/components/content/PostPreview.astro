---
import { type CollectionEntry } from 'astro:content';
import { Calendar, Clock } from '@lucide/astro';
import FormattedDate from '../ui/FormattedDate.astro';
import { slugify } from '../../utils/common-utils';

type Props = { post: CollectionEntry<'blog'>; class?: string; headingLevel?: 'h2' | 'h3' };

const { post, class: className, headingLevel = 'h2' } = Astro.props;
const { title, publishDate, updatedDate, excerpt, tags, banner } = post.data;
const TitleTag = headingLevel;

function calculateReadingTime(content: string): number {
    const chineseChars = (content.match(/[\u4e00-\u9fa5]/g) || []).length;
    const englishWords = (content.match(/[a-zA-Z]+/g) || []).length;
    const total = chineseChars + englishWords;
    return Math.ceil(total / 300) || 1;
}

const readingTime = calculateReadingTime(post.body || '');
const hasBanner = !!banner;
---

<div class:list={['', className]}>
    {hasBanner ? (
        <a href={`/blog/${post.id}/`} class="block relative -m-4 overflow-hidden rounded-[20px] group">
            <img
                src={banner}
                alt={title}
                class="w-full aspect-[2.35/1] object-cover"
                loading="lazy"
            />
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-200"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
            <div class="absolute inset-0 flex flex-col justify-end p-4 sm:p-5">
                <TitleTag class="font-display text-lg sm:text-xl font-medium text-white drop-shadow line-clamp-2">
                    {title}
                </TitleTag>
                {excerpt && (
                    <p class="mt-1 text-sm text-white/80 line-clamp-2">{excerpt}</p>
                )}
                {tags && tags.length > 0 && (
                    <div class="flex items-center gap-1 text-sm mt-1.5">
                        {tags.map((tag, index) => (
                            <span>
                                {index > 0 && <span class="text-white/50">, </span>}
                                <span class="text-white/70">#{tag}</span>
                            </span>
                        ))}
                    </div>
                )}
            </div>
        </a>
    ) : (
        <a href={`/blog/${post.id}/`} class="block mb-2">
            <TitleTag class="font-display text-lg font-medium text-main hover:text-accent transition-colors line-clamp-2">
                {title}
            </TitleTag>
        </a>
    )}

    {!hasBanner && (
        <>
            {excerpt && (
                <a href={`/blog/${post.id}/`} class="text-[15px] text-secondary leading-relaxed line-clamp-3 hover:text-accent transition-colors mb-3">
                    {excerpt}
                </a>
            )}
            <div class="flex items-center gap-3 text-sm text-secondary">
                <span class="flex items-center gap-1">
                    <Calendar class="w-4 h-4" />
                    <FormattedDate date={publishDate} />
                </span>
                {updatedDate && (
                    <span class="text-muted">更新于 <FormattedDate date={updatedDate} /></span>
                )}
                <span class="flex items-center gap-1">
                    <Clock class="w-4 h-4" />
                    {readingTime} min
                </span>
            </div>
            {tags && tags.length > 0 && (
                <div class="flex items-center gap-1 text-sm mt-2">
                    {tags.map((tag, index) => (
                        <span>
                            {index > 0 && <span class="text-secondary">, </span>}
                            <a
                                href={`/tags/${slugify(tag)}`}
                                class="text-accent hover:underline"
                                onclick="event.stopPropagation();"
                            >
                                #{tag}
                            </a>
                        </span>
                    ))}
                </div>
            )}
        </>
    )}
</div>
