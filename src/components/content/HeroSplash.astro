---
import { ChevronDown, ChevronRight, Github, Link, User, TrainFront } from '@lucide/astro';
import siteConfig from '../../data/site-config';
import '../../styles/components/splash.css';

interface Props {
    title?: string;
    subtitle?: string;
    description?: string;
    backgroundImage?: string | string[];
    overlay?: string;
    textShadow?: boolean;
    fallbackBg?: string;
    gradientColor?: string;
    gradientHeight?: string;
    backdropBlur?: string;
    slideDuration?: number;
    buttonText?: string;
    snapScroll?: boolean;
}

const {
    title = siteConfig.splash?.title || siteConfig.title,
    subtitle = siteConfig.splash?.subtitle,
    description = siteConfig.splash?.description || siteConfig.subtitle,
    backgroundImage = siteConfig.splash?.backgroundImage,
    overlay = siteConfig.splash?.overlay,
    textShadow = siteConfig.splash?.textShadow ?? false,
    fallbackBg = siteConfig.splash?.fallbackBg,
    gradientColor = siteConfig.splash?.gradientColor,
    gradientHeight = siteConfig.splash?.gradientHeight,
    backdropBlur = siteConfig.splash?.backdropBlur,
    slideDuration = siteConfig.splash?.slideDuration,
    buttonText,
    snapScroll = false
} = Astro.props;

const images = backgroundImage
    ? (Array.isArray(backgroundImage) ? backgroundImage : [backgroundImage])
    : [];
const hasBg = images.length > 0;
const multi = images.length > 1;

const textClass = hasBg ? 'text-white' : 'text-main';
const subTextClass = hasBg ? 'text-white/80' : 'text-secondary';
const shadowClass = textShadow && hasBg ? '[text-shadow:0_2px_8px_rgba(0,0,0,0.5)]' : '';
const subShadowClass = textShadow && hasBg ? '[text-shadow:0_1px_4px_rgba(0,0,0,0.4)]' : '';

// Resolve configurable values with defaults
const resolvedFallbackBg = fallbackBg || (hasBg ? 'bg-black' : 'bg-main');
const resolvedGradientColor = gradientColor || 'var(--bg-main, #f8fafc)';
const resolvedGradientHeight = gradientHeight || 'h-56';
const resolvedBackdropBlur = backdropBlur || '12px';
const resolvedSlideDuration = slideDuration || 18;

function bgStyle(url: string) {
    return `background-image: url('${url}');`;
}

const cssVars = [
    `--splash-gradient-color: ${resolvedGradientColor};`,
    `--splash-backdrop-blur: ${resolvedBackdropBlur};`,
    `--slide-duration: ${resolvedSlideDuration}s;`,
    `--slide-count: ${images.length};`
].join(' ');

// Use nav from siteConfig only when no custom buttonText is provided
const navItems = buttonText ? [] : (siteConfig.splash?.nav || []);
const hasActions = !!buttonText || navItems.length > 0;
---

<!-- Splash Overlay -->
<div
    id="hero-splash"
    class={`fixed inset-0 z-[100] flex flex-col items-center justify-center ${resolvedFallbackBg}`}
    style={cssVars}
    data-snap-scroll={snapScroll ? 'true' : undefined}
>
    {images.map((url, i) => (
        <div
            class={multi
                ? `absolute inset-0 bg-cover bg-center bg-no-repeat splash-bg-${i}`
                : 'absolute inset-0 bg-cover bg-center bg-no-repeat'}
            style={bgStyle(url)}
        />
    ))}

    {hasBg && overlay && (
        <div
            id="splash-overlay"
            class="absolute inset-0"
            style={`background: ${overlay};`}
        />
    )}
    {hasBg && (
        <div class={`splash-gradient ${resolvedGradientHeight}`} />
    )}
    <div class="relative z-10 text-center px-4 max-w-2xl">
        {subtitle && (
            <p class={`text-xs sm:text-sm font-medium tracking-[0.2em] uppercase mb-3 ${subTextClass} ${subShadowClass}`}>
                {subtitle}
            </p>
        )}
        <h1 class={`text-4xl sm:text-6xl md:text-7xl font-sans font-bold mb-5 tracking-tight leading-[1.1] ${textClass} ${shadowClass}`}>
            {title}
        </h1>
        {description && (
            <p
                id="splash-description"
                class={`text-base sm:text-lg md:text-xl font-light mb-10 min-h-[1.5em] tracking-wide ${subTextClass} ${subShadowClass}`}
                data-text={description}
            >
                <span class="typewriter-text"></span><span class="typewriter-cursor">|</span>
            </p>
        )}

        {buttonText && (
            <button
                id="splash-action-btn"
                type="button"
                class="inline-flex items-center justify-center px-8 py-3 sm:px-10 sm:py-3.5 rounded-full text-sm font-medium
                       bg-white/90 dark:bg-gray-900/90 text-main dark:text-white
                       hover:bg-white dark:hover:bg-gray-800
                       backdrop-blur-md shadow-lg hover:shadow-xl
                       transition-all duration-300 hover:-translate-y-0.5
                       border border-white/20 dark:border-gray-700/30
                       cursor-pointer"
            >
                {buttonText}
                <ChevronRight class="ml-2 w-4 h-4" />
            </button>
        )}

        {!buttonText && navItems.length > 0 && (
            <div class="inline-flex items-center gap-1 p-1.5 rounded-full bg-white/80 dark:bg-gray-900/80 backdrop-blur-md shadow-lg">
                {navItems.map((item) => (
                    <a
                        href={item.href}
                        class="flex flex-col items-center justify-center px-4 py-2 sm:px-5 sm:py-2.5 rounded-full text-main hover:bg-white/50 dark:hover:bg-gray-800/50 transition-all duration-200 group"
                    >
                        {item.icon && (
                            <span class="text-xl sm:text-2xl mb-1 group-hover:scale-110 transition-transform">
                                {item.icon === 'github' && <Github class="w-5 h-5 sm:w-6 sm:h-6" />}
                                {item.icon === 'link' && <Link class="w-5 h-5 sm:w-6 sm:h-6" />}
                                {item.icon === 'user' && <User class="w-5 h-5 sm:w-6 sm:h-6" />}
                                {item.icon === 'train' && <TrainFront class="w-5 h-5 sm:w-6 sm:h-6" />}
                            </span>
                        )}
                        <span class="text-xs sm:text-sm font-medium">{item.text}</span>
                    </a>
                ))}
            </div>
        )}
    </div>

    <button
        id="splash-arrow"
        class={`absolute bottom-12 left-1/2 -translate-x-1/2 p-2 transition-colors duration-300 cursor-pointer group z-10 ${hasBg ? 'text-white/70 hover:text-white' : 'text-secondary hover:text-accent'}`}
        aria-label="Scroll down"
    >
        <ChevronDown class="w-8 h-8 animate-bounce-arrow" style="stroke-width: 2.5" />
    </button>
</div>

<style>
    @keyframes bounce-arrow {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(8px); }
    }

    .animate-bounce-arrow {
        animation: bounce-arrow 1.5s ease-in-out infinite;
    }

    /* Typewriter cursor */
    .typewriter-cursor {
        display: inline-block;
        font-weight: 300;
        margin-left: 1px;
        animation: cursor-blink 0.9s step-end infinite;
        color: inherit;
    }

    .typewriter-cursor.done {
        animation: cursor-fadeout 0.5s ease forwards;
    }

    @keyframes cursor-blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }

    @keyframes cursor-fadeout {
        to { opacity: 0; }
    }

    /* Multi-image crossfade */
    .splash-bg-0,
    .splash-bg-1,
    .splash-bg-2,
    .splash-bg-3,
    .splash-bg-4 {
        opacity: 0;
        animation: crossfade var(--slide-duration, 18s) infinite;
    }

    .splash-bg-0 { animation-delay: 0s; }
    .splash-bg-1 { animation-delay: calc(var(--slide-duration, 18s) / var(--slide-count, 3) * 1); }
    .splash-bg-2 { animation-delay: calc(var(--slide-duration, 18s) / var(--slide-count, 3) * 2); }
    .splash-bg-3 { animation-delay: calc(var(--slide-duration, 18s) / var(--slide-count, 3) * 3); }
    .splash-bg-4 { animation-delay: calc(var(--slide-duration, 18s) / var(--slide-count, 3) * 4); }

    @keyframes crossfade {
        0%   { opacity: 0.01; transform: scale(1.05); }
        8%   { opacity: 1; transform: scale(1); }
        28%  { opacity: 1; transform: scale(1); }
        36%  { opacity: 0.01; transform: scale(1.02); }
        100% { opacity: 0.01; transform: scale(1.05); }
    }
</style>

<script>
    let _splashAC: AbortController | null = null;
    let _typewriterTimer: ReturnType<typeof setTimeout> | null = null;
    let _typewriterActive = false;

    function runTypewriter() {
        const descEl = document.getElementById('splash-description');
        if (!descEl) return;

        const text = descEl.dataset.text || '';
        const textSpan = descEl.querySelector('.typewriter-text') as HTMLSpanElement | null;
        const cursor = descEl.querySelector('.typewriter-cursor') as HTMLSpanElement | null;
        if (!textSpan || !cursor) return;

        if (_typewriterTimer) {
            clearTimeout(_typewriterTimer);
            _typewriterTimer = null;
        }
        _typewriterActive = true;

        let i = 0;
        let isDeleting = false;
        const typeSpeed = 80;
        const deleteSpeed = 40;
        const pauseAfterType = 2400;
        const pauseAfterDelete = 400;

        function tick() {
            if (!_typewriterActive) return;

            if (!isDeleting) {
                if (i < text.length) {
                    textSpan.textContent += text.charAt(i);
                    i++;
                    const jitter = Math.floor(Math.random() * 40) - 15;
                    _typewriterTimer = setTimeout(tick, Math.max(30, typeSpeed + jitter));
                } else {
                    cursor.classList.remove('done');
                    _typewriterTimer = setTimeout(() => {
                        isDeleting = true;
                        tick();
                    }, pauseAfterType);
                }
            } else {
                if (i > 0) {
                    i--;
                    textSpan.textContent = text.substring(0, i);
                    const jitter = Math.floor(Math.random() * 20) - 8;
                    _typewriterTimer = setTimeout(tick, Math.max(15, deleteSpeed + jitter));
                } else {
                    textSpan.textContent = '';
                    cursor.classList.remove('done');
                    _typewriterTimer = setTimeout(() => {
                        isDeleting = false;
                        tick();
                    }, pauseAfterDelete);
                }
            }
        }

        textSpan.textContent = '';
        cursor.classList.remove('done');
        _typewriterTimer = setTimeout(tick, 400);
    }

    function initSplash() {
        _splashAC?.abort();
        _splashAC = new AbortController();
        const signal = _splashAC.signal;

        const splash = document.getElementById('hero-splash');
        const arrow = document.getElementById('splash-arrow');
        const topNav = document.getElementById('top-nav-header');
        const overlay = document.getElementById('splash-overlay');

        if (!splash || !arrow) return;

        const viewportHeight = window.innerHeight;
        const snapScroll = splash.dataset.snapScroll === 'true';
        let ticking = false;
        let isSnapping = false;

        function updateOnScroll() {
            const scrollY = window.scrollY;
            splash!.style.transform = `translateY(${-scrollY}px)`;

            if (overlay) {
                const opacity = Math.max(0, 1 - scrollY / (viewportHeight * 0.8));
                overlay.style.opacity = String(opacity);
            }

            if (topNav) {
                const navOpacity = Math.min(1, Math.max(0, (scrollY - viewportHeight * 0.3) / (viewportHeight * 0.5)));
                topNav.style.opacity = String(navOpacity);
            }

            if (snapScroll) {
                if (scrollY >= viewportHeight) {
                    splash!.style.pointerEvents = 'none';
                } else {
                    splash!.style.pointerEvents = '';
                }
            }
        }

        function scrollToContent() {
            if (snapScroll) {
                snapTo(viewportHeight);
            } else {
                window.scrollTo({ top: viewportHeight, behavior: 'smooth' });
            }
        }

        function snapTo(target: number) {
            if (isSnapping) return;
            isSnapping = true;
            window.scrollTo({ top: target, behavior: 'smooth' });
            setTimeout(() => { isSnapping = false; }, 800);
        }

        window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
        splash.style.transform = 'translateY(0)';
        if (overlay) overlay.style.opacity = '1';
        if (topNav) topNav.style.opacity = '0';
        updateOnScroll();

        // Start typewriter effect on description
        runTypewriter();

        window.addEventListener('scroll', () => {
            if (!ticking) {
                window.requestAnimationFrame(() => {
                    updateOnScroll();
                    ticking = false;
                });
                ticking = true;
            }
        }, { passive: true, signal });

        arrow.addEventListener('click', scrollToContent, { signal });

        const actionBtn = document.getElementById('splash-action-btn');
        if (actionBtn) {
            actionBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                scrollToContent();
            }, { signal });
        }

        splash.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            if (target.closest('a, button, input, textarea, select')) return;
            scrollToContent();
        }, { signal });

        if (snapScroll) {
            // Snap scroll: Enter/Space to enter, wheel/touch snap
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    scrollToContent();
                }
            }, { signal });

            window.addEventListener('wheel', (e) => {
                if (window.scrollY < viewportHeight && !isSnapping) {
                    if (e.deltaY > 5) {
                        e.preventDefault();
                        snapTo(viewportHeight);
                    } else if (e.deltaY < -5 && window.scrollY > 0) {
                        e.preventDefault();
                        snapTo(0);
                    }
                }
            }, { passive: false, signal });

            let touchStartY = 0;
            window.addEventListener('touchstart', (e) => {
                touchStartY = e.touches[0].clientY;
            }, { passive: true, signal });

            window.addEventListener('touchend', (e) => {
                if (window.scrollY < viewportHeight) {
                    const deltaY = touchStartY - e.changedTouches[0].clientY;
                    if (deltaY > 30) snapTo(viewportHeight);
                    else if (deltaY < -30) snapTo(0);
                    else scrollToContent();
                }
            }, { passive: true, signal });
        } else {
            // Normal scroll: Escape to scroll down
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') scrollToContent();
            }, { signal });
        }
    }

    document.addEventListener('astro:page-load', () => {
        const splash = document.getElementById('hero-splash');
        if (splash) {
            initSplash();
        } else {
            _splashAC?.abort();
            _splashAC = null;
            _typewriterActive = false;
            if (_typewriterTimer) {
                clearTimeout(_typewriterTimer);
                _typewriterTimer = null;
            }
        }
    });

    document.addEventListener('astro:before-swap', () => {
        const splash = document.getElementById('hero-splash');
        const topNav = document.getElementById('top-nav-header');
        if (splash) splash.style.transform = '';
        if (topNav) topNav.style.opacity = '';
        _typewriterActive = false;
        if (_typewriterTimer) {
            clearTimeout(_typewriterTimer);
            _typewriterTimer = null;
        }
    });
</script>
