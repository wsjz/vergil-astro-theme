---
import { type CollectionEntry } from 'astro:content';
import { ChevronRight } from '@lucide/astro';

type Props = { project: CollectionEntry<'projects'>; class?: string; headingLevel?: 'h2' | 'h3' };

const { project, class: className, headingLevel = 'h2' } = Astro.props;
const { title, description } = project.data;
const TitleTag = headingLevel;
---

<a class:list={['group block border-light last:border-0', className]} href={`/projects/${project.id}/`}>
    <div class="flex items-start justify-between gap-4">
        <div class="flex-1 min-w-0">
            <TitleTag class="font-display text-xl font-medium text-main group-hover:text-accent transition-colors line-clamp-2 mb-2">
                {title}
            </TitleTag>
            {description && <div class="text-sm text-secondary line-clamp-2">{description}</div>}
        </div>
        <div class="hidden sm:flex items-center gap-1 text-accent opacity-0 group-hover:opacity-100 transition-opacity">
            <span class="text-sm">View</span>
            <ChevronRight class="w-4 h-4" />
        </div>
    </div>
</a>
