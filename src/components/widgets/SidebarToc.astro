---
interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    headings: Heading[];
}

const { headings } = Astro.props;
if (!headings || headings.length === 0) {
    return;
}
const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 4);
---

<aside class="toc-sidebar h-full overflow-y-auto">
    <div class="p-4">
        {tocHeadings.length > 0 && (
            <div class="mb-6">
                <h3 class="text-xs font-medium text-muted uppercase tracking-wider mb-3">文章目录</h3>
                <nav class="border-l border-muted space-y-1">
                    {tocHeadings.map((heading) => {
                        const indentClass = heading.depth === 4 ? 'pl-7' : heading.depth === 3 ? 'pl-5' : 'pl-3';
                        const colorClass = heading.depth === 2 ? 'text-secondary font-medium' : 'text-muted';
                        return (
                            <a
                                href={`#${heading.slug}`}
                                class={`toc-sidebar-link block text-xs transition-all duration-200 hover:text-accent -ml-px border-l-2 border-transparent py-0.5 ${indentClass} ${colorClass}`}
                            >
                                {heading.text}
                            </a>
                        );
                    })}
                </nav>
            </div>
        )}

    </div>
</aside>

<script>
    function initTocHighlight() {
        const headings = document.querySelectorAll('h2[id], h3[id], h4[id]');
        const tocLinks = document.querySelectorAll('.toc-sidebar a[href^="#"]');
        if (headings.length === 0 || tocLinks.length === 0) return;

        let isClickScrolling = false;
        let clickTimeout: ReturnType<typeof setTimeout> | null = null;

        tocLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                isClickScrolling = true;
                const href = link.getAttribute('href');
                if (href) {
                    const id = href.slice(1);
                    const target = document.getElementById(id);
                    if (target) {
                        const topNavHeight = 80;
                        const targetPosition = target.getBoundingClientRect().top + window.scrollY - topNavHeight;
                        window.scrollTo({ top: targetPosition, behavior: 'smooth' });
                        history.pushState(null, '', href);
                    }
                    tocLinks.forEach(l => l.classList.remove('toc-active'));
                    link.classList.add('toc-active');
                }
                if (clickTimeout) clearTimeout(clickTimeout);
                clickTimeout = setTimeout(() => {
                    isClickScrolling = false;
                }, 1500);
            });
        });

        const observer = new IntersectionObserver((entries) => {
            if (isClickScrolling) return;
            let topEntry: IntersectionObserverEntry | null = null;
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    if (!topEntry || entry.boundingClientRect.top < topEntry.boundingClientRect.top) {
                        topEntry = entry;
                    }
                }
            });
            if (topEntry) {
                const id = topEntry.target.getAttribute('id');
                tocLinks.forEach(l => l.classList.remove('toc-active'));
                const activeLink = document.querySelector(`.toc-sidebar a[href="#${id}"]`);
                if (activeLink) {
                    activeLink.classList.add('toc-active');
                }
            }
        }, {
            rootMargin: '-100px 0px -70% 0px',
            threshold: 0
        });

        headings.forEach(heading => observer.observe(heading));
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTocHighlight);
    } else {
        initTocHighlight();
    }

    document.addEventListener('astro:page-load', initTocHighlight);
</script>

<style>
    .toc-sidebar-link:hover {
        border-left-color: var(--text-secondary);
    }
    .toc-sidebar-link.toc-active {
        color: var(--text-main);
        border-left-color: var(--text-main);
        font-weight: 500;
    }
    .toc-sidebar-link.toc-active:hover {
        border-left-color: var(--text-main);
    }
</style>
