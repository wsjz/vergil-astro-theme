---
interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    headings: Heading[];
}

const { headings } = Astro.props;
if (!headings || headings.length === 0) {
    return;
}
const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 4);
---

<aside class="toc-sidebar max-h-[70vh] flex flex-col pb-2" data-toc-root>
    {tocHeadings.length > 0 && (
        <>
            {/* 固定标题栏 */}
            <div class="px-4 pt-4 pb-2 shrink-0">
                <button
                    type="button"
                    class="w-full flex items-center justify-between group cursor-pointer"
                    data-toc-toggle
                    aria-expanded="true"
                >
                    <h3 class="text-xs font-medium text-muted uppercase tracking-wider">文章目录</h3>
                    <span class="text-muted group-hover:text-accent transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-toc-icon>
                            <line x1="8" y1="6" x2="21" y2="6" />
                            <line x1="8" y1="12" x2="21" y2="12" />
                            <line x1="8" y1="18" x2="21" y2="18" />
                            <line x1="3" y1="6" x2="3.01" y2="6" />
                            <line x1="3" y1="12" x2="3.01" y2="12" />
                            <line x1="3" y1="18" x2="3.01" y2="18" />
                        </svg>
                    </span>
                </button>
            </div>

            {/* 可滚动导航区 */}
            <div class="flex-1 overflow-y-auto px-4 pb-3 min-h-0">
                <div class="toc-nav-wrapper transition-all duration-300 ease-in-out overflow-hidden" data-toc-wrapper>
                    <nav class="border-l border-muted space-y-1" data-toc-nav>
                        {tocHeadings.map((heading) => {
                            const indentClass = heading.depth === 4 ? 'pl-7' : heading.depth === 3 ? 'pl-5' : 'pl-3';
                            const colorClass = heading.depth === 2 ? 'text-secondary font-medium' : 'text-muted';
                            return (
                                <a
                                    href={`#${heading.slug}`}
                                    class={`toc-sidebar-link block text-xs transition-all duration-200 hover:text-accent -ml-px border-l-2 border-transparent py-0.5 ${indentClass} ${colorClass}`}
                                >
                                    {heading.text}
                                </a>
                            );
                        })}
                    </nav>
                </div>
            </div>

            <div class="px-2.5 pt-3.5 pb-1">
                <div class="mx-2 border-t border-light/60" />
            </div>
        </>
    )}
</aside>

<script>
    function initTocHighlight() {
        const headings = document.querySelectorAll('h2[id], h3[id], h4[id]');
        const tocLinks = document.querySelectorAll('.toc-sidebar a[href^="#"]');
        if (headings.length === 0 || tocLinks.length === 0) return;

        let isClickScrolling = false;
        let clickTimeout: ReturnType<typeof setTimeout> | null = null;

        tocLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                isClickScrolling = true;
                const href = link.getAttribute('href');
                if (href) {
                    const id = href.slice(1);
                    const target = document.getElementById(id);
                    if (target) {
                        const header = document.getElementById('top-nav-header');
                        const toolbar = document.getElementById('floating-toolbar');
                        const topNavHeight = (header ? header.offsetHeight : 56) + (toolbar ? toolbar.offsetHeight : 0) + 16;
                        const targetPosition = target.getBoundingClientRect().top + window.scrollY - topNavHeight;
                        window.scrollTo({ top: targetPosition, behavior: 'smooth' });
                        history.pushState(null, '', href);
                    }
                    tocLinks.forEach(l => l.classList.remove('toc-active'));
                    link.classList.add('toc-active');
                }
                if (clickTimeout) clearTimeout(clickTimeout);
                clickTimeout = setTimeout(() => {
                    isClickScrolling = false;
                }, 1500);
            });
        });

        let lastActiveId: string | null = null;

        function getScrollOffset() {
            const header = document.getElementById('top-nav-header');
            const toolbar = document.getElementById('floating-toolbar');
            return (header ? header.offsetHeight : 56) + (toolbar ? toolbar.offsetHeight : 0) + 16;
        }

        function updateActiveHeading() {
            if (isClickScrolling) return;

            const offset = getScrollOffset();
            let activeHeading: Element | null = null;
            headings.forEach(heading => {
                const rect = heading.getBoundingClientRect();
                if (rect.top <= offset) {
                    activeHeading = heading;
                }
            });

            if (!activeHeading) return;
            const id = activeHeading.getAttribute('id');
            if (!id || id === lastActiveId) return;
            lastActiveId = id;

            tocLinks.forEach(l => l.classList.remove('toc-active'));
            const activeLink = document.querySelector(`.toc-sidebar a[href="#${id}"]`);
            if (!activeLink) return;
            activeLink.classList.add('toc-active');
            activeLink.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        let ticking = false;
        const onScroll = () => {
            if (!ticking) {
                requestAnimationFrame(() => {
                    updateActiveHeading();
                    ticking = false;
                });
                ticking = true;
            }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        updateActiveHeading();
    }

    function initTocToggle() {
        document.querySelectorAll('[data-toc-toggle]').forEach(btn => {
            if (btn.dataset.tocToggleInit) return;
            btn.dataset.tocToggleInit = 'true';

            const root = btn.closest('[data-toc-root]');
            const wrapper = root?.querySelector('[data-toc-wrapper]');
            if (!wrapper) return;

            btn.addEventListener('click', () => {
                const expanded = btn.getAttribute('aria-expanded') !== 'false';
                btn.setAttribute('aria-expanded', String(!expanded));
                if (expanded) {
                    wrapper.style.maxHeight = wrapper.scrollHeight + 'px';
                    wrapper.style.opacity = '1';
                    // Force reflow
                    wrapper.offsetHeight;
                    wrapper.style.maxHeight = '0px';
                    wrapper.style.opacity = '0';
                } else {
                    wrapper.style.maxHeight = wrapper.scrollHeight + 'px';
                    wrapper.style.opacity = '1';
                    wrapper.addEventListener('transitionend', function handler(e) {
                        if (e.target === wrapper) {
                            wrapper.style.maxHeight = '';
                            wrapper.removeEventListener('transitionend', handler);
                        }
                    }, { once: true });
                }
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            initTocHighlight();
            initTocToggle();
        });
    } else {
        initTocHighlight();
        initTocToggle();
    }

    document.addEventListener('astro:page-load', () => {
        initTocHighlight();
        initTocToggle();
    });
</script>

<style>
    .toc-sidebar-link:hover {
        border-left-color: var(--text-secondary);
    }
    .toc-sidebar-link.toc-active {
        color: var(--text-main);
        border-left-color: var(--text-main);
        font-weight: 500;
    }
    .toc-sidebar-link.toc-active:hover {
        border-left-color: var(--text-main);
    }
</style>
