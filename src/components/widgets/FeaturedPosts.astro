---
import { getCollection } from 'astro:content';
import { sortItemsByDateDesc } from '../../utils/data-utils';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(sortItemsByDateDesc);
const featured = allPosts.filter((p) => p.data.isFeatured).slice(0, 3);
---

{featured.length > 0 && (
    <div class="px-4 py-4">
        <h3 class="text-xs font-medium text-muted uppercase tracking-wider mb-3">精选文章</h3>
        <ul class="space-y-2">
            {featured.map((post) => (
                <li>
                    <a
                        href={`/blog/${post.id}/`}
                        class="group block title-scroll"
                    >
                        <span class="text-[11px] tracking-tight text-secondary group-hover:text-accent transition-colors leading-snug title-scroll-text">
                            {post.data.title}
                        </span>
                    </a>
                </li>
            ))}
        </ul>
    </div>
)}
