---
interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    headings: Heading[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 4);
---

<button
    id="back-to-top-btn"
    class="fixed right-4 xl:right-6 bottom-6 z-50 flex items-center justify-center w-10 h-10 bg-card/90 backdrop-blur-sm border border-light/60 rounded-full shadow-lg text-secondary hover:text-accent hover:border-accent/40 hover:shadow-xl hover:scale-110 transition-all duration-300 opacity-0 invisible translate-y-3"
    aria-label="回到顶部"
    title="回到顶部"
>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
    </svg>
</button>

{tocHeadings.length > 0 && (
    <>
        <button
            id="floating-toc-btn"
            class="fixed right-4 xl:right-[max(1rem,calc(2%+320px))] bottom-[5.5rem] z-40 xl:hidden flex items-center justify-center w-10 h-10 bg-card/90 backdrop-blur-sm border border-light/60 rounded-full shadow-lg text-secondary hover:text-accent hover:border-accent/40 hover:shadow-xl hover:scale-110 transition-all duration-300"
            aria-label="Open TOC"
            aria-expanded="false"
        >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
            </svg>
        </button>

        <div
            id="floating-toc-panel"
            class="fixed right-4 bottom-36 z-[60] xl:hidden w-72 max-h-[60vh] bg-card border border-light rounded-2xl shadow-2xl opacity-0 invisible translate-y-4 transition-all duration-300 overflow-hidden"
            aria-hidden="true"
        >
            <div class="flex items-center justify-between px-4 py-3 border-b border-light">
                <h3 class="text-sm font-medium text-main">目录</h3>
                <button
                    id="floating-toc-close"
                    class="p-1 text-muted hover:text-accent transition-colors"
                    aria-label="Close TOC"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <nav class="p-4 overflow-y-auto max-h-[calc(60vh-3rem)]">
                <ul class="space-y-2">
                    {tocHeadings.map((heading) => {
                        const indentClass = heading.depth === 4 ? 'pl-8' : heading.depth === 3 ? 'pl-4' : '';
                        const colorClass = heading.depth === 2 ? 'text-secondary font-medium' : 'text-muted';
                        return (
                            <li>
                                <a
                                    href={`#${heading.slug}`}
                                    class={`block text-sm transition-colors hover:text-accent ${indentClass} ${colorClass}`}
                                    data-heading-id={heading.slug}
                                >
                                    {heading.text}
                                </a>
                            </li>
                        );
                    })}
                </ul>
            </nav>
        </div>

        <div
            id="floating-toc-backdrop"
            class="fixed inset-0 z-50 xl:hidden bg-black/20 backdrop-blur-sm opacity-0 invisible transition-opacity duration-300"
            aria-hidden="true"
        />
    </>
)}

<script is:inline>
    (function() {
        // 返回顶部
        (function() {
            var btn = document.getElementById('back-to-top-btn');
            if (!btn) return;
            var ticking = false;
            function update() {
                if (window.scrollY > 400) {
                    btn.classList.remove('opacity-0', 'invisible', 'translate-y-3');
                    btn.classList.add('opacity-100', 'visible', 'translate-y-0');
                } else {
                    btn.classList.add('opacity-0', 'invisible', 'translate-y-3');
                    btn.classList.remove('opacity-100', 'visible', 'translate-y-0');
                }
                ticking = false;
            }
            window.addEventListener('scroll', function() {
                if (!ticking) {
                    requestAnimationFrame(update);
                    ticking = true;
                }
            }, { passive: true });
            btn.addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        })();

        (function setupEscapeOnce() {
            if (window.__floatingTocEscapeSetup) return;
            window.__floatingTocEscapeSetup = true;
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    const panel = document.getElementById('floating-toc-panel');
                    const btn = document.getElementById('floating-toc-btn');
                    const backdrop = document.getElementById('floating-toc-backdrop');
                    if (panel && !panel.classList.contains('invisible')) {
                        panel.classList.add('opacity-0', 'invisible', 'translate-y-4');
                        panel.classList.remove('opacity-100', 'visible', 'translate-y-0');
                        panel.setAttribute('aria-hidden', 'true');
                        backdrop?.classList.add('opacity-0', 'invisible');
                        backdrop?.classList.remove('opacity-100', 'visible');
                        btn?.classList.remove('hidden');
                        btn?.setAttribute('aria-expanded', 'false');
                    }
                }
            });
        })();

        function initFloatingToc() {
            const btn = document.getElementById('floating-toc-btn');
            const panel = document.getElementById('floating-toc-panel');
            const closeBtn = document.getElementById('floating-toc-close');
            const backdrop = document.getElementById('floating-toc-backdrop');

            if (!btn || !panel || !closeBtn || !backdrop) return;

            function open() {
                btn.setAttribute('aria-expanded', 'true');
                panel.classList.remove('opacity-0', 'invisible', 'translate-y-4');
                panel.classList.add('opacity-100', 'visible', 'translate-y-0');
                panel.setAttribute('aria-hidden', 'false');
                backdrop.classList.remove('opacity-0', 'invisible');
                backdrop.classList.add('opacity-100', 'visible');
                btn.classList.add('hidden');
            }

            function close() {
                btn.setAttribute('aria-expanded', 'false');
                panel.classList.add('opacity-0', 'invisible', 'translate-y-4');
                panel.classList.remove('opacity-100', 'visible', 'translate-y-0');
                panel.setAttribute('aria-hidden', 'true');
                backdrop.classList.add('opacity-0', 'invisible');
                backdrop.classList.remove('opacity-100', 'visible');
                btn.classList.remove('hidden');
            }

            btn.addEventListener('click', open);
            closeBtn.addEventListener('click', close);
            backdrop.addEventListener('click', close);

            panel.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    close();
                    const href = link.getAttribute('href');
                    if (href) {
                        const id = href.slice(1);
                        const target = document.getElementById(id);
                        if (target) {
                            const header = document.getElementById('top-nav-header');
                            const toolbar = document.getElementById('floating-toolbar');
                            const topNavHeight = (header ? header.offsetHeight : 56) + (toolbar ? toolbar.offsetHeight : 0) + 16;
                            const targetPosition = target.getBoundingClientRect().top + window.scrollY - topNavHeight;
                            window.scrollTo({ top: targetPosition, behavior: 'smooth' });
                            history.pushState(null, '', href);
                        }
                    }
                });
            });

            const links = panel.querySelectorAll('a[data-heading-id]');
            const headings = document.querySelectorAll('h2[id], h3[id], h4[id]');
            const nav = panel.querySelector('nav');
            let lastActiveId = null;

            function getScrollOffset() {
                var header = document.getElementById('top-nav-header');
                var toolbar = document.getElementById('floating-toolbar');
                return (header ? header.offsetHeight : 56) + (toolbar ? toolbar.offsetHeight : 0) + 16;
            }

            function updateActiveHeading() {
                var offset = getScrollOffset();
                var activeHeading = null;
                headings.forEach(function(heading) {
                    var rect = heading.getBoundingClientRect();
                    if (rect.top <= offset) {
                        activeHeading = heading;
                    }
                });
                if (!activeHeading) return;
                var id = activeHeading.getAttribute('id');
                if (!id || id === lastActiveId) return;
                lastActiveId = id;

                links.forEach(function(link) {
                    link.classList.remove('text-accent', 'font-medium');
                    link.classList.add('text-muted');
                });
                var activeLink = panel.querySelector('a[data-heading-id="' + id + '"]');
                if (!activeLink) return;
                activeLink.classList.remove('text-muted');
                activeLink.classList.add('text-accent', 'font-medium');

                if (nav) {
                    activeLink.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
            }

            var fticking = false;
            function onScroll() {
                if (!fticking) {
                    requestAnimationFrame(function() {
                        updateActiveHeading();
                        fticking = false;
                    });
                    fticking = true;
                }
            }

            // Clean up old listener before adding new one (for ViewTransitions)
            if (window._floatingTocScrollHandler) {
                window.removeEventListener('scroll', window._floatingTocScrollHandler);
            }
            window._floatingTocScrollHandler = onScroll;
            window.addEventListener('scroll', onScroll, { passive: true });
            updateActiveHeading();
        }

        initFloatingToc();
        document.addEventListener('astro:page-load', initFloatingToc);
    })();
</script>
