---
import { ChevronRight, ChevronDown } from '@lucide/astro';
import type { DocTreeNode } from '../../utils/docs-utils';

interface Props {
    nodes: DocTreeNode[];
    currentSlug: string;
    docId: string;
    level?: number;
}

const { nodes, currentSlug, docId, level = 0 } = Astro.props;

function isActive(slug: string, current: string): boolean {
    return slug.toLowerCase() === current.toLowerCase();
}

function isInDir(dirPath: string, current: string): boolean {
    const lowerDir = dirPath.toLowerCase();
    const lowerCurrent = current.toLowerCase();
    return lowerCurrent === lowerDir || lowerCurrent.startsWith(lowerDir + '/');
}

function isAncestorActive(node: DocTreeNode, current: string): boolean {
    if (node.type === 'article') return false;
    if (isActive(node.slug || '', current)) return true;
    if (isInDir(node.dirPath, current)) {
        for (const child of node.children) {
            if (isAncestorActive(child, current)) return true;
        }
    }
    return false;
}

// 计算当前路径上所有被展开的目录
function getExpandedDirs(nodes: DocTreeNode[], current: string, expanded: Set<string> = new Set()): Set<string> {
    for (const node of nodes) {
        if (node.type === 'group') {
            if (isInDir(node.dirPath, current)) {
                expanded.add(node.dirPath);
                getExpandedDirs(node.children, current, expanded);
            }
        }
    }
    return expanded;
}

const expandedDirs = getExpandedDirs(nodes, currentSlug);

// 层级样式配置
const levelConfig = [
    { textSize: 'text-[13px]', fontWeight: 'font-semibold', opacity: 'opacity-100' },
    { textSize: 'text-[13px]', fontWeight: 'font-medium',   opacity: 'opacity-95'  },
    { textSize: 'text-[12.5px]', fontWeight: 'font-medium', opacity: 'opacity-90'  },
    { textSize: 'text-xs',      fontWeight: 'font-normal',  opacity: 'opacity-85'  },
];

function getLevelConfig(l: number) {
    return levelConfig[Math.min(l, levelConfig.length - 1)];
}
---

<ul class={`docs-tree-list ${level > 0 ? 'docs-tree-children' : ''}`} data-level={level}>
    {nodes.map((node) => {
        if (node.type === 'article') {
            const active = isActive(node.slug, currentSlug);
            const cfg = getLevelConfig(level);
            return (
                <li class="docs-tree-item">
                    <a
                        href={`/docs/${docId}/${node.slug}/`}
                        class={`docs-tree-link ${cfg.textSize} ${active ? 'active' : ''}`}
                        data-level={level}
                    >
                        <span class="active-indicator" aria-hidden="true" />
                        <span class="indent-spacer" aria-hidden="true" data-level={level} />
                        <span class="article-placeholder" aria-hidden="true" />
                        <span class={`truncate ${cfg.fontWeight} ${cfg.opacity}`}>{node.title}</span>
                    </a>
                </li>
            );
        }

        const expanded = expandedDirs.has(node.dirPath);
        const hasIndex = !!node.slug;
        const active = hasIndex && isActive(node.slug, currentSlug);
        const ancestorActive = isAncestorActive(node, currentSlug);
        const hasChildren = node.children.length > 0;
        const cfg = getLevelConfig(level);

        const inDir = isInDir(node.dirPath, currentSlug);
        const navHref = hasIndex && !inDir ? `/docs/${docId}/${node.slug}/` : null;

        const headerContent = (
            <>
                <span class="active-indicator" aria-hidden="true" />
                <span class="indent-spacer" aria-hidden="true" data-level={level} />

                {/* 箭头 — 标识为目录，同时指示展开状态 */}
                {hasChildren ? (
                    <span class="chevron-indicator">
                        <span class={`chevron-icon chevron-expanded ${expanded ? '' : 'hidden'}`}>
                            <ChevronDown class={`w-3.5 h-3.5 ${active || ancestorActive ? 'text-accent' : 'text-muted/50'}`} />
                        </span>
                        <span class={`chevron-icon chevron-collapsed ${expanded ? 'hidden' : ''}`}>
                            <ChevronRight class={`w-3.5 h-3.5 ${active || ancestorActive ? 'text-accent' : 'text-muted/50'}`} />
                        </span>
                    </span>
                ) : (
                    <span class="chevron-placeholder" />
                )}

                {/* 目录标题 */}
                <span class={`docs-group-title ${cfg.textSize} ${cfg.fontWeight} ${active ? 'text-accent' : ''}`}>
                    {node.title}
                </span>
            </>
        );

        return (
            <li class="docs-tree-item docs-tree-group-item" data-dir-path={node.dirPath}>
                {navHref ? (
                    <a
                        href={navHref}
                        class={`docs-tree-group-header ${active ? 'active' : ''}`}
                        data-level={level}
                        data-expandable={hasChildren ? 'true' : 'false'}
                    >
                        {headerContent}
                    </a>
                ) : (
                    <div
                        class={`docs-tree-group-header ${active ? 'active' : ''}`}
                        data-level={level}
                        data-expandable={hasChildren ? 'true' : 'false'}
                        role="button"
                        tabindex="0"
                    >
                        {headerContent}
                    </div>
                )}

                {/* 子内容 */}
                {hasChildren && (
                    <div class={`doc-children-wrapper ${expanded ? '' : 'collapsed'}`}>
                        <div class="doc-children-inner">
                            <Astro.self nodes={node.children} currentSlug={currentSlug} docId={docId} level={level + 1} />
                        </div>
                    </div>
                )}
            </li>
        );
    })}
</ul>

<style>
    /* ── 列表容器 ── */
    .docs-tree-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .docs-tree-children {
        position: relative;
    }

    /* ── 列表项 ── */
    .docs-tree-item {
        position: relative;
    }

    /* 顶级组之间增加间距 */
    .docs-tree-list[data-level="0"] > .docs-tree-group-item:not(:first-child) {
        margin-top: 6px;
    }

    /* ── 缩进占位 ── */
    .indent-spacer {
        display: inline-block;
        flex-shrink: 0;
        width: 0;
    }

    .indent-spacer[data-level="1"] { width: 12px; }
    .indent-spacer[data-level="2"] { width: 24px; }
    .indent-spacer[data-level="3"] { width: 36px; }

    /* ── 文章链接 ── */
    .docs-tree-link {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 6px 10px 6px 8px;
        border-radius: 8px;
        text-decoration: none;
        color: var(--text-secondary);
        transition: all 0.2s ease;
        position: relative;
        min-height: 32px;
    }

    .docs-tree-link:hover {
        color: var(--text-main);
        background-color: var(--bg-hover);
    }

    .docs-tree-link.active {
        color: var(--accent-color);
        background-color: color-mix(in srgb, var(--accent-color) 8%, transparent);
        font-weight: 500;
    }

    .docs-tree-link.active:hover {
        background-color: color-mix(in srgb, var(--accent-color) 12%, transparent);
    }

    /* ── 目录标题行 ── */
    .docs-tree-group-header {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 6px 10px 6px 8px;
        border-radius: 8px;
        color: var(--text-main);
        transition: background-color 0.2s ease;
        position: relative;
        min-height: 34px;
        text-decoration: none;
        cursor: pointer;
    }

    .docs-tree-group-header:hover {
        background-color: var(--bg-hover);
    }

    .docs-tree-group-header:not([href]) {
        cursor: default;
    }

    .docs-tree-group-header.active {
        background-color: color-mix(in srgb, var(--accent-color) 8%, transparent);
    }

    .docs-group-title {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: inherit;
    }

    /* ── 箭头指示 ── */
    .chevron-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }

    .chevron-placeholder,
    .article-placeholder {
        display: inline-block;
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }

    /* ── 激活指示条 ── */
    .active-indicator {
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 3px;
        height: 0;
        background-color: var(--accent-color);
        border-radius: 0 2px 2px 0;
        transition: height 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        opacity: 0;
    }

    .docs-tree-link.active .active-indicator,
    .docs-tree-group-header.active .active-indicator {
        height: 18px;
        opacity: 1;
    }

    /* ── 子内容展开动画 ── */
    .doc-children-wrapper {
        display: grid;
        grid-template-rows: 1fr;
        transition: grid-template-rows 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        margin-left: 11px;
        padding-left: 6px;
        border-left: 1px solid var(--border-light);
        opacity: 1;
    }

    .doc-children-wrapper.collapsed {
        grid-template-rows: 0fr;
        opacity: 0;
    }

    .doc-children-inner {
        overflow: hidden;
        padding-top: 2px;
        padding-bottom: 2px;
    }

    /* 深色模式边框淡化 */
    :global(.dark) .doc-children-wrapper {
        border-left-color: color-mix(in srgb, var(--border-light) 60%, transparent);
    }
</style>

<script is:inline>
(function() {
    var STORAGE_KEY = 'docsExpandedDirs';

    function getExpandedDirs() {
        try {
            return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        } catch (e) {
            return [];
        }
    }

    function saveExpandedDirs(dirs) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(dirs));
    }

    function syncCurrentExpanded() {
        var expandedDirs = getExpandedDirs();
        document.querySelectorAll('.docs-tree-group-item').forEach(function(item) {
            var wrapper = item.querySelector('.doc-children-wrapper');
            var dirPath = item.dataset.dirPath;
            if (!wrapper || !dirPath) return;
            if (!wrapper.classList.contains('collapsed')) {
                if (expandedDirs.indexOf(dirPath) === -1) {
                    expandedDirs.push(dirPath);
                }
            }
        });
        saveExpandedDirs(expandedDirs);
    }

    function applyManualExpand() {
        var expandedDirs = getExpandedDirs();
        expandedDirs.forEach(function(dirPath) {
            var item = document.querySelector('.docs-tree-group-item[data-dir-path="' + dirPath + '"]');
            if (!item) return;
            var wrapper = item.querySelector('.doc-children-wrapper');
            var header = item.querySelector('.docs-tree-group-header');
            if (wrapper) {
                wrapper.classList.remove('collapsed');
            }
            if (header) {
                var expandedIcon = header.querySelector('.chevron-expanded');
                var collapsedIcon = header.querySelector('.chevron-collapsed');
                if (expandedIcon) expandedIcon.classList.remove('hidden');
                if (collapsedIcon) collapsedIcon.classList.add('hidden');
            }
        });
    }

    function toggleDir(groupItem) {
        var wrapper = groupItem.querySelector('.doc-children-wrapper');
        var header = groupItem.querySelector('.docs-tree-group-header');
        if (!wrapper) return;

        var dirPath = groupItem.dataset.dirPath;
        var isNowCollapsed = !wrapper.classList.contains('collapsed');
        wrapper.classList.toggle('collapsed');

        // 切换箭头图标
        if (header) {
            var expandedIcon = header.querySelector('.chevron-expanded');
            var collapsedIcon = header.querySelector('.chevron-collapsed');
            if (expandedIcon && collapsedIcon) {
                if (isNowCollapsed) {
                    expandedIcon.classList.add('hidden');
                    collapsedIcon.classList.remove('hidden');
                } else {
                    expandedIcon.classList.remove('hidden');
                    collapsedIcon.classList.add('hidden');
                }
            }
        }

        // 同步 localStorage
        var expandedDirs = getExpandedDirs();
        if (isNowCollapsed) {
            expandedDirs = expandedDirs.filter(function(p) { return p !== dirPath; });
        } else {
            if (expandedDirs.indexOf(dirPath) === -1) {
                expandedDirs.push(dirPath);
            }
        }
        saveExpandedDirs(expandedDirs);
    }

    function init() {
        // 先把当前页面展开的目录（含自动展开）同步到 localStorage
        syncCurrentExpanded();
        // 再恢复所有记录的展开状态
        applyManualExpand();

        // 箭头独立点击 → 展开/收起，阻止导航
        document.querySelectorAll('.chevron-indicator').forEach(function(chevron) {
            if (chevron.dataset.chevronBound) return;
            chevron.dataset.chevronBound = 'true';

            chevron.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                var groupItem = chevron.closest('.docs-tree-group-item');
                toggleDir(groupItem);
            });
        });

        // div header（已进入的目录）点击 → 展开/收起
        document.querySelectorAll('.docs-tree-group-header[data-expandable="true"]').forEach(function(header) {
            if (header.dataset.expandBound) return;
            header.dataset.expandBound = 'true';

            header.addEventListener('click', function(e) {
                if (header.tagName === 'A') return; // 未进入的目录，走默认导航
                var groupItem = header.closest('.docs-tree-group-item');
                toggleDir(groupItem);
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
    document.addEventListener('astro:page-load', init);
})();
</script>
