---
interface Props {
    title: string;
    subtitle?: string;
    description?: string;
    backgroundImage?: string;
    overlay?: string;
    textShadow?: boolean;
    buttonText?: string;
    fallbackBg?: string;
    gradientColor?: string;
    gradientHeight?: string;
    backdropBlur?: string;
}

const {
    title,
    subtitle,
    description,
    backgroundImage,
    overlay,
    textShadow = true,
    buttonText = '开始阅读',
    fallbackBg,
    gradientColor,
    gradientHeight = 'h-56',
    backdropBlur = '12px'
} = Astro.props;

const hasBg = !!backgroundImage;
const textClass = hasBg ? 'text-white' : 'text-main';
const subTextClass = hasBg ? 'text-white/80' : 'text-secondary';
const shadowClass = textShadow && hasBg ? '[text-shadow:0_2px_8px_rgba(0,0,0,0.5)]' : '';
const subShadowClass = textShadow && hasBg ? '[text-shadow:0_1px_4px_rgba(0,0,0,0.4)]' : '';

const resolvedFallbackBg = fallbackBg || (hasBg ? 'bg-stone-900' : 'bg-main');
const resolvedGradientColor = gradientColor || 'var(--bg-main, #f8fafc)';

const cssVars = [
    `--splash-gradient-color: ${resolvedGradientColor};`,
    `--splash-backdrop-blur: ${backdropBlur};`
].join(' ');
---

<!-- DocSet Splash -->
<div
    id="docset-splash"
    class={`fixed inset-0 z-[100] flex flex-col items-center justify-center ${resolvedFallbackBg}`}
    style={cssVars}
>
    {hasBg && (
        <div
            class="absolute inset-0 bg-cover bg-center bg-no-repeat"
            style={`background-image: url('${backgroundImage}');`}
        />
    )}

    {hasBg && overlay && (
        <div
            class="absolute inset-0"
            style={`background: ${overlay};`}
        />
    )}

    {hasBg && (
        <div class={`splash-gradient ${gradientHeight}`} />
    )}

    <div class="relative z-10 text-center px-6 max-w-2xl">
        {subtitle && (
            <p class={`text-sm sm:text-base font-medium tracking-widest uppercase mb-4 ${subTextClass} ${subShadowClass}`}>
                {subtitle}
            </p>
        )}
        <h1 class={`font-display text-4xl sm:text-5xl md:text-6xl font-bold mb-6 tracking-tight leading-tight ${textClass} ${shadowClass}`}>
            {title}
        </h1>
        {description && (
            <p class={`text-base sm:text-lg leading-relaxed mb-10 ${subTextClass} ${subShadowClass}`}>
                {description}
            </p>
        )}

        <button
            id="docset-splash-btn"
            class="inline-flex items-center justify-center px-8 py-3 rounded-full text-sm font-medium
                   bg-white/90 dark:bg-gray-900/90 text-main dark:text-white
                   hover:bg-white dark:hover:bg-gray-800
                   backdrop-blur-md shadow-lg hover:shadow-xl
                   transition-all duration-300 hover:scale-105
                   border border-white/20 dark:border-gray-700/30
                   cursor-pointer"
        >
            {buttonText}
            <svg
                class="ml-2 w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
            </svg>
        </button>
    </div>

    <button
        id="docset-splash-arrow"
        class={`absolute bottom-12 left-1/2 -translate-x-1/2 p-2 transition-colors duration-300 cursor-pointer group z-10 ${hasBg ? 'text-white/70 hover:text-white' : 'text-secondary hover:text-accent'}`}
        aria-label="进入文档"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-8 h-8 animate-bounce-arrow"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="M6 9l6 6 6-6" />
        </svg>
    </button>
</div>

<style>
    @keyframes bounce-arrow {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(8px); }
    }

    .animate-bounce-arrow {
        animation: bounce-arrow 1.5s ease-in-out infinite;
    }

    .splash-gradient {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(
            to bottom,
            transparent 0%,
            var(--splash-gradient-color, #f8fafc) 100%
        );
        backdrop-filter: blur(var(--splash-backdrop-blur, 12px));
        -webkit-backdrop-filter: blur(var(--splash-backdrop-blur, 12px));
        mask-image: linear-gradient(to bottom, transparent 0%, black 60%);
        -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 60%);
        pointer-events: none;
        z-index: 5;
    }
</style>

<script>
    (function () {
        var _splashAC = null;

        function initSplash() {
            if (_splashAC) _splashAC.abort();
            _splashAC = new AbortController();
            var signal = _splashAC.signal;

            var splash = document.getElementById('docset-splash');
            if (!splash) return;

            var viewportHeight = window.innerHeight;
            var isSnapping = false;
            var ticking = false;

            function enterDoc() {
                snapTo(viewportHeight);
            }

            function snapTo(target) {
                if (isSnapping) return;
                isSnapping = true;
                window.scrollTo({ top: target, behavior: 'smooth' });
                setTimeout(function () { isSnapping = false; }, 800);
            }

            function updateOnScroll() {
                var scrollY = window.scrollY;
                splash.style.transform = 'translateY(' + (-scrollY) + 'px)';
                if (scrollY >= viewportHeight) {
                    splash.style.pointerEvents = 'none';
                } else {
                    splash.style.pointerEvents = '';
                }
            }

            window.scrollTo({ top: 0, behavior: 'instant' });
            splash.style.transform = 'translateY(0)';
            updateOnScroll();

            window.addEventListener('scroll', function () {
                if (!ticking) {
                    window.requestAnimationFrame(function () {
                        updateOnScroll();
                        ticking = false;
                    });
                    ticking = true;
                }
            }, { passive: true, signal: signal });

            var btn = document.getElementById('docset-splash-btn');
            var arrow = document.getElementById('docset-splash-arrow');

            btn?.addEventListener('click', function (e) {
                e.stopPropagation();
                enterDoc();
            }, { signal: signal });

            arrow?.addEventListener('click', function (e) {
                e.stopPropagation();
                enterDoc();
            }, { signal: signal });

            splash.addEventListener('click', function (e) {
                var target = e.target;
                if (target.closest('button')) return;
                enterDoc();
            }, { signal: signal });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    enterDoc();
                }
            }, { signal: signal });

            window.addEventListener('wheel', function (e) {
                if (window.scrollY < viewportHeight && !isSnapping) {
                    if (e.deltaY > 5) {
                        e.preventDefault();
                        snapTo(viewportHeight);
                    } else if (e.deltaY < -5 && window.scrollY > 0) {
                        e.preventDefault();
                        snapTo(0);
                    }
                }
            }, { passive: false, signal: signal });

            var touchStartY = 0;
            window.addEventListener('touchstart', function (e) {
                touchStartY = e.touches[0].clientY;
            }, { passive: true, signal: signal });

            window.addEventListener('touchend', function (e) {
                if (window.scrollY < viewportHeight) {
                    var deltaY = touchStartY - e.changedTouches[0].clientY;
                    if (deltaY > 30) snapTo(viewportHeight);
                    else if (deltaY < -30) snapTo(0);
                    else enterDoc();
                }
            }, { passive: true, signal: signal });
        }

        document.addEventListener('astro:page-load', initSplash);

        document.addEventListener('astro:before-swap', function () {
            var splash = document.getElementById('docset-splash');
            if (splash) splash.style.transform = '';
            if (_splashAC) _splashAC.abort();
            _splashAC = null;
        });
    })();
</script>
