---
import { BookOpen } from '@lucide/astro';
import { getDocTree, getDocHomepageSlug, type DocTreeNode } from '../../utils/docs-utils';
import DocsTreeNode from './DocsTreeNode.astro';

interface Props {
    docId: string;
    currentSlug?: string;
}

const { docId, currentSlug = '' } = Astro.props;
const tree = await getDocTree(docId);
const homepageSlug = await getDocHomepageSlug(docId);
---

<aside
    id="docs-sidebar"
    class="sidebar flex flex-col fixed lg:sticky lg:self-start left-0 lg:left-auto top-14 h-[calc(100vh-3.5rem)] w-64 lg:w-56 xl:w-60 2xl:w-64 bg-main overflow-y-auto z-40 transition-transform duration-300 translate-x-0"
>
    <div class="flex-1 py-4 px-3">
        <slot name="title">
            <div class="flex items-center gap-2 mb-5 pb-3 px-1 border-b border-light">
                <BookOpen class="w-[18px] h-[18px] text-accent" />
                <span class="font-display text-[13px] font-semibold text-main tracking-wide">文档</span>
            </div>
        </slot>

        {tree.length > 0 ? (
            <DocsTreeNode nodes={tree} currentSlug={currentSlug} docId={docId} homepageSlug={homepageSlug} />
        ) : (
            <p class="text-xs text-muted px-2">暂无文档</p>
        )}
    </div>
</aside>

<!-- Overlay for mobile -->
<div id="docs-sidebar-overlay" class="fixed inset-0 z-[35] hidden opacity-0 transition-opacity duration-300 bg-black/20 backdrop-blur-sm"></div>

<script is:inline>
    (function () {
        let wasMobile = window.innerWidth < 1024;
        let isCollapsed = false;

        function getElements() {
            return {
                sidebar: document.getElementById('docs-sidebar'),
                overlay: document.getElementById('docs-sidebar-overlay'),
            };
        }

        function setCollapsed(collapsed) {
            isCollapsed = collapsed;
            const { sidebar, overlay } = getElements();
            if (!sidebar) return;
            const isMobile = window.innerWidth < 1024;

            if (collapsed) {
                sidebar.style.translate = '-100vw 0';
                sidebar.classList.remove('translate-x-0');
                overlay?.classList.add('hidden', 'opacity-0');
                document.body.style.overflow = '';
            } else {
                sidebar.style.translate = '';
                sidebar.classList.add('translate-x-0');
                if (isMobile) {
                    overlay?.classList.remove('hidden');
                    setTimeout(() => overlay?.classList.remove('opacity-0'), 10);
                    document.body.style.overflow = 'hidden';
                }
            }
        }

        function toggleSidebar() {
            setCollapsed(!isCollapsed);
        }

        function init() {
            const { overlay } = getElements();
            overlay?.addEventListener('click', () => setCollapsed(true));
            document.addEventListener('toggle-docs-sidebar', toggleSidebar);
        }

        if (!window.__docsSidebarInit) {
            window.__docsSidebarInit = true;
            init();
            if (window.innerWidth < 1024) {
                setCollapsed(true);
            }
        }

        window.addEventListener('resize', () => {
            const isMobile = window.innerWidth < 1024;
            if (isMobile && !wasMobile) {
                setCollapsed(true);
            } else if (!isMobile && wasMobile) {
                setCollapsed(false);
            }
            wasMobile = isMobile;
        });

        document.addEventListener('astro:page-load', () => {
            if (window.innerWidth < 1024 && !isCollapsed) {
                setCollapsed(true);
            }
        });
    })();
</script>

<style>
    .sidebar {
        scrollbar-width: thin;
        scrollbar-color: var(--border-light) transparent;
    }
    .sidebar::-webkit-scrollbar {
        width: 4px;
    }
    .sidebar::-webkit-scrollbar-track {
        background: transparent;
    }
    .sidebar::-webkit-scrollbar-thumb {
        background-color: var(--border-light);
        border-radius: 2px;
    }
</style>
