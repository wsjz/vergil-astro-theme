---
import { ChevronLeft } from '@lucide/astro';
import BaseHead from '../components/base/BaseHead.astro';
import FormattedDate from '../components/ui/FormattedDate.astro';
import AlbumCard from '../components/content/AlbumCard.astro';

interface Props {
    title?: string;
    description?: string;
    theme?: string;
    fonts?: { display?: string; body?: string };
    pageType?: 'detail' | 'list';
    background?: string;
    accent?: string;
    album?: any;
}

const { title = '', description = '', theme = 'golden', fonts = {}, pageType = 'list', background, accent, album } = Astro.props;

const themeBg = background || (theme === 'seasons' ? '#0d0d12' : '#0a0a0a');
const themeCard = theme === 'seasons' ? '#141420' : '#111111';
/* Exact from building index.css */
const themeText = '#f5f5f5';
const themeSecondary = '#a0a0a0';
const themeMuted = '#666666';
const themeAccent = accent || '#C8A464';
const themeBorder = theme === 'seasons' ? 'rgba(255,255,255,0.06)' : 'rgba(255,255,255,0.05)';

const fontFamilies: string[] = [];
const defaultDisplay = 'Noto+Serif+SC:wght@200;300;400;500;600;700';
const defaultBody = 'Noto+Sans+SC:wght@300;400;500;600';

if (fonts.display) {
    fontFamilies.push(fonts.display.replace(/ /g, '+'));
} else {
    fontFamilies.push(defaultDisplay);
}
if (fonts.body && fonts.body !== fonts.display) {
    fontFamilies.push(fonts.body.replace(/ /g, '+'));
}

const hasCustomFonts = fontFamilies.length > 0;
const fontsUrl = hasCustomFonts
    ? `https://fonts.googleapis.com/css2?family=${fontFamilies.join('&family=')}&display=swap`
    : null;

const fontDisplay = fonts.display || '"Noto Serif SC", "Songti SC", serif';
const fontBody = fonts.body || '"Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif';

const seoTitle = pageType === 'list' ? `Albums` : title;
const seoDesc = description || '';
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <BaseHead title={seoTitle} description={seoDesc} />
        {fontsUrl ? <link rel="stylesheet" href={fontsUrl} /> : null}
        <style is:inline set:html={`
            :root {
                --album-bg: ${themeBg};
                --album-bg-card: ${themeCard};
                --album-text: ${themeText};
                --album-text-secondary: ${themeSecondary};
                --album-text-muted: ${themeMuted};
                --album-accent: ${themeAccent};
                --album-border: ${themeBorder};
                --font-display: ${fontDisplay};
                --font-body: ${fontBody};
            }
            html, body {
                background: ${themeBg};
                color: ${themeText};
                margin: 0;
                padding: 0;
                font-family: ${fontBody};
                -webkit-font-smoothing: antialiased;
                text-rendering: optimizeLegibility;
            }
            ::selection {
                background: rgba(200, 164, 100, 0.3);
                color: ${themeText};
            }
        `} />
    </head>
    <body>
        <div class="album-page" data-album-theme={theme} data-page-type={pageType}>
            {/* ── Atmosphere Layer ── */}
            <div class="album-atmosphere">
                <div class="album-atmosphere-gradient"></div>
                <div class="album-atmosphere-vignette"></div>
            </div>

            {/* ── Content ── */}
            <div class="album-content">
                <slot />
            </div>

            {/* ── Back Navigation ── */}
            {pageType === 'detail' ? (
                <nav class="album-back" aria-label="返回影集列表">
                    <a href="/albums/" class="album-back-link">
                        <ChevronLeft class="w-3.5 h-3.5" style="stroke-width: 1.5" />
                        <span>返回影集列表</span>
                    </a>
                </nav>
            ) : null}

            {/* ── Next Album Footer ── */}
            {pageType === 'detail' && album ? (
                <footer class="album-footer">
                    <div class="album-footer-line" />
                    <div class="album-footer-inner">
                        <div class="album-footer-left">
                            <span class="album-footer-label">Next Album · 下一期</span>
                            <p class="album-footer-desc">继续探索更多视觉故事</p>
                        </div>
                        <div class="album-footer-right">
                            <AlbumCard
                                id={album.id}
                                title={album.data.title}
                                description={album.data.description}
                                date={album.data.date}
                                cover={album.data.cover}
                                imageCount={album.data.images?.length || 0}
                                theme={album.data.theme || 'golden'}
                            />
                        </div>
                    </div>
                </footer>
            ) : null}
        </div>

        <script is:inline>
            (function() {
                // Reveal animation
                function initReveal() {
                    var observer = new IntersectionObserver(function(entries) {
                        entries.forEach(function(entry) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('visible');
                                observer.unobserve(entry.target);
                            }
                        });
                    }, { rootMargin: '0px 0px -40px 0px', threshold: 0 });
                    document.querySelectorAll('.reveal').forEach(function(el) { observer.observe(el); });
                }
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initReveal);
                } else {
                    initReveal();
                }
                document.addEventListener('astro:page-load', initReveal);

                // Lazy load fade-in
                function initLazyImages() {
                    document.querySelectorAll('img[loading="lazy"]').forEach(function(img) {
                        if (img.complete) { img.classList.add('img-loaded'); }
                        else {
                            img.addEventListener('load', function() { img.classList.add('img-loaded'); });
                            img.addEventListener('error', function() { img.classList.add('img-loaded'); });
                        }
                    });
                }
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initLazyImages);
                } else {
                    initLazyImages();
                }
                document.addEventListener('astro:page-load', initLazyImages);
            })();
        </script>
    </body>
</html>

<style is:global>
    .album-page {
        background: var(--album-bg);
        min-height: 100vh;
        position: relative;
    }

    .album-atmosphere {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }

    .album-atmosphere-gradient {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse at 50% 0%, rgba(200, 164, 100, 0.04) 0%, transparent 55%),
            radial-gradient(ellipse at 80% 100%, rgba(200, 164, 100, 0.025) 0%, transparent 45%),
            radial-gradient(ellipse at 20% 60%, rgba(180, 140, 80, 0.015) 0%, transparent 40%);
    }

    [data-album-theme="seasons"] .album-atmosphere-gradient {
        background:
            radial-gradient(ellipse at 30% 20%, rgba(120, 160, 200, 0.05) 0%, transparent 45%),
            radial-gradient(ellipse at 70% 80%, rgba(200, 160, 120, 0.035) 0%, transparent 40%),
            radial-gradient(ellipse at 50% 50%, rgba(100, 140, 180, 0.02) 0%, transparent 50%);
    }

    .album-atmosphere-vignette {
        position: absolute;
        inset: 0;
        box-shadow: inset 0 0 250px 100px rgba(0, 0, 0, 0.5);
    }

    .album-atmosphere::after {
        content: '';
        position: absolute;
        inset: 0;
        opacity: 0.015;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        pointer-events: none;
    }

    .album-content {
        position: relative;
        z-index: 1;
    }

    /* ── Directive dark-theme overrides for album pages ── */
    .album-page {
        --text-main: var(--album-text);
        --text-secondary: var(--album-text-secondary);
        --bg-card: var(--album-bg-card);
        --border-light: var(--album-border);
        --photo-watermark-bg: var(--album-bg-card);
        --photo-watermark-text: var(--album-text);
        --photo-watermark-muted: var(--album-text-muted);
    }

    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--album-border); border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--album-text-muted); }

    .reveal {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal.visible {
        opacity: 1;
        transform: translateY(0);
    }
    img.img-loaded { opacity: 1; }
    img[loading="lazy"] { opacity: 0; transition: opacity 0.6s ease; }
</style>

<style>
    .album-back {
        max-width: 90rem;
        margin: 0 auto;
        padding: 3rem 1.5rem;
    }

    @media (min-width: 768px) {
        .album-back {
            padding: 4rem 4rem;
        }
    }

    .album-back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--album-text-muted);
        text-decoration: none;
        transition: color 0.3s ease, gap 0.3s ease;
    }

    .album-back-link:hover {
        color: var(--album-accent);
        gap: 0.875rem;
    }

    .album-back-link svg {
        transition: transform 0.3s ease;
    }

    .album-back-link:hover svg {
        transform: translateX(-3px);
    }

    .album-footer {
        max-width: 90rem;
        margin: 0 auto;
        padding: 6rem 1.5rem 4rem;
    }

    @media (min-width: 768px) {
        .album-footer {
            padding: 8rem 4rem 4rem;
        }
    }

    .album-footer-line {
        height: 1px;
        background: linear-gradient(to right, var(--album-border), transparent);
        margin-bottom: 3rem;
    }

    .album-footer-inner {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    @media (min-width: 768px) {
        .album-footer-inner {
            flex-direction: row;
            align-items: flex-start;
            justify-content: space-between;
            gap: 3rem;
        }
    }

    .album-footer-label {
        font-size: 0.6875rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--album-accent);
        font-weight: 500;
        display: block;
        margin-bottom: 0.75rem;
    }

    .album-footer-desc {
        font-size: 0.8125rem;
        color: var(--album-text-muted);
        line-height: 1.6;
        max-width: 16rem;
    }

    .album-footer-right {
        max-width: 400px;
        width: 100%;
    }
</style>
