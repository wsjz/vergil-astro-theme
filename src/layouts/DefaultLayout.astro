---
import { ViewTransitions } from 'astro:transitions';
import BaseHead, { type Props as HeadProps } from '../components/base/BaseHead.astro';
import Footer from '../components/base/Footer.astro';
import LeftSidebar from '../components/base/LeftSidebar.astro';
import RightSidebar from '../components/base/RightSidebar.astro';
import FloatingToolbar from '../components/base/FloatingToolbar.astro';
import TopNav from '../components/base/HeaderNav.astro';
import Search from '../components/widgets/Search.astro';
import SiteAgent from '../components/widgets/SiteAgent.astro';
import FloatingAudioPlayer from '../components/widgets/FloatingAudioPlayer.astro';
import siteConfig from '../data/site-config';

export type Props = HeadProps & { showSidebar?: boolean; showRightSidebar?: boolean; showTopNav?: boolean; articleTitle?: string; commentsEnabled?: boolean; splashMode?: boolean };

const { showSidebar = true, showRightSidebar = true, showTopNav = true, articleTitle = '', commentsEnabled = false, splashMode = false, ...head } = Astro.props;
const isArticle = head.pageType === 'article';
---

<!doctype html>
<html lang="en" class="wrap-break-words antialiased">
    <head>
        <BaseHead {...head} />
        <script is:inline>
            (function() {
                if (location.pathname !== '/') return;
                if ('scrollRestoration' in history) {
                    history.scrollRestoration = 'manual';
                }
                window.scrollTo(0, 0);
            })();
        </script>
        <script is:inline src="/js/theme-init.js"></script>
        <ViewTransitions />
        <script is:inline src="/theme-toggle.js"></script>
        <script is:inline src="/js/copy-btn.js"></script>
        <script is:inline src="/js/private-decrypt.js"></script>
        <script is:inline src="/js/audio-player.js"></script>
        <script is:inline>
        (function () {
            function formatTime(s) {
                if (!isFinite(s) || s < 0) return '00:00';
                var m = Math.floor(s / 60);
                var sec = Math.floor(s % 60);
                return (m < 10 ? '0' : '') + m + ':' + (sec < 10 ? '0' : '') + sec;
            }

            var pipContainer = null;
            var pipVideo = null;
            var pipOriginal = null;
            var pipObserver = null;
            var pipDragState = null;

            function createPip(originalVideo) {
                if (pipContainer) return;
                var src = originalVideo.currentSrc || originalVideo.src;
                var currentTime = originalVideo.currentTime;
                var wasPaused = originalVideo.paused;

                pipOriginal = originalVideo;
                originalVideo.pause();

                var uid = 'md-pip-' + (originalVideo.id || 'video');
                var playIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
                var pauseIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
                var backIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>';

                pipContainer = document.createElement('div');
                pipContainer.className = 'md-video-pip';
                pipContainer.id = uid;
                pipContainer.innerHTML = '<div class="md-pip-header" data-pip-drag="1">' +
                    '<span class="md-pip-title">视频</span>' +
                    '<button type="button" class="md-pip-back" title="回到原位" aria-label="回到原位">' + backIcon + '</button>' +
                    '<button type="button" class="md-pip-close" title="关闭" aria-label="关闭">×</button>' +
                    '</div>' +
                    '<div class="md-pip-video-wrap">' +
                    '<video class="md-pip-video" src="' + src + '" preload="auto" playsinline></video>' +
                    '</div>' +
                    '<div class="md-pip-controls">' +
                    '<button type="button" class="md-pip-play-btn" aria-label="播放">' + (wasPaused ? playIcon : pauseIcon) + '</button>' +
                    '<div class="md-pip-progress"><div class="md-pip-progress-fill"></div></div>' +
                    '<span class="md-pip-time">00:00 / 00:00</span>' +
                    '</div>';

                document.body.appendChild(pipContainer);

                pipVideo = pipContainer.querySelector('.md-pip-video');
                pipVideo.currentTime = currentTime;
                if (!wasPaused) pipVideo.play().catch(function () {});

                pipVideo.addEventListener('timeupdate', function () {
                    if (pipOriginal) pipOriginal.currentTime = pipVideo.currentTime;
                    updatePipProgress();
                });
                pipVideo.addEventListener('play', updatePipPlayBtn);
                pipVideo.addEventListener('pause', updatePipPlayBtn);
                pipVideo.addEventListener('ended', function () {
                    updatePipPlayBtn();
                    if (pipOriginal) pipOriginal.currentTime = 0;
                });

                pipContainer.querySelector('.md-pip-play-btn').addEventListener('click', function () {
                    if (pipVideo.paused) {
                        pipVideo.play().catch(function () {});
                    } else {
                        pipVideo.pause();
                    }
                });

                pipContainer.querySelector('.md-pip-progress').addEventListener('click', function (e) {
                    if (!pipVideo || !pipVideo.duration) return;
                    var rect = this.getBoundingClientRect();
                    var pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
                    pipVideo.currentTime = pct * pipVideo.duration;
                });

                pipContainer.querySelector('.md-pip-back').addEventListener('click', function () {
                    closePip(true);
                });

                pipContainer.querySelector('.md-pip-close').addEventListener('click', function () {
                    closePip(false);
                });

                initPipDrag();
                updatePipProgress();
            }

            function updatePipProgress() {
                if (!pipContainer || !pipVideo) return;
                var fill = pipContainer.querySelector('.md-pip-progress-fill');
                var progressBar = pipContainer.querySelector('.md-pip-progress');
                var timeEl = pipContainer.querySelector('.md-pip-time');
                var duration = pipVideo.duration || 0;
                var current = pipVideo.currentTime || 0;
                if (duration) {
                    var pct = current / duration * 100;
                    fill.style.width = pct + '%';
                    if (progressBar) progressBar.style.setProperty('--pip-progress-pct', pct + '%');
                    timeEl.textContent = formatTime(current) + ' / ' + formatTime(duration);
                }
            }

            function updatePipPlayBtn() {
                if (!pipContainer || !pipVideo) return;
                var btn = pipContainer.querySelector('.md-pip-play-btn');
                var playIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
                var pauseIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
                btn.innerHTML = pipVideo.paused ? playIcon : pauseIcon;
            }

            function closePip(scrollBack) {
                if (!pipContainer || !pipOriginal || !pipVideo) return;

                pipOriginal.currentTime = pipVideo.currentTime;
                var wasPlaying = !pipVideo.paused && !pipVideo.ended;

                pipContainer.remove();
                pipContainer = null;
                pipVideo = null;

                var orig = pipOriginal;
                pipOriginal = null;

                if (scrollBack) {
                    orig.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    setTimeout(function () {
                        if (wasPlaying) orig.play().catch(function () {});
                    }, 600);
                } else {
                    if (wasPlaying) orig.play().catch(function () {});
                }
            }

            function initPipDrag() {
                if (!pipContainer) return;
                var header = pipContainer.querySelector('.md-pip-header');
                if (!header) return;

                header.addEventListener('mousedown', function (e) {
                    if (e.button !== 0) return;
                    var rect = pipContainer.getBoundingClientRect();
                    pipDragState = {
                        startX: e.clientX,
                        startY: e.clientY,
                        startLeft: rect.left,
                        startTop: rect.top
                    };
                    pipContainer.style.transition = 'none';
                    e.preventDefault();
                });
            }

            document.addEventListener('mousemove', function (e) {
                if (!pipDragState || !pipContainer) return;
                var dx = e.clientX - pipDragState.startX;
                var dy = e.clientY - pipDragState.startY;
                var newLeft = pipDragState.startLeft + dx;
                var newTop = pipDragState.startTop + dy;
                var winW = window.innerWidth;
                var winH = window.innerHeight;
                var elW = pipContainer.offsetWidth;
                var elH = pipContainer.offsetHeight;
                newLeft = Math.max(0, Math.min(winW - elW, newLeft));
                newTop = Math.max(0, Math.min(winH - elH, newTop));
                pipContainer.style.left = newLeft + 'px';
                pipContainer.style.top = newTop + 'px';
                pipContainer.style.right = 'auto';
                pipContainer.style.bottom = 'auto';
            });

            document.addEventListener('mouseup', function () {
                if (pipDragState && pipContainer) {
                    pipDragState = null;
                    pipContainer.style.transition = '';
                }
            });

            function initVideoPip() {
                if (pipObserver) {
                    pipObserver.disconnect();
                }

                pipObserver = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        var video = entry.target;
                        var pipMode = video.dataset.pipMode || 'auto';
                        if (pipMode === 'off') return;
                        if (pipMode === 'manual') return;

                        if (!entry.isIntersecting && !video.paused && !pipContainer) {
                            createPip(video);
                        } else if (entry.isIntersecting && pipContainer && pipOriginal === video) {
                            closePip(false);
                        }
                    });
                }, { threshold: 0.1 });

                document.querySelectorAll('video[data-pip-video]').forEach(function (video) {
                    pipObserver.observe(video);
                });
            }

            document.addEventListener('click', function (e) {
                var playBtn = e.target.closest('[data-video-play]');
                if (playBtn) {
                    var container = playBtn.closest('.md-directive-video');
                    if (!container) return;
                    var overlay = container.querySelector('.md-video-overlay');
                    var posterImg = container.querySelector('.md-video-poster-img');
                    var video = container.querySelector('.md-video-element');
                    if (overlay) overlay.classList.add('is-hidden');
                    if (posterImg) posterImg.style.display = 'none';
                    if (video) {
                        video.classList.add('is-ready');
                        video.setAttribute('controls', '');
                        video.play().catch(function () {});
                    }
                    return;
                }
                var pipBtn = e.target.closest('[data-video-pip]');
                if (pipBtn) {
                    var container = pipBtn.closest('.md-directive-video');
                    if (!container) return;
                    var video = container.querySelector('.md-video-element');
                    if (video && !pipContainer) {
                        createPip(video);
                    }
                    return;
                }
            });

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initVideoPip);
            } else {
                initVideoPip();
            }
            document.addEventListener('astro:page-load', initVideoPip);
        })();
        </script>
    </head>
    <body class="bg-main text-main">
        {isArticle && (
            <div id="reading-progress" class="fixed top-0 left-0 h-[2px] bg-accent z-[9999] w-0 transition-none"></div>
        )}
        <slot name="splash" />

        <div id="main-stage" class={splashMode ? 'relative' : ''}>
            {showTopNav && <TopNav articleTitle={articleTitle} commentsEnabled={commentsEnabled} sticky={splashMode} />}
            <Search />

            <div class={`flex items-start justify-center gap-4 lg:gap-8 min-h-screen max-w-7xl mx-auto ${showTopNav ? 'pt-12' : ''}`}>
                {showSidebar && <LeftSidebar />}
                <div class="w-full max-w-3xl flex-shrink-0">
                    <div class="flex flex-col min-h-screen px-4 lg:px-6">
                        <FloatingToolbar showSidebar={showSidebar} showThemeToggle={true} />
                        <main class="mx-auto w-full max-w-3xl grow pt-2">
                            <slot />
                        </main>
                        <Footer />
                    </div>
                </div>

                {showRightSidebar && (
                    <div class="right-sidebar-container hidden xl:block top-14 h-[calc(100vh-3.5rem)] w-48 xl:w-52 2xl:w-56 bg-main overflow-y-auto z-40" style="position: sticky; align-self: flex-start;">
                        <slot name="right-sidebar">
                            <RightSidebar />
                        </slot>
                    </div>
                )}
            </div>
        </div>

        <script is:inline>
            (function () {
                function initProgress() {
                    var bar = document.getElementById('reading-progress');
                    if (!bar) return;
                    function update() {
                        var scrollTop = window.scrollY;
                        var docHeight = document.documentElement.scrollHeight - window.innerHeight;
                        var pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
                        bar.style.width = pct + '%';
                    }
                    window.removeEventListener('scroll', update);
                    window.addEventListener('scroll', update, { passive: true });
                    update();
                }
                document.addEventListener('astro:page-load', initProgress);
                initProgress();
            })();
        </script>

        <script is:inline>
            (function() {
                function initTabs() {
                    document.querySelectorAll('.md-directive-tabs').forEach(function(container) {
                        if (container.dataset.tabsInitialized) return;
                        container.dataset.tabsInitialized = 'true';
                        var nav = container.querySelector('.md-tabs-nav');
                        var content = container.querySelector('.md-tabs-content');
                        var buttons = nav ? Array.from(nav.querySelectorAll('.md-tab-btn')) : [];
                        var panes = content ? Array.from(content.children).filter(function(el){ return el.classList.contains('md-tab-pane'); }) : [];
                        buttons.forEach(function(btn, idx) {
                            btn.addEventListener('click', function(e) {
                                e.preventDefault();
                                buttons.forEach(function(b) {
                                    b.classList.remove('md-tab-active');
                                    b.setAttribute('aria-selected', 'false');
                                });
                                btn.classList.add('md-tab-active');
                                btn.setAttribute('aria-selected', 'true');
                                panes.forEach(function(p) { p.classList.remove('md-tab-visible'); });
                                if (panes[idx]) panes[idx].classList.add('md-tab-visible');
                            });
                        });
                    });
                }
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initTabs);
                } else {
                    initTabs();
                }
                document.addEventListener('astro:page-load', initTabs);
            })();
        </script>

        <SiteAgent />
        {siteConfig.floatingAudio?.enabled && <FloatingAudioPlayer />}

        <script>
            import mediumZoom from 'medium-zoom';

            function initZoom() {
                mediumZoom('img[data-zoomable="1"]', {
                    background: 'rgba(0, 0, 0, 0.85)',
                    margin: 24,
                    onOpen: (target) => {
                        const wrap = target.closest('.md-photo-img-wrap');
                        if (wrap) {
                            wrap.dataset.prevOverflow = wrap.style.overflow;
                            wrap.style.overflow = 'visible';
                        }
                    },
                    onClose: (target) => {
                        const wrap = target.closest('.md-photo-img-wrap');
                        if (wrap && wrap.dataset.prevOverflow !== undefined) {
                            wrap.style.overflow = wrap.dataset.prevOverflow;
                            delete wrap.dataset.prevOverflow;
                        }
                    },
                });
            }

            document.addEventListener('astro:page-load', initZoom);
            if (document.readyState !== 'loading') {
                initZoom();
            }
        </script>

        <script is:inline>
            (function () {
                function initGhCards() {
                    document.querySelectorAll('.md-directive-ghcard').forEach(function (card) {
                        if (card.dataset.ghcardInitialized) return;
                        card.dataset.ghcardInitialized = 'true';

                        var api = card.dataset.api;
                        if (!api) return;

                        var fill = function (data) {
                            card.querySelectorAll('[data-key]').forEach(function (el) {
                                var key = el.dataset.key;
                                if (data[key] !== undefined && data[key] !== null) {
                                    if (el.tagName === 'IMG') {
                                        el.src = data[key];
                                    } else {
                                        el.textContent = data[key];
                                    }
                                }
                            });
                            // if bio element doesn't exist but API returns bio, create it
                            var bioEl = card.querySelector('[data-key="bio"]');
                            if (!bioEl && data.bio) {
                                var usernameEl = card.querySelector('.md-ghcard-username');
                                if (usernameEl) {
                                    bioEl = document.createElement('p');
                                    bioEl.className = 'md-ghcard-bio';
                                    bioEl.dataset.key = 'bio';
                                    bioEl.textContent = data.bio;
                                    usernameEl.parentNode.insertBefore(bioEl, usernameEl.nextSibling);
                                }
                            }
                        };

                        fetch(api)
                            .then(function (res) { return res.json(); })
                            .then(function (data) {
                                fill(data);
                                // fetch latest tag for repo cards
                                var tagsApi = card.dataset.tagsApi;
                                if (tagsApi && Array.isArray(data)) {
                                    return fetch(tagsApi)
                                        .then(function (res) { return res.json(); })
                                        .then(function (tags) {
                                            if (Array.isArray(tags) && tags.length > 0) {
                                                var tagEl = card.querySelector('[data-key="latest-tag-name"]');
                                                if (tagEl) tagEl.textContent = tags[0].name;
                                            }
                                        });
                                } else if (tagsApi) {
                                    return fetch(tagsApi)
                                        .then(function (res) { return res.json(); })
                                        .then(function (tags) {
                                            if (Array.isArray(tags) && tags.length > 0) {
                                                var tagEl = card.querySelector('[data-key="latest-tag-name"]');
                                                if (tagEl) tagEl.textContent = tags[0].name;
                                            }
                                        });
                                }
                            })
                            .catch(function () {});
                    });
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initGhCards);
                } else {
                    initGhCards();
                }
                document.addEventListener('astro:page-load', initGhCards);
            })();
        </script>

        <!-- 图片懒加载淡入 -->
        <script is:inline>
        (function() {
            function initLazyImages() {
                document.querySelectorAll('img[loading="lazy"]').forEach(function(img) {
                    if (img.complete) {
                        img.classList.add('img-loaded');
                    } else {
                        img.addEventListener('load', function() {
                            img.classList.add('img-loaded');
                        });
                        img.addEventListener('error', function() {
                            img.classList.add('img-loaded');
                        });
                    }
                });
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initLazyImages);
            } else {
                initLazyImages();
            }
            document.addEventListener('astro:page-load', initLazyImages);
        })();
        </script>

        <!-- 滚动显现（reveal）-->
        <script is:inline src="/js/reveal-scroll.js"></script>
        <script is:inline src="/js/search-hotkey.js"></script>
    </body>
</html>
