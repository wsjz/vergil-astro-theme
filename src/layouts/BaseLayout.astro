---
import { ViewTransitions } from 'astro:transitions';
import BaseHead, { type Props as HeadProps } from '../components/base/BaseHead.astro';
import Footer from '../components/base/Footer.astro';
import LeftSidebar from '../components/base/LeftSidebar.astro';
import RightSidebar from '../components/base/RightSidebar.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import TopNav from '../components/base/HeaderNav.astro';
import Search from '../components/widgets/Search.astro';
import SiteAgent from '../components/widgets/SiteAgent.astro';
import FloatingAudioPlayer from '../components/widgets/FloatingAudioPlayer.astro';
import siteConfig from '../data/site-config';

export type Props = HeadProps & { showSidebar?: boolean; showRightSidebar?: boolean; showTopNav?: boolean; articleTitle?: string; commentsEnabled?: boolean; splashMode?: boolean; rightSidebarConfig?: string[] };

const { showSidebar = true, showRightSidebar = true, showTopNav = true, articleTitle = '', commentsEnabled = false, splashMode = false, rightSidebarConfig, ...head } = Astro.props;
const minimalEnabled = siteConfig.views?.minimal?.enabled === true;
const isArticle = head.pageType === 'article';
---

<!doctype html>
<html lang="en" class="wrap-break-words antialiased">
    <head>
        <BaseHead {...head} />
        {splashMode && (
            <style is:inline>
                /* 首页 Splash CSS scroll-snap：在 splash 和主内容交界处自然吸附 */
                html {
                    scroll-snap-type: y proximity;
                }
                #main-stage {
                    scroll-snap-align: start;
                }
            </style>
        )}
        <script is:inline>
            (function() {
                if (location.pathname !== '/') return;
                if ('scrollRestoration' in history) {
                    history.scrollRestoration = 'manual';
                }
                window.scrollTo(0, 0);
            })();
        </script>
        <script is:inline>
            (function() {
                try {
                    var scheme = localStorage.getItem('colorScheme') || 'C';
                    var isDark = localStorage.getItem('darkMode');
                    document.documentElement.setAttribute('data-theme', scheme);
                    if (isDark === 'true' || (isDark === null && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                        document.documentElement.classList.add('dark');
                    }
                } catch(e) {}
            })();
        </script>
        <ViewTransitions />
        <script is:inline src="/theme-toggle.js"></script>
        <script is:inline>
            (function () {
                document.addEventListener('click', function (e) {
                    var btn = e.target.closest('.md-copy-btn');
                    if (!btn) return;
                    var input = btn.parentElement.querySelector('.md-copy-input');
                    if (!input && btn.dataset.copyTarget) {
                        input = document.getElementById(btn.dataset.copyTarget);
                    }
                    if (!input) return;
                    navigator.clipboard.writeText(input.value).then(function () {
                        var original = btn.innerHTML;
                        btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>';
                        btn.classList.add('md-copy-success');
                        setTimeout(function () {
                            btn.innerHTML = original;
                            btn.classList.remove('md-copy-success');
                        }, 1500);
                    });
                });
            })();
        </script>
        <script is:inline>
            (function () {
                function base64ToBuffer(base64) {
                    return Uint8Array.from(atob(base64), function (c) { return c.charCodeAt(0); });
                }
                async function deriveKey(password, salt) {
                    var encoder = new TextEncoder();
                    var keyMaterial = await crypto.subtle.importKey(
                        'raw', encoder.encode(password), 'PBKDF2', false, ['deriveKey']
                    );
                    return crypto.subtle.deriveKey(
                        { name: 'PBKDF2', salt: salt, iterations: 100000, hash: 'SHA-256' },
                        keyMaterial, { name: 'AES-CBC', length: 256 }, false, ['decrypt']
                    );
                }
                async function decryptPrivate(payload, password) {
                    var data = base64ToBuffer(payload);
                    var salt = data.slice(0, 16);
                    var iv = data.slice(16, 32);
                    var ciphertext = data.slice(32);
                    var key = await deriveKey(password, salt);
                    var decrypted = await crypto.subtle.decrypt(
                        { name: 'AES-CBC', iv: iv }, key, ciphertext
                    );
                    return new TextDecoder().decode(decrypted);
                }
                document.addEventListener('click', async function (e) {
                    var toggle = e.target.closest('.md-private-toggle');
                    if (toggle) {
                        var container = toggle.closest('.md-directive-private');
                        if (!container) return;
                        var input = container.querySelector('.md-private-input');
                        if (!input) return;
                        var isPassword = input.type === 'password';
                        input.type = isPassword ? 'text' : 'password';
                        toggle.classList.toggle('is-visible', input.type === 'text');
                        return;
                    }
                    var btn = e.target.closest('.md-private-btn');
                    if (btn) {
                        var container = btn.closest('.md-directive-private');
                        if (!container) return;
                        var payload = container.dataset.payload;
                        var input = container.querySelector('.md-private-input');
                        var locked = container.querySelector('.md-private-locked');
                        var unlocked = container.querySelector('.md-private-unlocked');
                        var content = container.querySelector('.md-private-content');
                        var error = container.querySelector('.md-private-error');
                        if (!input || !payload) return;
                        var password = input.value;
                        if (!password) { input.focus(); return; }
                        try {
                            var html = await decryptPrivate(payload, password);
                            content.innerHTML = html;
                            locked.style.display = 'none';
                            unlocked.style.display = 'block';
                            error.style.display = 'none';
                        } catch (err) {
                            error.style.display = 'block';
                            input.value = '';
                            input.focus();
                        }
                        return;
                    }
                    var lockBtn = e.target.closest('.md-private-lock-btn');
                    if (lockBtn) {
                        var container = lockBtn.closest('.md-directive-private');
                        if (!container) return;
                        var locked = container.querySelector('.md-private-locked');
                        var unlocked = container.querySelector('.md-private-unlocked');
                        var content = container.querySelector('.md-private-content');
                        var input = container.querySelector('.md-private-input');
                        var error = container.querySelector('.md-private-error');
                        if (content) content.innerHTML = '';
                        if (unlocked) unlocked.style.display = 'none';
                        if (locked) locked.style.display = 'flex';
                        if (input) input.value = '';
                        if (error) error.style.display = 'none';
                        return;
                    }
                });
                document.addEventListener('keydown', function (e) {
                    if (e.key !== 'Enter') return;
                    var input = e.target.closest('.md-private-input');
                    if (!input) return;
                    var container = input.closest('.md-directive-private');
                    if (!container) return;
                    var btn = container.querySelector('.md-private-btn');
                    if (btn) btn.click();
                });
            })();
        </script>
        <script is:inline>
            (function () {
                function formatTime(s) {
                    if (!isFinite(s) || s < 0) return '00:00';
                    var m = Math.floor(s / 60);
                    var sec = Math.floor(s % 60);
                    return (m < 10 ? '0' : '') + m + ':' + (sec < 10 ? '0' : '') + sec;
                }
                function drawVoiceWave(canvas, duration, isPlaying, progress) {
                    var ctx = canvas.getContext('2d');
                    var dpr = window.devicePixelRatio || 1;
                    var w = canvas.clientWidth || 160;
                    var h = canvas.clientHeight || 24;
                    canvas.width = w * dpr;
                    canvas.height = h * dpr;
                    ctx.scale(dpr, dpr);
                    ctx.clearRect(0, 0, w, h);
                    var bars = Math.floor(w / 5);
                    var barW = 2;
                    var gap = 3;
                    for (var i = 0; i < bars; i++) {
                        var barH = 4 + Math.random() * (h - 8);
                        var x = i * (barW + gap);
                        var y = (h - barH) / 2;
                        var barProgress = (x + barW / 2) / w;
                        var isActive = isPlaying && barProgress <= progress;
                        ctx.fillStyle = isActive ? 'var(--accent-color, #4a7c59)' : 'rgba(0,0,0,0.12)';
                        if (canvas.closest('[data-theme="dark"]') || document.documentElement.classList.contains('dark')) {
                            ctx.fillStyle = isActive ? 'var(--accent-color, #4a7c59)' : 'rgba(255,255,255,0.15)';
                        }
                        ctx.beginPath();
                        ctx.roundRect(x, y, barW, barH, 1);
                        ctx.fill();
                    }
                }
                var activeAudio = null;
                var activeVoice = null;
                document.addEventListener('click', function (e) {
                    var player = e.target.closest('.md-audio-player');
                    if (player) {
                        var container = player.closest('.md-directive-audio');
                        var audioEl = container.querySelector('audio');
                        var playBtn = player.querySelector('.md-audio-play');
                        var pauseBtn = player.querySelector('.md-audio-pause');
                        var progressBar = player.querySelector('.md-audio-progress-bar');
                        var progressFill = player.querySelector('.md-audio-progress-fill');
                        var timeCurrent = player.querySelector('.md-audio-time-current');
                        var timeTotal = player.querySelector('.md-audio-time-total');
                        var clickedPlay = e.target.closest('.md-audio-btn');
                        var clickedBar = e.target.closest('.md-audio-progress-bar');
                        if (!audioEl._inited) {
                            audioEl._inited = true;
                            audioEl.addEventListener('loadedmetadata', function () {
                                timeTotal.textContent = formatTime(audioEl.duration);
                            });
                            audioEl.addEventListener('timeupdate', function () {
                                if (!audioEl.duration) return;
                                var pct = audioEl.currentTime / audioEl.duration;
                                progressFill.style.width = (pct * 100) + '%';
                                timeCurrent.textContent = formatTime(audioEl.currentTime);
                            });
                            audioEl.addEventListener('ended', function () {
                                playBtn.style.display = 'inline-flex';
                                pauseBtn.style.display = 'none';
                                progressFill.style.width = '0%';
                                timeCurrent.textContent = '00:00';
                                if (activeAudio === audioEl) activeAudio = null;
                            });
                        }
                        if (clickedPlay) {
                            if (audioEl.paused) {
                                if (activeAudio && activeAudio !== audioEl) { activeAudio.pause(); }
                                audioEl.play();
                                playBtn.style.display = 'none';
                                pauseBtn.style.display = 'inline-flex';
                                activeAudio = audioEl;
                            } else {
                                audioEl.pause();
                                playBtn.style.display = 'inline-flex';
                                pauseBtn.style.display = 'none';
                                if (activeAudio === audioEl) activeAudio = null;
                            }
                            return;
                        }
                        if (clickedBar && audioEl.duration) {
                            var rect = progressBar.getBoundingClientRect();
                            var pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
                            audioEl.currentTime = pct * audioEl.duration;
                            progressFill.style.width = (pct * 100) + '%';
                        }
                        return;
                    }
                    var voicePlayer = e.target.closest('.md-audio-voice-player');
                    if (voicePlayer) {
                        var container = voicePlayer.closest('.md-directive-audio');
                        var src = container.dataset.src;
                        var playIcon = voicePlayer.querySelector('.md-voice-icon-play');
                        var pauseIcon = voicePlayer.querySelector('.md-voice-icon-pause');
                        var canvas = voicePlayer.querySelector('.md-voice-wave');
                        var duration = parseInt(container.dataset.duration, 10) || 0;
                        if (!voicePlayer._audio) {
                            voicePlayer._audio = new Audio(src);
                            voicePlayer._audio.addEventListener('ended', function () {
                                playIcon.style.display = 'inline-flex';
                                pauseIcon.style.display = 'none';
                                if (activeVoice === voicePlayer._audio) activeVoice = null;
                            });
                            voicePlayer._audio.addEventListener('timeupdate', function () {
                                var progress = voicePlayer._audio.duration ? voicePlayer._audio.currentTime / voicePlayer._audio.duration : 0;
                                drawVoiceWave(canvas, duration, true, progress);
                            });
                        }
                        var audio = voicePlayer._audio;
                        if (audio.paused) {
                            if (activeVoice && activeVoice !== audio) { activeVoice.pause(); }
                            audio.play();
                            playIcon.style.display = 'none';
                            pauseIcon.style.display = 'inline-flex';
                            activeVoice = audio;
                            drawVoiceWave(canvas, duration, true, 0);
                        } else {
                            audio.pause();
                            playIcon.style.display = 'inline-flex';
                            pauseIcon.style.display = 'none';
                            if (activeVoice === audio) activeVoice = null;
                            drawVoiceWave(canvas, duration, false, 0);
                        }
                        return;
                    }
                });

                // Autoplay support for inline audio players
                function initInlineAudioAutoplay() {
                    document.querySelectorAll('.md-audio-player[data-autoplay="1"]').forEach(function (player) {
                        var container = player.closest('.md-directive-audio');
                        if (!container) return;
                        var audioEl = container.querySelector('audio');
                        var playBtn = player.querySelector('.md-audio-play');
                        var pauseBtn = player.querySelector('.md-audio-pause');
                        var progressBar = player.querySelector('.md-audio-progress-bar');
                        var progressFill = player.querySelector('.md-audio-progress-fill');
                        var timeCurrent = player.querySelector('.md-audio-time-current');
                        var timeTotal = player.querySelector('.md-audio-time-total');
                        if (!audioEl || !playBtn || !pauseBtn) return;
                        if (!audioEl._inited) {
                            audioEl._inited = true;
                            audioEl.addEventListener('loadedmetadata', function () {
                                timeTotal.textContent = formatTime(audioEl.duration);
                            });
                            audioEl.addEventListener('timeupdate', function () {
                                if (!audioEl.duration) return;
                                var pct = audioEl.currentTime / audioEl.duration;
                                progressFill.style.width = (pct * 100) + '%';
                                timeCurrent.textContent = formatTime(audioEl.currentTime);
                            });
                            audioEl.addEventListener('ended', function () {
                                playBtn.style.display = 'inline-flex';
                                pauseBtn.style.display = 'none';
                                progressFill.style.width = '0%';
                                timeCurrent.textContent = '00:00';
                                if (activeAudio === audioEl) activeAudio = null;
                            });
                        }
                        audioEl.play().then(function () {
                            playBtn.style.display = 'none';
                            pauseBtn.style.display = 'inline-flex';
                            if (activeAudio && activeAudio !== audioEl) activeAudio.pause();
                            activeAudio = audioEl;
                        }).catch(function () {});
                    });
                }
                if (document.readyState !== 'loading') initInlineAudioAutoplay();
                document.addEventListener('astro:page-load', initInlineAudioAutoplay);
            })();
        </script>
        <script is:inline>
        (function () {
            function formatTime(s) {
                if (!isFinite(s) || s < 0) return '00:00';
                var m = Math.floor(s / 60);
                var sec = Math.floor(s % 60);
                return (m < 10 ? '0' : '') + m + ':' + (sec < 10 ? '0' : '') + sec;
            }

            var pipContainer = null;
            var pipVideo = null;
            var pipOriginal = null;
            var pipObserver = null;
            var pipDragState = null;

            function createPip(originalVideo) {
                if (pipContainer) return;
                var src = originalVideo.currentSrc || originalVideo.src;
                var currentTime = originalVideo.currentTime;
                var wasPaused = originalVideo.paused;

                pipOriginal = originalVideo;
                originalVideo.pause();

                var uid = 'md-pip-' + (originalVideo.id || 'video');
                var playIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
                var pauseIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
                var backIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5v0a5.5 5.5 0 0 1-5.5 5.5H11"/></svg>';

                pipContainer = document.createElement('div');
                pipContainer.className = 'md-video-pip';
                pipContainer.id = uid;
                pipContainer.innerHTML = '<div class="md-pip-header" data-pip-drag="1">' +
                    '<span class="md-pip-title">视频</span>' +
                    '<button type="button" class="md-pip-back" title="回到原位" aria-label="回到原位">' + backIcon + '</button>' +
                    '<button type="button" class="md-pip-close" title="关闭" aria-label="关闭">×</button>' +
                    '</div>' +
                    '<div class="md-pip-video-wrap">' +
                    '<video class="md-pip-video" src="' + src + '" preload="auto" playsinline></video>' +
                    '</div>' +
                    '<div class="md-pip-controls">' +
                    '<button type="button" class="md-pip-play-btn" aria-label="播放">' + (wasPaused ? playIcon : pauseIcon) + '</button>' +
                    '<div class="md-pip-progress"><div class="md-pip-progress-fill"></div></div>' +
                    '<span class="md-pip-time">00:00 / 00:00</span>' +
                    '</div>';

                document.body.appendChild(pipContainer);

                pipVideo = pipContainer.querySelector('.md-pip-video');
                pipVideo.currentTime = currentTime;
                if (!wasPaused) pipVideo.play().catch(function () {});

                pipVideo.addEventListener('timeupdate', function () {
                    if (pipOriginal) pipOriginal.currentTime = pipVideo.currentTime;
                    updatePipProgress();
                });
                pipVideo.addEventListener('play', updatePipPlayBtn);
                pipVideo.addEventListener('pause', updatePipPlayBtn);
                pipVideo.addEventListener('ended', function () {
                    updatePipPlayBtn();
                    if (pipOriginal) pipOriginal.currentTime = 0;
                });

                pipContainer.querySelector('.md-pip-play-btn').addEventListener('click', function () {
                    if (pipVideo.paused) {
                        pipVideo.play().catch(function () {});
                    } else {
                        pipVideo.pause();
                    }
                });

                pipContainer.querySelector('.md-pip-progress').addEventListener('click', function (e) {
                    if (!pipVideo || !pipVideo.duration) return;
                    var rect = this.getBoundingClientRect();
                    var pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
                    pipVideo.currentTime = pct * pipVideo.duration;
                });

                pipContainer.querySelector('.md-pip-back').addEventListener('click', function () {
                    closePip(true);
                });

                pipContainer.querySelector('.md-pip-close').addEventListener('click', function () {
                    closePip(false);
                });

                initPipDrag();
                updatePipProgress();
            }

            function updatePipProgress() {
                if (!pipContainer || !pipVideo) return;
                var fill = pipContainer.querySelector('.md-pip-progress-fill');
                var progressBar = pipContainer.querySelector('.md-pip-progress');
                var timeEl = pipContainer.querySelector('.md-pip-time');
                var duration = pipVideo.duration || 0;
                var current = pipVideo.currentTime || 0;
                if (duration) {
                    var pct = current / duration * 100;
                    fill.style.width = pct + '%';
                    if (progressBar) progressBar.style.setProperty('--pip-progress-pct', pct + '%');
                    timeEl.textContent = formatTime(current) + ' / ' + formatTime(duration);
                }
            }

            function updatePipPlayBtn() {
                if (!pipContainer || !pipVideo) return;
                var btn = pipContainer.querySelector('.md-pip-play-btn');
                var playIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
                var pauseIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
                btn.innerHTML = pipVideo.paused ? playIcon : pauseIcon;
            }

            function closePip(scrollBack) {
                if (!pipContainer || !pipOriginal || !pipVideo) return;

                pipOriginal.currentTime = pipVideo.currentTime;
                var wasPlaying = !pipVideo.paused && !pipVideo.ended;

                pipContainer.remove();
                pipContainer = null;
                pipVideo = null;

                var orig = pipOriginal;
                pipOriginal = null;

                if (scrollBack) {
                    orig.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    setTimeout(function () {
                        if (wasPlaying) orig.play().catch(function () {});
                    }, 600);
                } else {
                    if (wasPlaying) orig.play().catch(function () {});
                }
            }

            function initPipDrag() {
                if (!pipContainer) return;
                var header = pipContainer.querySelector('.md-pip-header');
                if (!header) return;

                header.addEventListener('mousedown', function (e) {
                    if (e.button !== 0) return;
                    var rect = pipContainer.getBoundingClientRect();
                    pipDragState = {
                        startX: e.clientX,
                        startY: e.clientY,
                        startLeft: rect.left,
                        startTop: rect.top
                    };
                    pipContainer.style.transition = 'none';
                    e.preventDefault();
                });
            }

            document.addEventListener('mousemove', function (e) {
                if (!pipDragState || !pipContainer) return;
                var dx = e.clientX - pipDragState.startX;
                var dy = e.clientY - pipDragState.startY;
                var newLeft = pipDragState.startLeft + dx;
                var newTop = pipDragState.startTop + dy;
                var winW = window.innerWidth;
                var winH = window.innerHeight;
                var elW = pipContainer.offsetWidth;
                var elH = pipContainer.offsetHeight;
                newLeft = Math.max(0, Math.min(winW - elW, newLeft));
                newTop = Math.max(0, Math.min(winH - elH, newTop));
                pipContainer.style.left = newLeft + 'px';
                pipContainer.style.top = newTop + 'px';
                pipContainer.style.right = 'auto';
                pipContainer.style.bottom = 'auto';
            });

            document.addEventListener('mouseup', function () {
                if (pipDragState && pipContainer) {
                    pipDragState = null;
                    pipContainer.style.transition = '';
                }
            });

            function initVideoPip() {
                if (pipObserver) {
                    pipObserver.disconnect();
                }

                pipObserver = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        var video = entry.target;
                        var pipMode = video.dataset.pipMode || 'auto';
                        if (pipMode === 'off') return;
                        if (pipMode === 'manual') return;

                        if (!entry.isIntersecting && !video.paused && !pipContainer) {
                            createPip(video);
                        } else if (entry.isIntersecting && pipContainer && pipOriginal === video) {
                            closePip(false);
                        }
                    });
                }, { threshold: 0.1 });

                document.querySelectorAll('video[data-pip-video]').forEach(function (video) {
                    pipObserver.observe(video);
                });
            }

            document.addEventListener('click', function (e) {
                var playBtn = e.target.closest('[data-video-play]');
                if (playBtn) {
                    var container = playBtn.closest('.md-directive-video');
                    if (!container) return;
                    var overlay = container.querySelector('.md-video-overlay');
                    var posterImg = container.querySelector('.md-video-poster-img');
                    var video = container.querySelector('.md-video-element');
                    if (overlay) overlay.classList.add('is-hidden');
                    if (posterImg) posterImg.style.display = 'none';
                    if (video) {
                        video.classList.add('is-ready');
                        video.setAttribute('controls', '');
                        video.play().catch(function () {});
                    }
                    return;
                }
                var pipBtn = e.target.closest('[data-video-pip]');
                if (pipBtn) {
                    var container = pipBtn.closest('.md-directive-video');
                    if (!container) return;
                    var video = container.querySelector('.md-video-element');
                    if (video && !pipContainer) {
                        createPip(video);
                    }
                    return;
                }
            });

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initVideoPip);
            } else {
                initVideoPip();
            }
            document.addEventListener('astro:page-load', initVideoPip);
        })();
        </script>
    </head>
    <body class="bg-main text-main">
        {isArticle && (
            <div id="reading-progress" class="fixed top-0 left-0 h-[2px] bg-accent z-[9999] w-0 transition-none"></div>
        )}
        <slot name="splash" />

        <div id="main-stage" class={splashMode ? 'relative mt-[100vh] translate-y-0' : ''}>
            {showTopNav && <TopNav articleTitle={articleTitle} commentsEnabled={commentsEnabled} sticky={splashMode} />}
            <Search />

            <div class={`flex min-h-screen ${showTopNav ? 'pt-16' : ''}`}>
                {showSidebar && <LeftSidebar />}
                <div class="flex-1 lg:ml-[calc(14rem+5%+4px)] xl:ml-[calc(15rem+5%+4px)] xl:mr-[calc(12rem+5%+4px)] 2xl:mr-[calc(14rem+5%+4px)]">
                    <div class="flex flex-col min-h-screen px-4 lg:px-6">
                        <div class="flex items-center justify-end gap-3 py-4">
                            {minimalEnabled && (
                                <a
                                    href="/views/minimal/"
                                    id="minimal-entry-btn"
                                    class="text-xs text-secondary hover:text-accent transition-colors flex items-center gap-1"
                                    title="进入沉浸模式"
                                >
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/><path d="M8 7h6"/><path d="M8 11h8"/></svg>
                                    <span>沉浸</span>
                                </a>
                            )}
                            <ThemeToggle />
                        </div>
                        {minimalEnabled && (
                            <script is:inline>
                                (function(){
                                    var btn = document.getElementById('minimal-entry-btn');
                                    if(!btn) return;
                                    btn.addEventListener('click', function(e){
                                        var path = location.pathname;
                                        if(path.startsWith('/blog/') || path.startsWith('/docs/')){
                                            e.preventDefault();
                                            location.href = '/views/minimal' + path;
                                        }
                                    });
                                })();
                            </script>
                        )}
                        <main class="mx-auto w-full max-w-3xl grow">
                            <slot />
                        </main>
                        <Footer />
                    </div>
                </div>

                {showRightSidebar && (
                    <div class="right-sidebar-container hidden xl:block fixed right-[5%] top-14 h-[calc(100vh-3.5rem)] w-48 xl:w-52 2xl:w-56 bg-main overflow-y-auto z-40">
                        <slot name="right-sidebar">
                            <RightSidebar config={rightSidebarConfig} />
                        </slot>
                    </div>
                )}
            </div>
        </div>

        <script is:inline>
            (function () {
                function initProgress() {
                    var bar = document.getElementById('reading-progress');
                    if (!bar) return;

                    var main = document.querySelector('main');
                    var ticking = false;

                    function update() {
                        if (!main) {
                            bar.style.width = '0%';
                            return;
                        }
                        var scrollTop = window.scrollY;
                        // 以 <main> 内容高度为基准，更准确反映"文章阅读进度"
                        var contentHeight = main.scrollHeight;
                        var viewportH = window.innerHeight;
                        var readableHeight = Math.max(0, contentHeight - viewportH);
                        var pct = readableHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / readableHeight) * 100)) : 0;
                        bar.style.width = pct + '%';
                    }

                    function onScroll() {
                        if (!ticking) {
                            requestAnimationFrame(function() {
                                update();
                                ticking = false;
                            });
                            ticking = true;
                        }
                    }

                    window.removeEventListener('scroll', onScroll);
                    window.addEventListener('scroll', onScroll, { passive: true });
                    // ViewTransitions 后延迟一帧，确保 DOM 已更新
                    requestAnimationFrame(update);
                }
                document.addEventListener('astro:page-load', initProgress);
                initProgress();
            })();
        </script>

        <script is:inline>
            (function() {
                function initTabs() {
                    document.querySelectorAll('.md-directive-tabs').forEach(function(container) {
                        if (container.dataset.tabsInitialized) return;
                        container.dataset.tabsInitialized = 'true';
                        var nav = container.querySelector('.md-tabs-nav');
                        var content = container.querySelector('.md-tabs-content');
                        var buttons = nav ? Array.from(nav.querySelectorAll('.md-tab-btn')) : [];
                        var panes = content ? Array.from(content.children).filter(function(el){ return el.classList.contains('md-tab-pane'); }) : [];
                        buttons.forEach(function(btn, idx) {
                            btn.addEventListener('click', function(e) {
                                e.preventDefault();
                                buttons.forEach(function(b) {
                                    b.classList.remove('md-tab-active');
                                    b.setAttribute('aria-selected', 'false');
                                });
                                btn.classList.add('md-tab-active');
                                btn.setAttribute('aria-selected', 'true');
                                panes.forEach(function(p) { p.classList.remove('md-tab-visible'); });
                                if (panes[idx]) panes[idx].classList.add('md-tab-visible');
                            });
                        });
                    });
                }
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initTabs);
                } else {
                    initTabs();
                }
                document.addEventListener('astro:page-load', initTabs);
            })();
        </script>

        <SiteAgent />
        {siteConfig.floatingAudio?.enabled && <FloatingAudioPlayer />}

        <script>
            // medium-zoom 按需加载：只在页面有可缩放图片时才导入
            let zoomInstance = null;

            async function initZoom() {
                const images = document.querySelectorAll('img[data-zoomable="1"]');
                if (images.length === 0) return;

                const { default: mediumZoom } = await import('medium-zoom');
                zoomInstance = mediumZoom('img[data-zoomable="1"]', {
                    background: 'rgba(0, 0, 0, 0.85)',
                    margin: 24,
                    onOpen: (target) => {
                        const wrap = target.closest('.md-photo-img-wrap');
                        if (wrap) {
                            wrap.dataset.prevOverflow = wrap.style.overflow;
                            wrap.style.overflow = 'visible';
                        }
                    },
                    onClose: (target) => {
                        const wrap = target.closest('.md-photo-img-wrap');
                        if (wrap && wrap.dataset.prevOverflow !== undefined) {
                            wrap.style.overflow = wrap.dataset.prevOverflow;
                            delete wrap.dataset.prevOverflow;
                        }
                    },
                });
            }

            function disposeZoom() {
                if (zoomInstance) {
                    zoomInstance.detach();
                    zoomInstance = null;
                }
            }

            document.addEventListener('astro:page-load', initZoom);
            document.addEventListener('astro:before-swap', disposeZoom);
            if (document.readyState !== 'loading') {
                initZoom();
            }
        </script>

        <script is:inline>
            (function () {
                function initGhCards() {
                    document.querySelectorAll('.md-directive-ghcard').forEach(function (card) {
                        if (card.dataset.ghcardInitialized) return;
                        card.dataset.ghcardInitialized = 'true';

                        var api = card.dataset.api;
                        if (!api) return;

                        // 显示骨架屏
                        card.dataset.loading = 'true';

                        var fill = function (data) {
                            card.querySelectorAll('[data-key]').forEach(function (el) {
                                var key = el.dataset.key;
                                if (data[key] !== undefined && data[key] !== null) {
                                    if (el.tagName === 'IMG') {
                                        el.src = data[key];
                                    } else {
                                        el.textContent = data[key];
                                    }
                                }
                            });
                            // if bio element doesn't exist but API returns bio, create it
                            var bioEl = card.querySelector('[data-key="bio"]');
                            if (!bioEl && data.bio) {
                                var usernameEl = card.querySelector('.md-ghcard-username');
                                if (usernameEl) {
                                    bioEl = document.createElement('p');
                                    bioEl.className = 'md-ghcard-bio';
                                    bioEl.dataset.key = 'bio';
                                    bioEl.textContent = data.bio;
                                    usernameEl.parentNode.insertBefore(bioEl, usernameEl.nextSibling);
                                }
                            }
                        };

                        fetch(api)
                            .then(function (res) { return res.json(); })
                            .then(function (data) {
                                fill(data);
                                // fetch latest tag for repo cards
                                var tagsApi = card.dataset.tagsApi;
                                if (tagsApi && Array.isArray(data)) {
                                    return fetch(tagsApi)
                                        .then(function (res) { return res.json(); })
                                        .then(function (tags) {
                                            if (Array.isArray(tags) && tags.length > 0) {
                                                var tagEl = card.querySelector('[data-key="latest-tag-name"]');
                                                if (tagEl) tagEl.textContent = tags[0].name;
                                            }
                                        });
                                } else if (tagsApi) {
                                    return fetch(tagsApi)
                                        .then(function (res) { return res.json(); })
                                        .then(function (tags) {
                                            if (Array.isArray(tags) && tags.length > 0) {
                                                var tagEl = card.querySelector('[data-key="latest-tag-name"]');
                                                if (tagEl) tagEl.textContent = tags[0].name;
                                            }
                                        });
                                }
                            })
                            .then(function () {
                                // 数据加载完成，移除骨架屏
                                delete card.dataset.loading;
                            })
                            .catch(function () {
                                // 请求失败也移除骨架屏，避免一直闪烁
                                delete card.dataset.loading;
                            });
                    });
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initGhCards);
                } else {
                    initGhCards();
                }
                document.addEventListener('astro:page-load', initGhCards);
            })();
        </script>

        <!-- 图片懒加载淡入 -->
        <script is:inline>
        (function() {
            function initLazyImages() {
                document.querySelectorAll('img[loading="lazy"]').forEach(function(img) {
                    if (img.complete) {
                        img.classList.add('img-loaded');
                    } else {
                        img.addEventListener('load', function() {
                            img.classList.add('img-loaded');
                        });
                        img.addEventListener('error', function() {
                            img.classList.add('img-loaded');
                        });
                    }
                });
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initLazyImages);
            } else {
                initLazyImages();
            }
            document.addEventListener('astro:page-load', initLazyImages);
        })();
        </script>

        <!-- 滚动显现（reveal） -->
        <script is:inline>
        (function() {
            function initReveal() {
                var observer = new IntersectionObserver(function(entries) {
                    entries.forEach(function(entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('visible');
                            observer.unobserve(entry.target);
                        }
                    });
                }, {
                    rootMargin: '0px 0px -40px 0px',
                    threshold: 0
                });
                document.querySelectorAll('.reveal').forEach(function(el) {
                    observer.observe(el);
                });
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initReveal);
            } else {
                initReveal();
            }
            document.addEventListener('astro:page-load', initReveal);
        })();
        </script>
    </body>
</html>
