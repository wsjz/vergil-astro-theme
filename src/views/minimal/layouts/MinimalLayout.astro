---
import { ViewTransitions } from 'astro:transitions';
import { ChevronLeft } from '@lucide/astro';
import BaseHead, { type Props as HeadProps } from '../../../components/base/BaseHead.astro';
import ThemeToggle from '../../../components/ui/ThemeToggle.astro';

export type Props = HeadProps & {
    showBackLink?: string;
    backHref?: string;
    showBreadcrumb?: boolean;
};

const { showBackLink, backHref, showBreadcrumb = false, ...head } = Astro.props;
const isArticle = head.pageType === 'article';
---

<!doctype html>
<html lang="zh-CN" class="wrap-break-words antialiased">
    <head>
        <BaseHead {...head} />
        <script is:inline>
            (function() {
                try {
                    var scheme = localStorage.getItem('colorScheme') || 'C';
                    var isDark = localStorage.getItem('darkMode');
                    document.documentElement.setAttribute('data-theme', scheme);
                    if (isDark === 'true' || (isDark === null && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                        document.documentElement.classList.add('dark');
                    }
                } catch(e) {}
            })();
        </script>
        <ViewTransitions />
        <script>
            import '../../../scripts/theme-toggle.js';
        </script>
        <meta name="robots" content="noindex" />
    </head>
    <body class="bg-main text-main">
        {isArticle && (
            <div id="reading-progress" class="fixed top-0 left-0 h-[2px] bg-accent z-[9999] w-0 transition-none"></div>
        )}

        <main class="min-h-screen flex flex-col">
            <div class="flex-1 w-full max-w-3xl mx-auto px-6 pt-12 pb-20">
                <!-- 顶部栏：返回链接 + ThemeToggle -->
                <div class="flex items-center justify-between mb-6">
                    {showBackLink ? (
                        <a href={backHref} class="text-sm text-secondary hover:text-accent transition-colors inline-flex items-center gap-1">
                            <ChevronLeft class="w-3.5 h-3.5" /> {showBackLink}
                        </a>
                    ) : (
                        <div />
                    )}
                    <ThemeToggle />
                </div>

                <!-- 面包屑插槽 -->
                {showBreadcrumb && (
                    <div id="minimal-breadcrumb" class="mb-6">
                        <slot name="breadcrumb" />
                    </div>
                )}

                <slot />
            </div>
        </main>

        <button
            id="minimal-back-to-top"
            class="fixed right-4 xl:right-6 bottom-6 z-50 flex items-center justify-center w-10 h-10 bg-card/90 backdrop-blur-sm border border-light/60 rounded-full shadow-lg text-secondary hover:text-accent hover:border-accent/40 hover:shadow-xl hover:scale-110 transition-all duration-300 opacity-0 invisible translate-y-3"
            aria-label="回到顶部"
            title="回到顶部"
        >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
            </svg>
        </button>

        <div class="fixed bottom-6 left-0 right-0 flex justify-center z-50 pointer-events-none">
            <button
                id="minimal-back-btn"
                class="px-4 py-2 rounded-full bg-card/90 backdrop-blur-sm border border-light/60 shadow-lg text-sm text-secondary hover:text-accent hover:border-accent/40 hover:shadow-xl hover:scale-110 transition-all duration-300 cursor-pointer pointer-events-auto"
            >
                返回
            </button>
        </div>
        <script is:inline>
            (function(){
                document.addEventListener('click', function(e){
                    var btn = e.target.closest('#minimal-back-btn');
                    if(!btn) return;
                    if(history.length > 1){
                        history.back();
                    } else {
                        location.href = '/';
                    }
                });

                function initBackToTop() {
                    var btn = document.getElementById('minimal-back-to-top');
                    if (!btn || btn.__bttInit) return;
                    btn.__bttInit = true;

                    var ticking = false;
                    function update() {
                        if (window.scrollY > 400) {
                            btn.classList.remove('opacity-0', 'invisible', 'translate-y-3');
                            btn.classList.add('opacity-100', 'visible', 'translate-y-0');
                        } else {
                            btn.classList.add('opacity-0', 'invisible', 'translate-y-3');
                            btn.classList.remove('opacity-100', 'visible', 'translate-y-0');
                        }
                        ticking = false;
                    }
                    window.addEventListener('scroll', function() {
                        if (!ticking) {
                            requestAnimationFrame(update);
                            ticking = true;
                        }
                    }, { passive: true });
                    btn.addEventListener('click', function() {
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    });
                    update();
                }
                document.addEventListener('astro:page-load', initBackToTop);
                initBackToTop();
            })();
        </script>

        {isArticle && (
            <script is:inline>
                (function () {
                    function initProgress() {
                        var bar = document.getElementById('reading-progress');
                        if (!bar) return;
                        function update() {
                            var scrollTop = window.scrollY;
                            var docHeight = document.documentElement.scrollHeight - window.innerHeight;
                            var pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
                            bar.style.width = pct + '%';
                        }
                        window.removeEventListener('scroll', update);
                        window.addEventListener('scroll', update, { passive: true });
                        update();
                    }
                    document.addEventListener('astro:page-load', initProgress);
                    initProgress();
                })();
            </script>
        )}
    </body>
</html>
